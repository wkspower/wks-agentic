    b.update(budget or {})
    return (
        "# Root\n\n"
        "Parent: the person. Governed by [`principles.md`](principles.md).\n\n"
        "## The six declarations\n\n"
        "1. **Purpose** — Be the root of a fixture tree.\n"
        "2. **Interface** — Offers *build*, *verdict* and the queue.\n"
        "3. **Rules** — The principles; none added.\n"
        "4. **Budget** — The person's attention first, and every other "
        "kind `principles.md` lists. Values, given in round 1 of "
        "[`queue.md`](queue.md) (Q2 to Q8): %s\n" % budget_text(b, True) +
        "5. **Measure** — Items in the queue per correct result.\n"
        "6. **Judge** — The person.\n\n"
        "## The principles here\n\n" + table("At the root"))


def src_hash(src):
    """The judge's hash of a src directory, as the documents define it."""
    names = []
    for base, dirs, files in os.walk(src):
        dirs[:] = [d for d in dirs if d != "__pycache__"]
        for f in files:
            full = os.path.join(base, f)
            names.append((os.path.relpath(full, src).replace(os.sep, "/"),
                          full))
    h = hashlib.sha256()
    for rel, full in sorted(names):
        with open(full, "rb") as fh:
            h.update(rel.encode("utf-8") + b"\0" + fh.read() + b"\0")
    return h.hexdigest()


class Tree:
    """A fixture repository being written, commit by commit."""

    def __init__(self, path):
        self.path = path
        self.commits = 0
        os.makedirs(path)
        self.git("init", "-q")

    def git(self, *args):
        env = dict(os.environ)
        when = "2026-01-01T00:%02d:00+0000" % self.commits
        env.update(GIT_CONFIG_GLOBAL=os.devnull, GIT_CONFIG_SYSTEM=os.devnull,
                   GIT_CONFIG_NOSYSTEM="1", GIT_AUTHOR_DATE=when,
                   GIT_COMMITTER_DATE=when)
        cmd = ["git", "-C", self.path, "-c", "user.name=Fixture",
               "-c", "user.email=fixture@example.invalid",
               "-c", "commit.gpgsign=false", "-c", "core.hooksPath=/dev/null",
               "-c", "core.autocrlf=false", "-c", "core.fileMode=true"]
        subprocess.run(cmd + list(args), check=True, env=env,
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.PIPE, timeout=60)

    def commit(self, message):
        self.commits += 1
        self.git("add", "-A")
        self.git("commit", "-q", "-m", message)


def put(tree, rel, text, exe=False, append=False):
    path = os.path.join(tree, rel)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    data = text if isinstance(text, bytes) else text.encode("utf-8")
    with open(path, "ab" if append else "wb") as f:
        f.write(data)
    os.chmod(path, 0o755 if exe else 0o644)


def get(tree, rel):
    with open(os.path.join(tree, rel), "rb") as f:
        return f.read().decode("utf-8")


def put_measure(tree, unit):
    base = unit + "/measure/" if unit else "measure/"
    put(tree, base + "check", CHECK, exe=True)
    put(tree, base + "planted/bad/note", "a build without the file good\n")


def stand(tree, unit, minute):
    """Append the judge's line for the unit's present src; return its hash."""
    h = src_hash(os.path.join(tree, unit, "src"))
    put(tree, "judge/stands.tsv",
        "2026-01-01T00:%02dZ\t%s\tcandidate\t40\t%s\t40 41\n"
        % (minute, unit, h), append=True)
    return h


def put_unjudged_src(tree, unit):
    put(tree, unit + "/src/main.py", "print('%s')\n" % unit)
    put(tree, unit + "/record.md",
        "# Record\n\nThe first build stood with no judge.\n\n"
        "stood unjudged: %s\n" % src_hash(os.path.join(tree, unit, "src")))


def build_tree(path, variant=None):
    """Write the clean tree, or the one history variant named.

    Clean history, one commit per line:
      1 principles.md root.md queue.md        (touches only those)
      2 the root's build, verdict, measure, ledger, empty stands.tsv
      3 documents, build and verdict of the four units; decoys
      4 the four units' measures
      5 tool/src and its record (stood unjudged)
      6 shop/src, first build, let stand
      7 shop/src, second build, let stand     (shop: two lines, last counts)
      8 shop/cat/src, let stand               (last line of the file: cat's)
      9 root.md and queue.md together         (an answer written)
     10 one more planted build for cat, and the ledger rows
    """
    t = Tree(path)
    # 1
    put(path, "principles.md", "# Principles\n\nFixture text.\n")
    put(path, "root.md", root_doc())
    put(path, "queue.md", "# Queue of the root\n\n### Q1 | decision\nAsked.\n")
    if variant == "answer-in-first-commit":
        put(path, "build", SCRIPT, exe=True)
    t.commit("the two documents and the queue")
    # 2
    put(path, "build", SCRIPT, exe=True)
    put(path, "verdict", SCRIPT, exe=True)
    put_measure(path, "")
    put(path, "ledger.tsv", "# time\tunit\truns\tnote\n")
    put(path, "judge/stands.tsv", "")
    t.commit("root interface and measure")
    # 3
    for unit in BUDGETS:
        put(path, unit + "/unit.md", unit_doc(unit))
        put(path, unit + "/build", SCRIPT, exe=True)
        put(path, unit + "/verdict", SCRIPT, exe=True)
    put(path, "shop/audit/cat/unit.md", DECOY)
    put(path, ".cache/unit.md", DECOY)
    if variant == "before-src-first":
        put(path, "shop/cat/src/main.py", "print('cat')\n")
    t.commit("unit documents")
    # 4
    late_measure = {"before-same-commit": "tool",
                    "before-measure-uncommitted": "tool",
                    "before-neither-committed": DOG}.get(variant)
    for unit in BUDGETS:
        if unit != late_measure:
            put_measure(path, unit)
    if late_measure != "tool":
        put(path, "tool/measure/planted/bad/unit.md", DECOY)
    t.commit("measures")
    # 5
    put_unjudged_src(path, "tool")
    if variant == "before-same-commit":
        put_measure(path, "tool")
    t.commit("tool: first build, stood unjudged")
    # 6
    put(path, "shop/src/shop.py", "print('shop, first build')\n")
    stand(path, "shop", 6)
    t.commit("shop: first build stands")
    # 7
    put(path, "shop/src/shop.py", "print('shop, second build')\n")
    stand(path, "shop", 7)
    t.commit("shop: second build stands")
    # 8
    put(path, "shop/cat/src/main.py", "print('cat')\n")
    put(path, "shop/cat/src/lib/util.py", "NAME = 'cat'\n")
    put(path, "shop/cat/src/lib/unit.md", DECOY)
    stand(path, "shop/cat", 8)
    t.commit("cat: build stands")
    # 9
    put(path, "root.md", "\nAnswer to Q1: ok.\n", append=True)
    put(path, "queue.md", "Answered.\n", append=True)
    t.commit("answer to Q1, word for word")
    if variant == "answer-root-with-unit-doc":
        put(path, "root.md", "\nAnswer to Q2: ok.\n", append=True)
        put(path, "shop/unit.md", "\n", append=True)
        t.commit("answer to Q2 and a tidy-up")
    if variant == "answer-principles-with-ledger":
        put(path, "principles.md", "\nOne more line.\n", append=True)
        put(path, "ledger.tsv", "# checked\n", append=True)
        t.commit("principles reworded")
    # 10
    put(path, "shop/cat/measure/planted/worse/note", "also lacks good\n")
    put(path, "ledger.tsv", LEDGER)
    t.commit("cat: one more planted build; ledger")
    # left uncommitted in the working tree
    put(path, "shop/cat/src/__pycache__/main.cpython-311.pyc", b"\0cache")
    put(path, "shop/cat/src/lib/__pycache__/util.cpython-311.pyc", b"\0c")
    if variant == "before-measure-uncommitted":
        put_measure(path, "tool")
    if variant == "before-neither-committed":
        put_measure(path, DOG)
    if variant in ("before-neither-committed", "clean-src-uncommitted"):
        put_unjudged_src(path, DOG)


# ------------------------------------------- changes to a copy of the clean

def rewrite(rel, old, new):
    def change(tree):
        text = get(tree, rel)
        if old not in text:
            raise RuntimeError("fixture: %r not in %s" % (old, rel))
        put(tree, rel, text.replace(old, new, 1))
    return change


def drop_line(rel, prefix):
    """Remove the one line of the document that starts with prefix."""
    def change(tree):
        lines = get(tree, rel).splitlines(True)
        kept = [l for l in lines if not l.startswith(prefix)]
        if len(kept) != len(lines) - 1:
            raise RuntimeError("fixture: no single line %r" % prefix)
        put(tree, rel, "".join(kept))
    return change


def swap_lines(rel, first, second):
    def change(tree):
        lines = get(tree, rel).splitlines(True)
        i = [n for n, l in enumerate(lines) if l.startswith(first)][0]
        j = [n for n, l in enumerate(lines) if l.startswith(second)][0]
        lines[i], lines[j] = lines[j], lines[i]
        put(tree, rel, "".join(lines))
    return change


def budget(unit, **values):
    """Rewrite the unit's document with these budget values (None: left out)."""
    def change(tree):
        if unit == "root":
            put(tree, "root.md", root_doc(values))
        else:
            put(tree, unit + "/unit.md", unit_doc(unit, values))
    return change


def grow(unit, rel, total):
    """Append to <unit>/<rel> until unit.md + record.md is `total` bytes."""
    def change(tree):
        size = 0
        for name in ("unit.md", "record.md"):
            p = os.path.join(tree, unit, name)
            size += os.path.getsize(p) if os.path.exists(p) else 0
        need = total - size
        if need < 1:
            raise RuntimeError("fixture: already %d bytes" % size)
        put(tree, unit + "/" + rel, "x" * (need - 1) + "\n", append=True)
    return change


def write(rel, text, exe=False):
    return lambda tree: put(tree, rel, text, exe=exe)


def append(rel, text):
    return lambda tree: put(tree, rel, text, append=True)


def remove(rel):
    def change(tree):
        p = os.path.join(tree, rel)
        shutil.rmtree(p) if os.path.isdir(p) else os.remove(p)
    return change


def empty_dir(rel):
    def change(tree):
        shutil.rmtree(os.path.join(tree, rel))
        os.mkdir(os.path.join(tree, rel))
    return change


def not_executable(rel):
    return lambda tree: os.chmod(os.path.join(tree, rel), 0o644)


def rename(old, new):
    return lambda tree: os.rename(os.path.join(tree, old),
                                  os.path.join(tree, new))


def stale_stand(tree):
    """shop: one more line, for the build that stood before the present one."""
    lines = get(tree, "judge/stands.tsv").splitlines(True)
    first = [l for l in lines if l.split("\t")[1] == "shop"][0]
    put(tree, "judge/stands.tsv", first, append=True)


def stand_under_other_name(tree):
    """shop: the line holding its present hash now names the unit shop/cat."""
    lines = get(tree, "judge/stands.tsv").splitlines(True)
    n = [i for i, l in enumerate(lines) if l.split("\t")[1] == "shop"][-1]
    f = lines[n].split("\t")
    f[1] = "shop/cat"
    lines[n] = "\t".join(f)             # cat's own line is still its last
    put(tree, "judge/stands.tsv", "".join(lines))


def unjudged_hash_of_another_build(tree):
    h = hashlib.sha256(b"another build").hexdigest()
    lines = get(tree, "tool/record.md").splitlines(True)
    lines = ["stood unjudged: %s\n" % h if l.startswith("stood unjudged:")
             else l for l in lines]
    put(tree, "tool/record.md", "".join(lines))


def row(unit, runs):
    return append("ledger.tsv", "2026-01-02T00:00Z\t%s\t%d\tmore\n"
                  % (unit, runs))


