# ------------------------------------------------------------------ running

def snapshot(tree):
    """Every path of the working tree outside .git, with mode and content."""
    seen = {}
    for base, dirs, files in os.walk(tree):
        if base == tree and ".git" in dirs:
            dirs.remove(".git")
        for name in dirs + files:
            full = os.path.join(base, name)
            data = b""
            if os.path.isfile(full):
                with open(full, "rb") as f:
                    data = f.read()
            seen[os.path.relpath(full, tree)] = (os.stat(full).st_mode, data)
    return seen


def run_enforce(build, tree, elsewhere):
    """Return (exit code, stdout lines), or (None, reason)."""
    env = dict(os.environ)
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    try:
        r = subprocess.run([os.path.join(build, "enforce"), tree],
                           cwd=elsewhere, env=env, stdin=subprocess.DEVNULL,
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           timeout=RUN_TIMEOUT)
    except subprocess.TimeoutExpired:
        return None, HUNG
    except OSError as e:
        return None, "enforce could not be run: %s" % e
    return r.returncode, r.stdout.decode("utf-8", "replace").splitlines()


def judge_case(rule, code, lines):
    """None when the case passes, else why it fails."""
    if code is None:
        return lines
    if rule is None:
        if code != 0:
            return "clean tree: exit %s, wanted 0; said %r" % (code, lines[:3])
        return None
    if code != 1:
        return "exit %s, wanted 1" % code
    if not any(l.startswith(rule + " ") for l in lines):
        return "no stdout line starts with %r; said %r" % (rule + " ",
                                                           lines[:3])
    return None


def build_bytes(build):
    total = 0
    for base, dirs, files in os.walk(build):
        for name in files:
            total += os.path.getsize(os.path.join(base, name))
    return total


def main():
    if len(sys.argv) != 2:
        sys.stderr.write("usage: check <build-dir>\n")
        return 2
    build = os.path.abspath(sys.argv[1])
    if not os.path.isfile(os.path.join(build, "enforce")):
        sys.stderr.write("FAIL build: no file `enforce` in %s\n" % build)
        return 1
    failed = []
    work = tempfile.mkdtemp(prefix="enforcer-measure-")
    try:
        elsewhere = os.path.join(work, "elsewhere")   # cwd: not the tree
        os.mkdir(elsewhere)
        try:
            clean = os.path.join(work, "clean")
            build_tree(clean)
            variants = {}
            for v in HISTORY_VARIANTS:
                variants[v] = os.path.join(work, "history-" + v)
                build_tree(variants[v], v)
        except Exception as e:           # a defect of this check, not a fail
            sys.stderr.write("check: cannot make fixtures: %r\n" % (e,))
            return 2
        for n, (name, rule, how) in enumerate(CASES):
            if isinstance(how, str):
                tree = variants[how]
            else:
                tree = os.path.join(work, "case-%02d" % n)
                shutil.copytree(clean, tree, symlinks=True)
                if how is not None:
                    how(tree)
            before = snapshot(tree) if name == "clean" else None
            code, lines = run_enforce(build, tree, elsewhere)
            why = judge_case(rule, code, lines)
            if why:
                failed.append((name, why))
            if why == HUNG:
                break
            if before is not None and snapshot(tree) != before:
                # unit document, principle 1: "writes nothing in it"
                failed.append(("writes-nothing-in-the-tree",
                               "the tree's files changed during the run"))
    finally:
        shutil.rmtree(work, ignore_errors=True)
    total = len(CASES) + 1
    if failed:
        for name, why in failed:
            sys.stderr.write("FAIL %s: %s\n" % (name, why))
        sys.stderr.write("%d of %d cases failed\n" % (len(failed), total))
        return 1
    print("%d cases passed" % total)
    print(build_bytes(build))
    return 0


if __name__ == "__main__":
    sys.exit(main())
