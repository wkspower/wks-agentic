def budget_text(b, root=False):
    """The budget line's values; a kind set to None is left out."""
    if root:
        forms = [("cost", "cost %s agent runs"), ("time", "time %s h"),
                 ("context", "context %s KB per unit"),
                 ("attempts", "attempts %s per change"),
                 ("alternatives", "alternatives %s per change"),
                 ("attention", "attention %s items per correct result "
                               "after round 1"),
                 ("cap", "cap on effects without undo %s")]
    else:
        forms = [("cost", "cost %s runs"), ("time", "time %s h"),
                 ("context", "context %s KB"), ("attempts", "attempts %s"),
                 ("alternatives", "alternatives %s"),
                 ("attention", "attention %s"), ("cap", "no-undo cap %s")]
    return "; ".join(f % b[k] for k, f in forms if b.get(k) is not None) + "."


def table(where):
    rows = ["| Principle | %s |" % where, "|---|---|"]
    rows += ["%s | How it appears in this fixture. |" % r for r in ROWS]
    return "\n".join(rows) + "\n"


def unit_doc(unit, budget=None):
    b = dict(BUDGETS[unit])
    b.update(budget or {})
    up = "../" * (unit.count("/") + 1)
    name = unit.split("/")[-1]
    return (
        "# %s\n\n" % name.capitalize() +
        "Parent: [`%s`](%s). Governed by [`principles.md`](%sprinciples.md)."
        "\n\n" % (PARENT[unit], up, up) +
        "## The six declarations\n\n"
        "1. **Purpose** — Be the fixture unit `%s`.\n" % unit +
        "2. **Interface** — Offers *build* and *verdict*.\n"
        "3. **Rules** — Those of its parent, none added.\n"
        "4. **Budget** — %s\n" % budget_text(b) +
        "5. **Measure** — `measure/check <build-dir>`; number: 1.\n"
        "6. **Judge** — The judge.\n\n"
        "## The principles here\n\n" + table("Here"))


def root_doc(budget=None):
