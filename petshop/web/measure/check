MODULES = ("catalog.py", "stock.py", "customers.py", "sales.py")
NAV = ("/", "/catalog", "/customers", "/sell", "/sales")
ENV = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
# Texts that must never appear raw in a page: they come from names and ids in the state.
RAW = ("<script>alert(1)</script>", "<b>bold</b>", "<img src=x", '<i>&"q\'', "<u>kept</u>")

CASES = []   # every case name, in the order run
FAILS = []   # (name, reason)


class case:
    """`with case("what the document claims"):` a failed assertion inside fails the case."""

    def __init__(self, name):
        self.name = name

    def __enter__(self):
        CASES.append(self.name)

    def __exit__(self, kind, value, trace):
        if kind is None:
            return True
        if not issubclass(kind, Exception):
            return False
        reason = str(value) if kind is AssertionError else "%s: %s" % (kind.__name__, value)
        FAILS.append((self.name, " ".join(reason.split())[:300]))
        return True


def expect(condition, reason="expectation not met"):
    if not condition:
        raise AssertionError(reason)


def same(got, want, what):
    if got != want:
        raise AssertionError("%s: got %r, want %r" % (what, got, want))


# ---- a small HTML tree ---------------------------------------------------------------------

VOID = {"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "source",
        "track", "wbr"}
CELLS = {"tr", "td", "th"}
CLOSES = {"tr": CELLS, "td": {"td", "th"}, "th": {"td", "th"}, "option": {"option"},
          "optgroup": {"option", "optgroup"}, "li": {"li"}, "p": {"p"}, "dt": {"dt", "dd"},
          "dd": {"dt", "dd"}, "tbody": CELLS | {"thead", "tbody", "tfoot"},
          "tfoot": CELLS | {"thead", "tbody", "tfoot"}}
INLINE = {"a", "abbr", "b", "bdi", "code", "em", "i", "kbd", "mark", "s", "small", "span",
          "strong", "sub", "sup", "u", "var"}
BLOCKS = {"div", "table", "form", "section", "ul", "ol", "dl", "h1", "h2", "h3", "h4", "nav",
          "main", "header", "footer", "article", "aside", "fieldset", "details", "pre", "hr"}


class Node:
    def __init__(self, tag, attrs, parent):
        self.tag, self.attrs, self.parent, self.children = tag, attrs, parent, []

    def walk(self):
        for child in self.children:
            if isinstance(child, Node):
                yield child
                yield from child.walk()

    def all(self, *tags, **attrs):
        """Descendants with one of the tags and all the attributes (class_ = a class token)."""
        found = []
        for node in self.walk():
            if tags and node.tag not in tags:
                continue
            if all((value in node.attrs.get("class", "").split()) if key == "class_"
                   else node.attrs.get(key.replace("_", "-")) == value
                   for key, value in attrs.items()):
                found.append(node)
        return found

    def raw_text(self):
        parts = []
        for child in self.children:
            if isinstance(child, str):
                parts.append(child)
            elif child.tag in INLINE:
                parts.append(child.raw_text())
            elif child.tag not in ("script", "style", "template"):
                parts.append(" " + child.raw_text() + " ")   # cells and blocks are apart
        return "".join(parts)

    def text(self):
        return " ".join(self.raw_text().split())

    def inside(self, tag):
        node = self.parent
        while node is not None and node.tag != tag:
            node = node.parent
        return node


class Tree(HTMLParser):
    def __init__(self, text):
        super().__init__(convert_charrefs=True)
        self.root = Node("#root", {}, None)
        self.stack = [self.root]
        self.feed(text)
        self.close()

    def handle_starttag(self, tag, attrs):
        closes = CLOSES.get(tag, set())
        while len(self.stack) > 1 and (self.stack[-1].tag in closes or (
                self.stack[-1].tag == "p" and tag in BLOCKS)):
            self.stack.pop()
        values = {}
        for key, value in attrs:
            values.setdefault(key, "" if value is None else value)
        node = Node(tag, values, self.stack[-1])
        self.stack[-1].children.append(node)
        if tag not in VOID:
            self.stack.append(node)

    def handle_startendtag(self, tag, attrs):
        self.handle_starttag(tag, attrs)
        if tag not in VOID:
            self.stack.pop()

    def handle_endtag(self, tag):
        if any(node.tag == tag for node in self.stack[1:]):
            while self.stack.pop().tag != tag:
                pass

    def handle_data(self, data):
        self.stack[-1].children.append(data)


def norm(text):
    return " ".join(text.split())


def money(cents):
    return "%s.%02d" % (format(cents // 100, ","), cents % 100)


def numbers(node):
    """The numbers written in an element, e.g. ['1,234,567.89']."""
    return re.findall(r"\d[\d,]*(?:\.\d+)?", node.text())


def by_id(doc, name, tag=None):
    found = [node for node in doc.walk() if node.attrs.get("id") == name]
    expect(len(found) == 1, "want exactly one element id=%r, found %d" % (name, len(found)))
    if tag:
        same(found[0].tag, tag, "tag of #%s" % name)
    return found[0]


def rows(table):
    return [row for row in table.all("tr") if "data-id" in row.attrs]


def row_ids(table):
    return [row.attrs["data-id"] for row in rows(table)]


def cell(row, name):
    found = row.all("td", "th", class_=name)
    expect(found, "row %r has no cell of class %r" % (row.attrs.get("data-id"), name))
    return found[0]


def forms(doc, action):
    return doc.all("form", action=action)


def controls(form, name):
    return [node for node in form.all("input", "select", "textarea")
            if node.attrs.get("name") == name]


def holds(form, name, value):
    """Does the form's field `name` hold `value` (as a browser would show it)?"""
    for node in controls(form, name):
        if node.tag == "select":
            options = node.all("option")
            chosen = [o for o in options if "selected" in o.attrs] or options[:1]
            if chosen and chosen[-1].attrs.get("value", chosen[-1].text()) == value:
                return True
        elif node.tag == "textarea":
            if node.raw_text().strip("\n") == value:
                return True
        elif node.attrs.get("value", "") == value:
            return True
    return False


# ---- the program under test ----------------------------------------------------------------

class Response:
    def __init__(self, status, headers, body):
        self.status, self.headers, self.body = status, headers, body
        charset = re.search(r"charset=([\w-]+)", headers.get("content-type", ""), re.I)
        try:
            self.text = body.decode(charset.group(1) if charset else "utf-8", "replace")
        except LookupError:
            self.text = body.decode("utf-8", "replace")
        self._doc = None

    @property
    def doc(self):
        if self._doc is None:
            self._doc = Tree(self.text).root
        return self._doc


class Server:
    """One running `python3 web.py --state FILE [--port N]`, always killed at the end."""
    running = []
    patience = 15   # seconds to wait for the ready line; short once a start has failed

    def __init__(self, build, state, port=0):
        self.state, self.line, self.port = state, None, None
        command = [sys.executable, os.path.join(build, "web.py"), "--state", state]
        if port is not None:
            command += ["--port", str(port)]
        self.proc = subprocess.Popen(command, cwd=build, env=ENV, stdin=subprocess.DEVNULL,
                                     stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        Server.running.append(self)
        ready = threading.Event()

        def read():
            for raw in self.proc.stdout:
                if self.line is None:
                    self.line = raw.decode("utf-8", "replace").rstrip("\r\n")
                    ready.set()
            ready.set()
        threading.Thread(target=read, daemon=True).start()
        ready.wait(Server.patience)
        found = re.fullmatch(r"http://127\.0\.0\.1:(\d+)/", self.line or "")
        if found:
            self.port = int(found.group(1))
        else:
            Server.patience = 3

    def started(self):
        expect(self.port, "no ready line http://127.0.0.1:PORT/ on stdout within 15 s "
               "(first line: %r)" % (self.line,))

    def request(self, method, path, fields=None, cookie=None):
        self.started()
        connection = http.client.HTTPConnection("127.0.0.1", self.port, timeout=15)
        try:
            headers, body = {}, None
            if fields is not None:
                body = urlencode(fields).encode("ascii")
                headers["Content-Type"] = "application/x-www-form-urlencoded"
            elif method in ("POST", "PUT"):
                body = b""
                headers["Content-Type"] = "application/x-www-form-urlencoded"
            if cookie:
                headers["Cookie"] = cookie
            connection.request(method, path, body=body, headers=headers)
            answer = connection.getresponse()
            return Response(answer.status, {k.lower(): v for k, v in answer.getheaders()},
                            answer.read())
        except socket.timeout:
            self.kill()   # a program that hangs is ended: every later request fails at once
            raise AssertionError("no answer to %s %s within 15 s" % (method, path)) from None
        finally:
            connection.close()

    def get(self, path):
        return self.request("GET", path)

    def post(self, path, fields):
        return self.request("POST", path, fields)

    def alive(self):
        return self.proc.poll() is None

    def kill(self):
        if self.proc.poll() is None:
            self.proc.kill()
        try:
            self.proc.wait(5)
        except Exception:
            pass

    @classmethod
    def kill_all(cls):
        for server in cls.running:
            server.kill()


def snapshot(path):
    """What a state file is right now: None when missing, else its bytes."""
    try:
        with open(path, "rb") as handle:
            return handle.read()
    except FileNotFoundError:
        return None


