    const shown = (await page.locator('#items tr[data-id="flow1"] .on-hand').first().innerText()).trim();
    if (!/(^|\D)5(\D|$)/.test(shown)) return 'on hand shows ' + shown;
  });
  await step(pre + 'register a customer by the form /customers/register', async () => {
    await page.goto(base + '/customers');
    const form = await formFor(page, '/customers/register');
    await form.locator('[name="name"]').fill('Flow Customer');
    await submit(page, form);
    if (pathOf(page) !== '/customers') return 'ended on ' + page.url();
    if (await statusCount(page) !== 1) return 'no single role=status';
    if (await page.locator('#customers tr[data-id="C1"]').count() !== 1) return 'no row for the customer';
  });
  await step(pre + 'make a sale by the form /sell and see the receipt', async () => {
    await page.goto(base + '/sell');
    const form = await formFor(page, '/sell');
    await form.locator('select[name="customer"]').selectOption('C1');
    await form.locator('input[name="qty-flow1"]').fill('2');
    await submit(page, form);
    if (pathOf(page) !== '/sales/S1') return 'ended on ' + page.url();
    if (await statusCount(page) !== 1) return 'no single role=status';
    if (!(await page.locator('#total').innerText()).includes('25.00')) return 'total is not 25.00';
    if ((await page.locator('#customer').innerText()).trim() !== 'Flow Customer') return 'customer not shown';
    if (await page.locator('#lines tr[data-id="flow1"]').count() !== 1) return 'no line for the item';
  });
  await context.close();
}

async function keyboardFlow(browser, base) {
  const context = await browser.newContext({ viewport: { width: 1280, height: 900 } });
  const page = await context.newPage();
  page.setDefaultTimeout(6000);
  const tabTo = async (what, test) => {
    for (let k = 0; k < 80; k++) {
      await page.keyboard.press('Tab');
      if (await page.evaluate(test)) return;
    }
    throw new Error('Tab never reaches ' + what);
  };
  await step('Everything can be operated with the keyboard alone: a sale made with Tab, typing and Enter', async () => {
    await page.goto(base + '/sell');
    await tabTo('the select customer', () => { const e = document.activeElement; return e && e.tagName === 'SELECT' && e.name === 'customer'; });
    for (let k = 0; k < 3 && await page.evaluate(() => document.activeElement.value) !== 'C1'; k++) await page.keyboard.press('ArrowDown');
    await tabTo('the input qty-flow1', () => { const e = document.activeElement; return e && e.name === 'qty-flow1'; });
    await page.keyboard.type('1');
    let moved = page.waitForNavigation({ waitUntil: 'load', timeout: 2500 }).then(() => true, () => false);
    await page.keyboard.press('Enter');
    if (!(await moved)) {
      await tabTo('a submit button of the form', () => { const e = document.activeElement; return e && e.form && e.form.getAttribute('action') === '/sell' && (e.tagName === 'BUTTON' || ['submit', 'button', 'image'].includes(e.type)); });
      moved = page.waitForNavigation({ waitUntil: 'load', timeout: 4000 }).then(() => true, () => false);
      await page.keyboard.press('Enter');
      if (!(await moved)) return 'the form /sell cannot be submitted from the keyboard';
    }
    if (pathOf(page) !== '/sales/S2') return 'ended on ' + page.url();
    if (!(await page.locator('#total').innerText()).includes('12.50')) return 'total is not 12.50';
  });
  await context.close();
}

// a program that stops answering must not hold the measure: say what is known and leave
setTimeout(() => {
  rec('Browser layer: every page and flow ends within 100 s', false, 'the browser run was still going after 100 s');
  console.log(JSON.stringify({ results, graded }));
  process.exit(0);
}, 100000);

(async () => {
  let browser;
  try { browser = await chromium.launch(); }
  catch (e) { console.log(JSON.stringify({ fatal: 'Chromium cannot be started: ' + e.message.split('\n')[0] })); return; }
  try {
    const jobs = [];
    for (const width of cfg.widths) for (const path of cfg.paths) jobs.push(checkPage(browser, cfg.shop, path, width));
