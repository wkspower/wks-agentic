def modules(build, script, path, ops=None):
    done = subprocess.run([sys.executable, "-c", script, path], cwd=build, env=ENV,
                          input=json.dumps(ops), capture_output=True, text=True, timeout=30)
    expect(done.returncode == 0, "modules failed on the state file: " + done.stderr[-300:])
    return done.stdout


def make_state(build, path, ops):
    modules(build, MAKE, path, ops)


def dump(build, path):
    """What the shop's modules read in a state file."""
    return json.loads(modules(build, DUMP, path))


# ---- what every page must be ---------------------------------------------------------------

def nav_of(doc):
    for nav in doc.all("nav"):
        hrefs = [a.attrs.get("href") for a in nav.all("a")]
        if all(href in hrefs for href in NAV):
            return nav
    raise AssertionError("no <nav> linking to /, /catalog, /customers, /sell and /sales")


def no_raw(page):
    for marker in RAW:
        expect(marker not in page.text, "text from the state is not HTML-escaped: %r" % marker)


def nothing_fetched_elsewhere(page):
    for node in page.doc.walk():
        for key in ("src", "srcset", "poster", "data") + (("href",) if node.tag == "link" else ()):
            value = node.attrs.get(key, "").strip()
            expect(not re.match(r"(?i)([a-z][a-z0-9+.-]*:)?//", value) or re.match(
                r"(?i)https?://127\.0\.0\.1(:\d+)?(/|$)", value),
                "<%s %s=%r> is fetched from another server" % (node.tag, key, value))
        if node.tag == "style":
            css = "".join(c for c in node.children if isinstance(c, str))
            other = re.search(r"(?i)(url\(\s*['\"]?|@import\s+['\"])\s*(https?:)?//[^)'\"]*", css)
            expect(not other, "the style sheet fetches from another server: %r"
                   % (other.group(0) if other else ""))


def page_basics(page, section):
    """The sentences of "Every page" that hold for any page of the six."""
    doc = page.doc
    expect(page.text.lstrip("﻿ \r\n\t").lower().startswith("<!doctype html"),
           "not an HTML5 document: it does not begin with <!doctype html>")
    html_ = doc.all("html")
    expect(len(html_) == 1 and html_[0].attrs.get("lang", "").strip(), "<html> has no lang")
    titles = doc.all("title")
    expect(len(titles) == 1, "want exactly one <title>")
    expect(re.fullmatch(r"\S.* · Pet shop", titles[0].text()),
           "title %r is not of the form 'PAGE · Pet shop'" % titles[0].text())
    same(len(doc.all("h1")), 1, "number of <h1>")
    expect(doc.all("main"), "no <main>")
    links = nav_of(doc).all("a")
    if section:
        expect(any(a.attrs.get("href") == section and a.attrs.get("aria-current") == "page"
                   for a in links), 'the nav link to %s lacks aria-current="page"' % section)
        for a in links:
            expect(a.attrs.get("href") == section or "aria-current" not in a.attrs,
                   "the nav link to %s carries aria-current on the page of section %s"
                   % (a.attrs.get("href"), section))
    no_raw(page)
    nothing_fetched_elsewhere(page)


def section_of(path):
    return "/sales" if path.startswith("/sales/") else path.split("?")[0]


def fetch(server, path, status=200):
    page = server.get(path)
    same(page.status, status, "status of GET %s" % path)
    page_basics(page, section_of(path))
    return page


def one(doc, role):
    found = [node for node in doc.walk() if node.attrs.get("role") == role]
    same(len(found), 1, 'number of elements role="%s"' % role)
    expect(found[0].text(), 'the element role="%s" says nothing' % role)


PAGE_MARK = {"/catalog": lambda doc: by_id(doc, "items", "table"),
             "/customers": lambda doc: by_id(doc, "customers", "table"),
             "/sell": lambda doc: expect(len(forms(doc, "/sell")) == 1, "no form /sell")}
FORM_PAGE = {"/catalog/add": "/catalog", "/catalog/price": "/catalog",
             "/stock/receive": "/catalog", "/stock/remove": "/catalog",
             "/customers/register": "/customers", "/sell": "/sell"}


def refused(server, action, fields, keep=None):
    """POST that must be refused: 400, the form's page, one alert, values kept, file as it was.

    `keep`: the fields that must still hold the submitted value (default: all of them)."""
    before = snapshot(server.state)
    page = server.post(action, fields)
    same(page.status, 400, "status of refused POST %s %r" % (action, fields))
    home = FORM_PAGE[action]
    page_basics(page, home)
    PAGE_MARK[home](page.doc)
    one(page.doc, "alert")
    names = list(fields) if keep is None else keep
    if names:
        expect(any(all(holds(form, name, fields[name]) for name in names)
                   for form in forms(page.doc, action)),
               "after refused POST %s the form does not still hold %r"
               % (action, {name: fields[name] for name in names}))
    expect(snapshot(server.state) == before,
           "the state file changed on refused POST %s %r" % (action, fields))


def done(server, action, fields, where=None):
    """POST that must succeed: 303 back to the form's page, which then shows one status."""
    answer = server.post(action, fields)
    same(answer.status, 303, "status of POST %s %r" % (action, fields))
    location = answer.headers.get("location")
    expect(location, "303 without Location")
    target = urlsplit(urljoin("http://127.0.0.1:%d%s" % (server.port, action), location))
    same(target.netloc, "127.0.0.1:%d" % server.port, "host of Location")
    if where is None:
        same(target.path, FORM_PAGE[action], "page of Location after POST %s" % action)
    else:
        expect(re.fullmatch(where, target.path), "Location %r after POST %s" % (location, action))
    cookie = "; ".join(v.split(";")[0] for k, v in answer.headers.items() if k == "set-cookie")
    path = target.path + ("?" + target.query if target.query else "")
    page = server.request("GET", path, cookie=cookie or None)
    same(page.status, 200, "status of the page shown after POST %s" % action)
    page_basics(page, section_of(target.path))
    one(page.doc, "status")
    return target.path, page


def verify_pages(server, shop, label):
    """The six pages show exactly what the shop's modules read in the state file (`shop`)."""
    items, people, sold = shop["items"], shop["customers"], shop["sales"]
    names = {person["id"]: person["name"] for person in people}
    item_names = {item["id"]: item["name"] for item in items}

    with case("GET / : count-items, count-customers, count-sales, takings (money) [%s]" % label):
        doc = fetch(server, "/").doc
        same(numbers(by_id(doc, "count-items")), [str(len(items))], "count-items")
        same(numbers(by_id(doc, "count-customers")), [str(len(people))], "count-customers")
        same(numbers(by_id(doc, "count-sales")), [str(len(sold))], "count-sales")
        same(numbers(by_id(doc, "takings")), [money(shop["takings"])], "takings")

    with case("GET / : table out-of-stock, one row per item with none on hand, id order [%s]"
              % label):
        doc = fetch(server, "/").doc
        same(row_ids(by_id(doc, "out-of-stock", "table")),
             [item["id"] for item in items if item["on_hand"] == 0], "rows of out-of-stock")

    with case("GET /catalog : table items, rows in id order, cells name kind price on-hand [%s]"
              % label):
        doc = fetch(server, "/catalog").doc
        table = by_id(doc, "items", "table")
        same(row_ids(table), [item["id"] for item in items], "rows of items")
        for row, item in zip(rows(table), items):
            same(cell(row, "name").text(), norm(item["name"]), "name of %s" % item["id"])
            expect(item["kind"] in cell(row, "kind").text().lower(), "kind of %s" % item["id"])
            same(numbers(cell(row, "price")), [money(item["price_cents"])],
                 "price of %s" % item["id"])
            same(numbers(cell(row, "on-hand")), [str(item["on_hand"])],
                 "on-hand of %s" % item["id"])

    with case("GET /customers : table customers, rows in order of registration, cell name [%s]"
              % label):
        doc = fetch(server, "/customers").doc
        table = by_id(doc, "customers", "table")
        same(row_ids(table), [person["id"] for person in people], "rows of customers")
        for row, person in zip(rows(table), people):
            same(cell(row, "name").text(), norm(person["name"]), "name of %s" % person["id"])

    with case("GET /sell : select customer has the customer ids as option values [%s]" % label):
        doc = fetch(server, "/sell").doc
        same(len(forms(doc, "/sell")), 1, "number of forms action=/sell")
        form = forms(doc, "/sell")[0]
        same(form.attrs.get("method", "").lower(), "post", "method of the form /sell")
        selects = [node for node in form.all("select") if node.attrs.get("name") == "customer"]
        same(len(selects), 1, "number of selects named customer")
        values = [o.attrs.get("value", "") for o in selects[0].all("option")]
        same(sorted(v for v in values if v), sorted(names), "option values")

    with case("GET /sell : a number input qty-ITEM_ID per item in id order, shown with name, "
              "price and quantity on hand [%s]" % label):
        form = forms(fetch(server, "/sell").doc, "/sell")[0]
        inputs = [node for node in form.all("input")
                  if node.attrs.get("name", "").startswith("qty-")]
        same([node.attrs["name"] for node in inputs], ["qty-" + item["id"] for item in items],
             "names of the quantity inputs")
        for node in inputs:
            same(node.attrs.get("type", "").lower(), "number", "type of %s" % node.attrs["name"])
        shown, tokens = form.text(), numbers(form)
        for item in items:
            expect(norm(item["name"]) in shown, "name of %s not shown" % item["id"])
            expect(money(item["price_cents"]) in tokens, "price of %s not shown" % item["id"])
            expect(str(item["on_hand"]) in tokens, "on hand of %s not shown" % item["id"])

    with case("GET /sales : table sales, newest first, cells customer (name) and total, each "
              "row links to the sale; takings [%s]" % label):
        doc = fetch(server, "/sales").doc
        table = by_id(doc, "sales", "table")
        newest = list(reversed(sold))
        same(row_ids(table), [sale["id"] for sale in newest], "rows of sales")
        for row, sale in zip(rows(table), newest):
            same(cell(row, "customer").text(), norm(names[sale["customer_id"]]),
                 "customer of %s" % sale["id"])
            same(numbers(cell(row, "total")), [money(sale["total_cents"])],
                 "total of %s" % sale["id"])
            expect(any(a.attrs.get("href") == "/sales/" + sale["id"] for a in row.all("a")),
                   "row %s has no link to /sales/%s" % (sale["id"], sale["id"]))
        same(numbers(by_id(doc, "takings")), [money(shop["takings"])], "takings")

    with case("GET /sales/SALE_ID : sale-id, customer (name), total, table lines with cells "
              "name quantity unit-price line-total [%s]" % label):
        for sale in sold[:3] + sold[-2:]:
            doc = fetch(server, "/sales/" + sale["id"]).doc
            expect(sale["id"] in by_id(doc, "sale-id").text().split(), "sale-id")
            same(by_id(doc, "customer").text(), norm(names[sale["customer_id"]]), "customer")
            same(numbers(by_id(doc, "total")), [money(sale["total_cents"])], "total")
            table = by_id(doc, "lines", "table")
            same(row_ids(table), [line["item_id"] for line in sale["lines"]], "rows of lines")
            for row, line in zip(rows(table), sale["lines"]):
                same(cell(row, "name").text(), norm(item_names[line["item_id"]]), "line name")
