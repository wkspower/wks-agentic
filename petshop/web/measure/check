def browser_layer(build, work):
    """Returns the graded defects (a list), or None when the layer could not run."""
    node = shutil.which("node")
    if not node:
        FAILS.append(("Browser layer: node is available", "node was not found on PATH; the "
                      "browser rules cannot be checked, which is a fail and never a pass"))
        return None
    state = os.path.join(work, "browser", "shop.json")
    os.makedirs(os.path.dirname(state))
    make_state(build, state, BROWSER_STORY)
    shop = Server(build, state, 0)
    flow = Server(build, os.path.join(work, "browser", "flow.json"), 0)
    with case("Browser layer: the program starts for the browser"):
        shop.started()
        flow.started()
    if not (shop.port and flow.port):
        return None
    script = os.path.join(work, "browser", "browser.js")
    config = os.path.join(work, "browser", "config.json")
    with open(script, "w", encoding="utf-8") as handle:
        handle.write(BROWSER_JS)
    with open(config, "w", encoding="utf-8") as handle:
        json.dump({"shop": "http://127.0.0.1:%d" % shop.port,
                   "flow": "http://127.0.0.1:%d" % flow.port, "widths": [390, 768, 1280],
                   "paths": ["/", "/catalog", "/customers", "/sell", "/sales", "/sales/S1"]},
                  handle)
    run = None
    try:
        run = subprocess.Popen([node, script, config], cwd=os.path.join(work, "browser"),
                               stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                               stderr=subprocess.PIPE, text=True, start_new_session=True)
        stdout, stderr = run.communicate(timeout=150)
        lines = [line for line in stdout.splitlines() if line.startswith("{")]
        answer = json.loads(lines[-1]) if lines else {
            "fatal": "node gave no result: " + (stderr.strip()[-300:] or "no output")}
    except subprocess.TimeoutExpired:
        answer = {"fatal": "the browser run did not end within 150 s"}
    except OSError as error:
        answer = {"fatal": "node cannot be run: %s" % error}
    except ValueError as error:
        answer = {"fatal": "the browser run gave no JSON: %s" % error}
    finally:
        if run is not None and run.poll() is None:
            try:
                os.killpg(run.pid, 9)   # node and the browser it started
            except OSError:
                run.kill()
            run.wait(10)
        shop.kill()
        flow.kill()
    if "fatal" in answer:
        FAILS.append(("Browser layer: Playwright and Chromium run", answer["fatal"]))
        return None
    for result in answer["results"]:
        CASES.append(result["name"])
        if not result["ok"]:
            FAILS.append((result["name"], result["detail"]))
    return answer["graded"]


def main():
    if len(sys.argv) != 2:
        print("usage: check <build-dir>", file=sys.stderr)
        return 2
    source = os.path.abspath(sys.argv[1])
    missing = [name for name in ("web.py",) + MODULES
               if not os.path.isfile(os.path.join(source, name))]
    if missing:
        print("FAIL the build holds web.py and the four modules: missing %s"
              % ", ".join(missing), file=sys.stderr)
        return 1
    started = time.time()
    work = tempfile.mkdtemp(prefix="web-measure-")
    graded = None
    try:
        build = os.path.join(work, "build")
        os.makedirs(build)
        for name in os.listdir(source):
            path = os.path.join(source, name)
            if os.path.isfile(path):
                shutil.copy(path, os.path.join(build, name))
        size = os.path.getsize(os.path.join(build, "web.py"))
        http_layer(build, work)
        http_cases = len(CASES)
        graded = browser_layer(build, work)
    finally:
        Server.kill_all()
        shutil.rmtree(work, ignore_errors=True)
    counts = {}
    for defect in graded or []:
        counts[defect["kind"]] = counts.get(defect["kind"], 0) + 1
        print("graded defect: %s [%s] %s" % (defect["kind"], defect["where"], defect["what"]))
    print("cases: %d over HTTP, %d in the browser; %d failed; %.1f s"
          % (http_cases, len(CASES) - http_cases, len(FAILS), time.time() - started))
    if FAILS:
        for name, reason in FAILS:
            print("FAIL %s -- %s" % (name, reason), file=sys.stderr)
        return 1
    defects = len(graded)
    print("graded defects: %d (%s)" % (defects, ", ".join(
        "%s: %d" % pair for pair in sorted(counts.items())) or "none"))
    print("bytes of web.py: %d" % size)
    print("%.6f" % (defects + size / 1000000))
    return 0


if __name__ == "__main__":
    sys.exit(main())
