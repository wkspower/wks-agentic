def loopback_only(port):
    """The listening socket is on 127.0.0.1 and nowhere else."""
    wanted = "%04X" % port
    try:
        with open("/proc/net/tcp") as handle:
            for line in handle.read().splitlines()[1:]:
                part = line.split()
                address, _, local_port = part[1].partition(":")
                if part[3] == "0A" and local_port == wanted:
                    same(address, "0100007F", "address of the listening socket (/proc/net/tcp)")
        with open("/proc/net/tcp6") as handle:
            for line in handle.read().splitlines()[1:]:
                part = line.split()
                address, _, local_port = part[1].partition(":")
                expect(not (part[3] == "0A" and local_port == wanted and not address.strip("0")),
                       "listening on every IPv6 address (::)")
    except OSError:
        pass   # no /proc here: the connections below decide
    others = set()
    if sys.platform.startswith("linux"):
        others.add("127.0.0.2")
    try:
        probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        probe.connect(("192.0.2.1", 9))
        others.add(probe.getsockname()[0])
        probe.close()
    except OSError:
        pass
    try:
        others.update(socket.gethostbyname_ex(socket.gethostname())[2])
    except OSError:
        pass
    for address in sorted(others - {"127.0.0.1", "0.0.0.0"}):
        try:
            socket.create_connection((address, port), timeout=2).close()
        except OSError:
            continue   # refused or unreachable: not listening there
        raise AssertionError("the program also answers on %s" % address)


def free_port():
    probe = socket.socket()
    probe.bind(("127.0.0.1", 0))
    port = probe.getsockname()[1]
    probe.close()
    return port


