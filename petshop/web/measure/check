BROWSER_STORY = MODULE_STORY
BROWSER_JS = r'''
const fs = require('fs');
const cfg = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
let chromium;
try { ({ chromium } = require('playwright')); }
catch (e) { console.log(JSON.stringify({ fatal: 'Playwright for Node is not available: ' + e.message })); process.exit(0); }

const results = [];   // {name, ok, detail}: the hard rules
const graded = [];    // {kind, where, what}: one entry per graded defect
const rec = (name, ok, detail) =>
  results.push({ name, ok: !!ok, detail: ok ? '' : String(detail === undefined ? '' : detail).slice(0, 400) });

// Runs in the page: looks at everything that needs no interaction.
function inspect(opts) {
  const out = { tables: [], unnamed: [], negative: [], graded: [] };
  const de = document.documentElement;
  window.scrollTo(100000, 0);
  out.scroll = { scrollWidth: de.scrollWidth, clientWidth: de.clientWidth, scrollX: window.scrollX };
  window.scrollTo(0, 0);
  const desc = el => {
    let s = el.tagName.toLowerCase();
    if (el.id) s += '#' + el.id;
    if (el.getAttribute('name')) s += '[name=' + el.getAttribute('name') + ']';
    if (el.getAttribute('href')) s += '[href=' + el.getAttribute('href') + ']';
    const t = (el.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 30);
    return t ? s + ' "' + t + '"' : s;
  };
  const visible = el => {
    const r = el.getBoundingClientRect();
    const cs = getComputedStyle(el);
    return r.width > 0 && r.height > 0 && cs.visibility === 'visible' && cs.display !== 'none';
  };
  // a wide table scrolls inside its own container (it is not cut off instead)
  for (const table of document.querySelectorAll('table')) {
    for (let a = table.parentElement; a; a = a.parentElement) {
      const ox = getComputedStyle(a).overflowX;
      if (ox === 'visible') continue;
      if ((ox === 'hidden' || ox === 'clip') && table.getBoundingClientRect().width > a.clientWidth + 1)
        out.tables.push(desc(table) + ' is cut off by ' + desc(a).slice(0, 40));
      break;
    }
  }
  // every form control has a label a screen reader announces
  const text = el => (el ? (el.textContent || '').trim() : '');
  const nameOf = el => {
    const label = (el.getAttribute('aria-label') || '').trim();
    if (label) return label;
    const ids = (el.getAttribute('aria-labelledby') || '').trim();
    if (ids) {
      const t = ids.split(/\s+/).map(id => text(document.getElementById(id))).join(' ').trim();
      if (t) return t;
    }
    for (const l of (el.labels || [])) if (text(l)) return text(l);
    if (el.tagName === 'BUTTON') {
      if (text(el)) return text(el);
      const img = el.querySelector('img[alt]');
      if (img && img.alt.trim()) return img.alt;
    }
    if (el.tagName === 'INPUT') {
      const type = (el.getAttribute('type') || 'text').toLowerCase();
      if (type === 'submit' || type === 'reset') return el.value || type;
      if (type === 'button' && el.value.trim()) return el.value;
      if (type === 'image' && (el.getAttribute('alt') || '').trim()) return el.alt;
    }
    return (el.getAttribute('title') || '').trim();
  };
  for (const el of document.querySelectorAll('input:not([type=hidden]), select, textarea, button'))
    if (!nameOf(el)) out.unnamed.push(desc(el));

  // what the keyboard must reach, and how each looks before it has the focus
  const snap = el => {
    const cs = getComputedStyle(el);
    return {
      os: cs.outlineStyle, ow: cs.outlineWidth, oc: cs.outlineColor, shadow: cs.boxShadow,
      border: ['Top', 'Right', 'Bottom', 'Left'].map(s =>
        cs['border' + s + 'Width'] + cs['border' + s + 'Style'] + cs['border' + s + 'Color']).join('|'),
      bg: cs.backgroundColor + cs.backgroundImage, deco: cs.textDecorationLine,
    };
  };
  const wanted = [...document.querySelectorAll('a[href], button, input:not([type=hidden]), select, textarea')]
    .filter(el => visible(el) && !el.disabled);
  window.__chk = { snap, desc, pre: [] };
  wanted.forEach((el, i) => {
    el.setAttribute('data-chk', i);
    window.__chk.pre.push(snap(el));
    if (el.tabIndex < 0) out.negative.push(desc(el));
  });
  out.wanted = wanted.map(desc);

  // ---- graded ----
  const rgba = s => {
    const m = /^rgba?\(([^)]+)\)$/.exec(s.trim());
    if (!m) return null;
    const p = m[1].split(/[\s,\/]+/).filter(Boolean).map(parseFloat);
    if (p.length < 3 || p.some(isNaN)) return null;
    return [p[0], p[1], p[2], p.length > 3 ? p[3] : 1];
  };
  const over = (top, under) => {
    const a = top[3];
    return [0, 1, 2].map(i => top[i] * a + under[i] * (1 - a)).concat([1]);
  };
  const lum = c => {
    const f = v => { v /= 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };
    return 0.2126 * f(c[0]) + 0.7152 * f(c[1]) + 0.0722 * f(c[2]);
  };
  // the colour behind an element: its nearest backgrounds up the tree, over a white page
  const backgroundOf = el => {
    const layers = [];
    for (let a = el; a; a = a.parentElement) {
      const cs = getComputedStyle(a);
      if (cs.backgroundImage !== 'none') return null;   // a picture or gradient: not judged
      const c = rgba(cs.backgroundColor);
      if (!c) return null;
      if (c[3] > 0) layers.push(c);
      if (c[3] >= 1) break;
    }
    let bg = [255, 255, 255, 1];
    for (let i = layers.length - 1; i >= 0; i--) bg = over(layers[i], bg);
    return bg;
  };
  const judgeText = (el, color, what) => {
    const cs = getComputedStyle(el);
    if (parseFloat(cs.fontSize) < 14)
      out.graded.push({ kind: 'text smaller than 14 px', what: what + ' at ' + cs.fontSize });
    const fg = rgba(color), bg = backgroundOf(el);
    if (!fg || !bg) return;
    let alpha = fg[3];
    for (let a = el; a; a = a.parentElement) alpha *= parseFloat(getComputedStyle(a).opacity);
    const shown = over([fg[0], fg[1], fg[2], alpha], bg);
    const l1 = lum(shown), l2 = lum(bg);
    const ratio = (Math.max(l1, l2) + 0.05) / (Math.min(l1, l2) + 0.05);
    if (ratio < 4.5)
      out.graded.push({ kind: 'contrast below 4.5 to 1', what: what + ' at ' + ratio.toFixed(2) });
  };
  const skip = new Set(['SCRIPT', 'STYLE', 'NOSCRIPT', 'TEMPLATE', 'OPTION', 'OPTGROUP', 'TITLE', 'HEAD']);
  for (const el of document.body.querySelectorAll('*')) {
    if (skip.has(el.tagName) || !visible(el)) continue;
    const r = el.getBoundingClientRect();
    if (r.width < 2 || r.height < 2) continue;
    if (el.tagName === 'SELECT') {
      if (el.options.length) judgeText(el, getComputedStyle(el).color, desc(el));
    } else if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
      const type = (el.getAttribute('type') || 'text').toLowerCase();
      if (['checkbox', 'radio', 'range', 'color', 'file', 'image', 'hidden'].includes(type)) continue;
      if (el.value) judgeText(el, getComputedStyle(el).color, desc(el));
      else if (el.placeholder) judgeText(el, getComputedStyle(el, '::placeholder').color, desc(el) + ' placeholder');
    } else if ([...el.childNodes].some(n => n.nodeType === 3 && n.nodeValue.trim())) {
      judgeText(el, getComputedStyle(el).color, desc(el));
    }
  }
  if (opts.targets) {
    for (const el of wanted) {
      if (el.tagName === 'A') {
        const run = el.closest('p, li');
        if (run && text(run).length > text(el).length) continue;   // a link inside running text
      }
      const r = el.getBoundingClientRect();
      if (r.width < 43.99 || r.height < 43.99)
        out.graded.push({ kind: 'target smaller than 44 by 44 px', what: desc(el) + ' is ' + Math.round(r.width) + 'x' + Math.round(r.height) });
    }
  }
  if (opts.lines) {
    for (const p of document.querySelectorAll('p')) {
      if (!visible(p)) continue;
      const walker = document.createTreeWalker(p, NodeFilter.SHOW_TEXT);
      const range = document.createRange();
      let line = null; const lines = [];
      for (let node = walker.nextNode(); node; node = walker.nextNode()) {
        for (let i = 0; i < node.nodeValue.length; i++) {
          range.setStart(node, i); range.setEnd(node, i + 1);
          const r = range.getClientRects()[0];
          if (!r || r.width === 0) continue;
          if (!line || (r.top + r.bottom) / 2 > line.bottom) { line = { bottom: r.bottom, n: 0 }; lines.push(line); }
          line.n++;
          line.bottom = Math.max(line.bottom, r.bottom);
        }
      }
      for (const l of lines)
        if (l.n > 90) out.graded.push({ kind: 'line of running text longer than 90 characters', what: desc(p).slice(0, 50) + ' has a line of ' + l.n });
    }
  }
  return out;
}

// Runs in the page after a Tab: what has the focus, and is it visibly marked?
function focusedInfo() {
  const el = document.activeElement;
  if (!el || !el.hasAttribute('data-chk')) return null;
  const ids = [+el.getAttribute('data-chk')];
  if (el.tagName === 'INPUT' && el.type === 'radio' && el.name)
    for (const other of document.querySelectorAll('input[type=radio][data-chk]'))
      if (other.name === el.name && other.form === el.form) ids.push(+other.getAttribute('data-chk'));
  const pre = window.__chk.pre[ids[0]], now = window.__chk.snap(el);
  const alpha = c => { const m = /^rgba?\(([^)]+)\)$/.exec(c); if (!m) return 1; const p = m[1].split(/[\s,\/]+/).filter(Boolean); return p.length > 3 ? parseFloat(p[3]) : 1; };
  const outline = now.os !== 'none' && parseFloat(now.ow) > 0 && alpha(now.oc) > 0 &&
    (now.os !== pre.os || now.ow !== pre.ow || now.oc !== pre.oc);
  const mark = outline || now.shadow !== pre.shadow || now.border !== pre.border || now.bg !== pre.bg || now.deco !== pre.deco;
  return { ids, mark, desc: window.__chk.desc(el) };
}

async function checkPage(browser, base, path, width) {
  const where = 'GET ' + path + ' at ' + width + ' px';
  const host = new URL(base).host;
  const context = await browser.newContext({ viewport: { width, height: 900 } });
  try {
    const foreign = [], errors = [];
    await context.route('**/*', route => {
      const url = new URL(route.request().url());
      if (url.host === host || url.protocol === 'data:' || url.protocol === 'about:' || url.protocol === 'blob:') return route.continue();
      foreign.push(url.href.slice(0, 120));
      return route.abort();
    });
    const page = await context.newPage();
    page.setDefaultTimeout(10000);
    page.on('console', m => { if (m.type() === 'error' && !/net::ERR_FAILED/.test(m.text())) errors.push('console: ' + m.text()); });
    page.on('pageerror', e => errors.push('page error: ' + e.message));
    const response = await page.goto(base + path, { waitUntil: 'load' });
    rec('Browser: the page is served [' + where + ']', response && response.status() === 200, 'status ' + (response && response.status()));
    const info = await page.evaluate(inspect, { targets: width === 390, lines: width === 1280 });
    rec('The page never scrolls sideways [' + where + ']',
      info.scroll.scrollWidth <= info.scroll.clientWidth && info.scroll.scrollX === 0,
      'scrollWidth ' + info.scroll.scrollWidth + ' > clientWidth ' + info.scroll.clientWidth);
    rec('A wide table scrolls inside its own container [' + where + ']', info.tables.length === 0, info.tables.join('; '));
    rec('Every form control has a label a screen reader announces [' + where + ']', info.unnamed.length === 0, 'no label: ' + info.unnamed.join('; '));
    for (const g of info.graded) graded.push({ kind: g.kind, where, what: g.what });

    const n = info.wanted.length, reached = new Set(), unmarked = new Set();
    for (let k = 0; k < n + 30 && reached.size < n; k++) {
      await page.keyboard.press('Tab');
      let f = await page.evaluate(focusedInfo);
      if (!f) continue;
      if (!f.mark) { await page.waitForTimeout(400); f = await page.evaluate(focusedInfo); }
      if (!f) continue;
      f.ids.forEach(i => reached.add(i));
      if (!f.mark) unmarked.add(f.desc);
    }
    const missed = info.wanted.filter((d, i) => !reached.has(i));
    rec('Everything can be reached with the keyboard alone [' + where + ']',
      missed.length === 0 && info.negative.length === 0,
      'Tab never reaches: ' + missed.concat(info.negative).join('; '));
    rec('The focused control is visibly marked [' + where + ']', unmarked.size === 0, 'no visible change on focus: ' + [...unmarked].join('; '));
    rec('No error in the browser console [' + where + ']', errors.length === 0, errors.join('; '));
    rec('No request to another host [' + where + ']', foreign.length === 0, foreign.join('; '));
  } catch (e) {
    rec('Browser: the page can be checked [' + where + ']', false, e.message);
  } finally {
    await context.close();
  }
}

// ---- flows on a shop that starts empty: the real forms are filled and submitted ----
async function formFor(page, action, itemId) {
  // the form with that action whose field `id` can be the item (text input, select or hidden)
  const forms = page.locator('form[action="' + action + '"]');
  const n = await forms.count();
  for (let i = 0; i < n; i++) {
    const form = forms.nth(i);
    if (itemId === undefined) return form;
    const field = form.locator('[name="id"]').first();
    if (!(await field.count())) continue;
    const kind = await field.evaluate(e => e.tagName === 'SELECT' ? 'select' : (e.getAttribute('type') || 'text').toLowerCase());
    if (kind === 'select') {
      if (await field.locator('option').evaluateAll((os, v) => os.some(o => o.value === v), itemId)) { await field.selectOption(itemId); return form; }
    } else if (kind === 'hidden' || kind === 'radio') {
      if (await field.evaluate((e, v) => e.value === v, itemId)) { if (kind === 'radio') await field.check(); return form; }
    } else { await field.fill(itemId); return form; }
  }
  throw new Error('no form ' + action + ' that can be filled' + (itemId ? ' for item ' + itemId : ''));
}
async function submit(page, form) {
  const button = form.locator('button:not([type=button]):not([type=reset]), input[type=submit], input[type=image]').first();
  const navigated = page.waitForNavigation({ waitUntil: 'load', timeout: 6000 });
  if (await button.count()) await button.click();
  else await form.locator('input:not([type=hidden])').first().press('Enter');
  await navigated;
}
async function step(name, fn) {
  try { const problem = await fn(); rec(name, !problem, problem); }
  catch (e) { rec(name, false, e.message); }
}
const statusCount = page => page.locator('[role=status]').count();
const pathOf = page => new URL(page.url()).pathname;

async function noScriptFlow(browser, base) {
  const context = await browser.newContext({ javaScriptEnabled: false, viewport: { width: 1280, height: 900 } });
  const page = await context.newPage();
  page.setDefaultTimeout(6000);
  const pre = 'With scripts disabled: ';
  await step(pre + 'add an item by the form /catalog/add', async () => {
    await page.goto(base + '/catalog');
    const form = await formFor(page, '/catalog/add');
    await form.locator('[name="id"]').fill('flow1');
    await form.locator('[name="name"]').fill('Flow hamster');
    await form.locator('[name="price"]').fill('12.50');
    await form.locator('select[name="kind"]').selectOption('animal');
    await submit(page, form);
    if (pathOf(page) !== '/catalog') return 'ended on ' + page.url();
    if (await statusCount(page) !== 1) return 'no single role=status';
    if (await page.locator('#items tr[data-id="flow1"]').count() !== 1) return 'no row for the item';
  });
  await step(pre + 'receive stock by the form /stock/receive', async () => {
    await page.goto(base + '/catalog');
    const form = await formFor(page, '/stock/receive', 'flow1');
    await form.locator('[name="quantity"]').fill('5');
    await submit(page, form);
    if (pathOf(page) !== '/catalog') return 'ended on ' + page.url();
