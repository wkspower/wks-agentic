#!/usr/bin/env python3
"""Measure of the pet shop (docs/petshop/unit.md).

Usage: check <build-dir>      (the build dir holds shop.py and what it needs)

All cases pass: exit 0, last line of stdout = size of the build's shop.py in
bytes. Any case fails: exit 1, the failing case names on stderr.

The shop is tested from outside, as a program:
    python3 shop.py --state FILE COMMAND ...
Every case works on its own copy of the build in a temporary directory, with
its own state file, so nothing is written in the build dir and cases cannot
see each other. The rule cases (rule 3) read the sources and never run them.
"""
import ast
import os
import shutil
import subprocess
import sys
import tempfile

TIMEOUT = 15          # seconds for one run of shop.py
MAX_LINE = 100
NETWORK = {
    "socket", "socketserver", "ssl", "http", "urllib", "ftplib", "smtplib", "smtpd",
    "poplib", "imaplib", "nntplib", "telnetlib", "xmlrpc", "asyncio", "asyncore",
    "asynchat", "webbrowser",
}

HUNG = []             # set once a run of shop.py timed out: the rest is not run
CASES = []            # (name, function taking a Shop)
RULES = []            # (name, function taking the build dir)


def case(name):
    def register(function):
        CASES.append((name, function))
        return function
    return register


def rule(name):
    def register(function):
        RULES.append((name, function))
        return function
    return register


def expect(condition, message):
    if not condition:
        raise AssertionError(message)


class Shop:
    """One copy of the build, a default state file, and the two things a case
    claims of a command: it is `ok` and prints a line, or it is `refused`."""

    def __init__(self, build_dir, tmp):
        self.tmp = tmp
        self.build = os.path.join(tmp, "build")
        shutil.copytree(build_dir, self.build)
        self.state = self.path("data", "state.json")
        self.cwd = os.path.dirname(self.path("cwd", "x"))

    def path(self, *parts):
        """A path under the case's temporary directory; its directory exists."""
        full = os.path.join(self.tmp, *parts)
        os.makedirs(os.path.dirname(full), exist_ok=True)
        return full

    def run(self, args, state=None, cwd=None):
        command = [sys.executable, os.path.join(self.build, "shop.py"),
                   "--state", state or self.state] + list(args)
        return self.raw(command, cwd)

    def raw(self, command, cwd=None):
        env = {"PYTHONDONTWRITEBYTECODE": "1", "PATH": os.environ.get("PATH", ""),
               "HOME": self.path("home", "x")[:-2], "LC_ALL": "C.UTF-8"}
        words = ["--state", os.path.basename(command[3])] + command[4:]
        shown = " ".join(repr(a) if (not a or " " in a) else a for a in words)
        try:
            done = subprocess.run(command, cwd=cwd or self.cwd, env=env, timeout=TIMEOUT,
                                  stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                  stderr=subprocess.PIPE)
        except subprocess.TimeoutExpired:
            HUNG.append(shown)
            raise AssertionError("`%s` did not end within %d s" % (shown, TIMEOUT))
        return (shown, done.returncode, done.stdout.decode("utf-8", "replace"),
                done.stderr.decode("utf-8", "replace"))

    def ok(self, *args, prints, state=None, cwd=None):
        """The command succeeds: exit 0 and exactly the one line `prints` on stdout."""
        shown, code, out, err = self.run(args, state, cwd)
        expect(code == 0, "`%s` should succeed, exit code %d, stderr %r"
               % (shown, code, err.strip()[-200:]))
        expect(out.splitlines() == [str(prints)],
               "`%s` should print the one line %r, printed %r" % (shown, str(prints), out))

    def refused(self, *args, state=None, cwd=None):
        """The command is refused: exit 1, a message on stderr, nothing on stdout,
        and the state file, if there was one, is byte for byte what it was."""
        path = state or self.state
        before = read(path)
        shown, code, out, err = self.run(args, state, cwd)
        expect(code == 1, "`%s` should be refused with exit code 1, got %d (stdout %r)"
               % (shown, code, out))
        expect(out == "", "`%s` refused: nothing on stdout, got %r" % (shown, out))
        expect(err.strip() != "", "`%s` refused: a message on stderr, got none" % shown)
        if before is not None:
            expect(read(path) == before, "`%s` refused: the state file changed" % shown)


def read(path):
    if not os.path.exists(path):
        return None
    with open(path, "rb") as handle:
        return handle.read()


def stocked(s, state=None):
    """A small shop: three items, some of each on hand, one customer (C1)."""
    s.ok("add-item", "food", "Dog food", "product", "1250", prints="food", state=state)
    s.ok("add-item", "bone", "Bone", "product", "29", prints="bone", state=state)
    s.ok("add-item", "cat", "Tabby cat", "animal", "15000", prints="cat", state=state)
    s.ok("receive", "food", "10", prints=10, state=state)
    s.ok("receive", "bone", "20", prints=20, state=state)
    s.ok("receive", "cat", "3", prints=3, state=state)
    s.ok("register", "Ana", prints="C1", state=state)


def untouched(s, state=None):
    """The small shop is as `stocked` left it: nothing sold, nothing taken."""
    s.ok("stock", "food", prints=10, state=state)
    s.ok("stock", "bone", prints=20, state=state)
    s.ok("stock", "cat", prints=3, state=state)
    s.ok("takings", prints=0, state=state)


