# ----------------------------------------- rule 3 of docs/petshop/unit.md

def sources(build_dir):
    found = []
    for folder, _, names in os.walk(build_dir):
        found += [os.path.join(folder, name) for name in names if name.endswith(".py")]
    return sorted(found)


def siblings(build_dir):
    """Names importable from the build dir itself: its modules and packages."""
    names = set()
    for name in os.listdir(build_dir):
        if name.endswith(".py"):
            names.add(name[:-3])
        elif os.path.isdir(os.path.join(build_dir, name)):
            names.add(name)
    return names


def imports_of(path):
    """Top-level names of every module imported anywhere in the file
    (relative imports stay inside the build and are left out)."""
    with open(path, encoding="utf-8") as handle:
        tree = ast.parse(handle.read(), filename=path)
    names = []
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            names += [alias.name.split(".")[0] for alias in node.names]
        elif isinstance(node, ast.ImportFrom) and not node.level:
            names.append(node.module.split(".")[0])
    return names


def offenders(build_dir, wrong):
    """`file: names` for every source whose imports include names that are `wrong`."""
    found = []
    for path in sources(build_dir):
        names = sorted({name for name in imports_of(path) if wrong(name)})
        if names:
            found.append("%s: %s" % (os.path.relpath(path, build_dir), ", ".join(names)))
    return found


@rule("rule_standard_library_only")
def _(build_dir):
    """Python 3 standard library only (beside the modules of the build itself)."""
    own = siblings(build_dir)
    found = offenders(build_dir,
                      lambda name: name not in own and name not in sys.stdlib_module_names)
    expect(not found, "imports outside the standard library: %s" % "; ".join(found))


@rule("rule_no_network")
def _(build_dir):
    """No network."""
    found = offenders(build_dir, lambda name: name in NETWORK)
    expect(not found, "imports network modules: %s" % "; ".join(found))


@rule("rule_no_line_over_100_characters")
def _(build_dir):
    """No line longer than 100 characters."""
    found = []
    for path in sources(build_dir):
        with open(path, encoding="utf-8") as handle:
            found += ["%s:%d" % (os.path.relpath(path, build_dir), n)
                      for n, line in enumerate(handle.read().splitlines(), 1)
                      if len(line) > MAX_LINE]
    expect(not found, "lines longer than %d characters: %s" % (MAX_LINE, ", ".join(found)))


# ------------------------------------------------------------- the running

def describe(error):
    text = "%s: %s" % (type(error).__name__, error)
    return " ".join(text.split())[:400]


def main(argv):
    if len(argv) != 2:
        sys.stderr.write("usage: check <build-dir>\n")
        return 1
    build_dir = os.path.abspath(argv[1])
    shop = os.path.join(build_dir, "shop.py")
    if not os.path.isfile(shop):
        sys.stderr.write("FAIL build_has_shop_py: no shop.py in %s\n" % build_dir)
        return 1
    failed = []
    for name, function in RULES:
        try:
            function(build_dir)
        except Exception as error:
            failed.append((name, describe(error)))
    for name, function in CASES:
        if HUNG:
            failed.append((name, "not run: the build hung earlier"))
            continue
        with tempfile.TemporaryDirectory() as tmp:
            try:
                function(Shop(build_dir, tmp))
            except Exception as error:
                failed.append((name, describe(error)))
    total = len(RULES) + len(CASES)
    for name, problem in failed:
        sys.stderr.write("FAIL %s: %s\n" % (name, problem))
    if failed:
        print("%d of %d cases failed" % (len(failed), total))
        return 1
    print("%d cases passed" % total)
    print(os.path.getsize(shop))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
