@case("state_is_in_the_file_and_nowhere_else")
def _(s):
    """The shop moves with its file: copied elsewhere and run from another
    directory it goes on as before; with the file gone, it starts from nothing."""
    stocked(s)
    s.ok("sell", "C1", "food=4", prints="S1 5000")
    moved = s.path("elsewhere", "moved shop.json")
    shutil.copyfile(s.state, moved)
    os.remove(s.state)
    other_cwd = os.path.dirname(s.path("other cwd", "x"))
    s.ok("stock", "food", prints=6, state=moved, cwd=other_cwd)
    s.ok("register", "Bruno", prints="C2", state=moved, cwd=other_cwd)
    s.ok("sell", "C2", "cat=1", prints="S2 15000", state=moved, cwd=other_cwd)
    s.ok("takings", prints=20000, state=moved, cwd=other_cwd)
    s.refused("sell", "C1", "food=1")
    s.ok("register", "Zeca", prints="C1")
    s.ok("takings", prints=0)
    s.ok("takings", prints=20000, state=moved)


