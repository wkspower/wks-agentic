# ------------------------------------------- the state file as one JSON object
#
# "The state file ... is one JSON object holding the four units' states under
# `catalog`, `stock`, `customers`, `sales`." The states themselves are opaque
# (each unit's document): no case looks inside a value. What is claimed is that
# the value under a key IS that unit's state, so a whole value moved from one
# shop's file to another's carries that unit, and only that unit, with it.

UNITS = ("catalog", "stock", "customers", "sales")


def state_object(path):
    """The state file read as the document states it: one JSON object with the
    four keys (other keys are not looked at)."""
    data = read(path)
    expect(data is not None, "there is no state file %s" % os.path.basename(path))
    try:
        found = json.loads(data.decode("utf-8"))
    except ValueError as error:
        raise AssertionError("the state file is not JSON: %s" % error)
    expect(isinstance(found, dict),
           "the state file is not one JSON object but a %s" % type(found).__name__)
    missing = [key for key in UNITS if key not in found]
    expect(not missing, "the state file has no key %s (its keys: %s)"
           % (", ".join(missing), ", ".join(sorted(found)) or "none"))
    return found


def written(s, name, value, **how):
    """A state file written by hand, not by the shop."""
    path = s.path("made", name)
    with open(path, "w", encoding="utf-8") as handle:
        json.dump(value, handle, **how)
    return path


def with_value_from(s, name, base, key, other):
    """A copy of the state file `base` whose whole value under `key` is replaced
    by the value under `key` of the state file `other`."""
    mixed = dict(state_object(base))
    mixed[key] = state_object(other)[key]
    return written(s, name, mixed)


