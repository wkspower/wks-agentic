@case("two_state_files_are_independent")
def _(s):
    """Two state files are two shops: nothing passes from one to the other."""
    one, two = s.path("one", "shop.json"), s.path("two", "shop.json")
    stocked(s, state=one)
    s.ok("sell", "C1", "food=4", prints="S1 5000", state=one)
    s.refused("sell", "C1", "food=1", state=two)
    s.ok("register", "Zeca", prints="C1", state=two)
    s.ok("add-item", "food", "Cat food", "product", "700", prints="food", state=two)
    s.ok("receive", "food", "2", prints=2, state=two)
    s.ok("sell", "C1", "food=1", prints="S1 700", state=two)
    s.ok("takings", prints=700, state=two)
    s.ok("takings", prints=5000, state=one)
    s.ok("stock", "food", prints=6, state=one)
    s.ok("register", "Bruno", prints="C2", state=one)


@case("state_is_in_the_file_and_nowhere_else")
def _(s):
    """The shop moves with its file: copied elsewhere and run from another
    directory it goes on as before; with the file gone, it starts from nothing."""
    stocked(s)
    s.ok("sell", "C1", "food=4", prints="S1 5000")
    moved = s.path("elsewhere", "moved shop.json")
    shutil.copyfile(s.state, moved)
    os.remove(s.state)
    other_cwd = os.path.dirname(s.path("other cwd", "x"))
    s.ok("stock", "food", prints=6, state=moved, cwd=other_cwd)
    s.ok("register", "Bruno", prints="C2", state=moved, cwd=other_cwd)
    s.ok("sell", "C2", "cat=1", prints="S2 15000", state=moved, cwd=other_cwd)
