# ---------------------------------------------------------------- refusals

def refused(m, error, customer_id, lines, on_hand=None, prices=None):
    """The call raises `error`; take was never called and nothing was recorded:
    sales and takings are as before and the next sale gets the next unused id."""
    w = World(on_hand=on_hand, prices=prices)
    state = m.new()
    same(w.sell(m, state, "C1", [("food", 1)]), wanted("S1", "C1", [("food", 1)]))
    sales_before, takings_before = all_sales(m, state), m.takings(state)
    w.takes.clear()
    try:
        w.sell(m, state, customer_id, lines)
    except error:
        pass
    else:
        raise AssertionError("expected %s, the call returned" % error.__name__)
    expect(w.takes == [], "take was called on a refusal: %r" % w.takes)
    expect(all_sales(m, state) == sales_before, "a refused sale changed sales()")
    expect(m.takings(state) == takings_before, "a refused sale changed takings()")
    for sale_id in ("S2", "S3"):
        try:
            m.get(state, sale_id)
        except KeyError:
            pass
        else:
            raise AssertionError("a refused sale was recorded as %s" % sale_id)
    after = w.sell(m, state, "C2", [("bone", 2)])
    same(after, wanted("S2", "C2", [("bone", 2)]), "the sale after a refusal")
    expect(all_sales(m, state) == sales_before + [wanted("S2", "C2", [("bone", 2)])],
           "sales() after a refusal and one more sale")
    expect(m.takings(state) == takings_before + 58, "takings() after a refusal and a sale")


GOOD = [("food", 1), ("bone", 2)]

for _name, _customer in (("empty", ""), ("none", None), ("int", 7), ("list", ["C1"])):
    @case("refused_customer_id_" + _name)
    def _(m, customer=_customer):
        """ValueError when customer_id is not a non-empty string."""
        refused(m, ValueError, customer, GOOD)


