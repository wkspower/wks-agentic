# ----------------------------------------------------- get, sales, takings

def three_sales(m):
    w = World()
    state = m.new()
    baskets = [("C1", [("food", 2), ("bone", 1)]), ("C2", [("cat", 1)]),
               ("C1", [("fish", 3), ("fish", 1), ("leaflet", 2)])]
    made = [w.sell(m, state, customer, lines) for customer, lines in baskets]
    expected = [wanted("S%d" % (n + 1), customer, lines)
                for n, (customer, lines) in enumerate(baskets)]
    for sale, exp in zip(made, expected):
        same(sale, exp)
    return w, state, expected


@case("get_returns_the_sale")
def _(m):
    """get(state, sale_id) returns the sale."""
    _, state, expected = three_sales(m)
    for exp in (expected[1], expected[2], expected[0]):
        same(m.get(state, exp["id"]), exp, "get(%s)" % exp["id"])


@case("get_unknown_is_keyerror")
def _(m):
    """get raises KeyError when the sale is unknown."""
    _, state, _ = three_sales(m)
    for state_, sale_id in ((state, "S4"), (state, "S0"), (state, "nope"), (m.new(), "S1")):
        try:
            m.get(state_, sale_id)
        except KeyError:
            continue
        raise AssertionError("get(%r) did not raise KeyError" % sale_id)


@case("sales_in_the_order_made")
def _(m):
    """sales(state) returns all sales in the order made."""
    _, state, expected = three_sales(m)
    expect(all_sales(m, state) == expected, "sales() is %r" % (all_sales(m, state),))


@case("takings_is_the_sum_of_totals")
def _(m):
    """takings(state) returns the sum of total_cents."""
    w, state, expected = three_sales(m)
    expect(m.takings(state) == 2529 + 15000 + 7996, "takings is %r" % (m.takings(state),))
    w.sell(m, state, "C3", [("bone", 10)])
    expect(m.takings(state) == 2529 + 15000 + 7996 + 290, "takings after one more sale")


@case("two_states_are_independent")
def _(m):
    """The state is all there is: the module holds none, so two states do not mix."""
    w = World()
    one, two = m.new(), m.new()
    w.sell(m, one, "C1", [("food", 1)])
    w.sell(m, one, "C1", [("food", 1)])
    expect(all_sales(m, two) == [] and m.takings(two) == 0, "a second state saw the first")
    same(w.sell(m, two, "C9", [("bone", 1)]), wanted("S1", "C9", [("bone", 1)]))
    same(w.sell(m, one, "C1", [("cat", 1)]), wanted("S3", "C1", [("cat", 1)]))
    same(w.sell(m, m.new(), "C1", [("cat", 1)]), wanted("S1", "C1", [("cat", 1)]))


# ------------------------------------------------------------------ copies

def scribble(sale):
    """Change everything about a returned sale that can be changed at the top."""
    sale["id"] = "S99"
    sale["customer_id"] = "nobody"
    sale["total_cents"] = -1
    sale["extra"] = True
    sale["lines"] = []


def scribble_lines(sale):
    """Change a returned sale through its lines."""
    sale["lines"][0]["quantity"] = 99
    sale["lines"][0]["line_total_cents"] = -1
    try:
        sale["lines"].append({"item_id": "x"})
    except AttributeError:
        pass


def copies(m, damage):
    w = World()
    state = m.new()
    lines = [("food", 2), ("bone", 1)]
    exp = wanted("S1", "C1", lines)
    damage(w.sell(m, state, "C1", lines))
    same(m.get(state, "S1"), exp, "after changing what sell returned, get")
    damage(m.get(state, "S1"))
    same(m.get(state, "S1"), exp, "after changing what get returned, get")
    damage(list(m.sales(state))[0])
    same(m.get(state, "S1"), exp, "after changing what sales returned, get")
    expect(all_sales(m, state) == [exp], "sales() changed through a returned sale")
    expect(m.takings(state) == exp["total_cents"], "takings() changed through a returned sale")


@case("returned_sales_are_copies")
def _(m):
    """Returned sales are copies: changing one changes nothing recorded."""
    copies(m, scribble)


@case("returned_sales_are_copies_lines_included")
def _(m):
    """The lines are part of the sale: changing a returned line changes nothing recorded."""
    copies(m, scribble_lines)


# ---------------------------------------------------------- JSON round trip

@case("json_round_trip_keeps_the_sales")
def _(m):
    """The state survives json.loads(json.dumps(state)): get, sales, takings as before."""
    _, state, expected = three_sales(m)
    back = roundtrip(state)
    expect(all_sales(m, back) == expected, "sales() after the round trip")
    for exp in expected:
        same(m.get(back, exp["id"]), exp, "get(%s) after the round trip" % exp["id"])
    expect(m.takings(back) == 2529 + 15000 + 7996, "takings() after the round trip")
    try:
        m.get(back, "S4")
    except KeyError:
        pass
    else:
        raise AssertionError("get('S4') after the round trip did not raise KeyError")


@case("json_round_trip_then_ids_continue")
def _(m):
    """Selling goes on after the round trip: the next id is the next unused one."""
    w, state, expected = three_sales(m)
    back = roundtrip(state)
    lines = [("bone", 2), ("bone", 1)]
    same(w.sell(m, back, "C4", lines), wanted("S4", "C4", lines))
    back = roundtrip(roundtrip(back))
    same(w.sell(m, back, "C5", [("cat", 1)]), wanted("S5", "C5", [("cat", 1)]))
    expect(all_sales(m, back) == expected + [wanted("S4", "C4", lines),
                                             wanted("S5", "C5", [("cat", 1)])],
           "sales() after selling on a round-tripped state")
    same(m.get(back, "S4"), wanted("S4", "C4", lines), "get(S4)")
    expect(m.takings(back) == 2529 + 15000 + 7996 + 87 + 15000, "takings()")


@case("json_round_trip_of_a_new_state")
def _(m):
    """An empty state survives the round trip too."""
    w = World()
    state = roundtrip(m.new())
    expect(all_sales(m, state) == [] and m.takings(state) == 0, "empty after the round trip")
    same(w.sell(m, state, "C1", [("food", 1)]), wanted("S1", "C1", [("food", 1)]))


@case("json_round_trip_then_refusals_still_hold")
def _(m):
    """After the round trip a refusal still takes nothing and records nothing."""
    w, state, expected = three_sales(m)
    back = roundtrip(state)
    w.takes.clear()
    w.on_hand["cat"] = 3
    for error, lines in ((ValueError, [("food", 1), ("cat", 2), ("cat", 2)]),
                         (ValueError, [("food", 1), ("bone", True)]),
                         (KeyError, [("food", 1), ("ghost", 1)])):
        w.on_hand["ghost"] = 50
        try:
            w.sell(m, back, "C1", lines)
        except error:
            pass
        else:
            raise AssertionError("expected %s for %r" % (error.__name__, lines))
        expect(w.takes == [], "take was called on a refusal: %r" % w.takes)
    expect(all_sales(m, back) == expected, "refusals changed sales()")
    same(w.sell(m, back, "C1", [("cat", 3)]), wanted("S4", "C1", [("cat", 3)]))


# ----------------------------------------- rule 3 of docs/petshop/unit.md

def imports_of(path):
    """Top-level names of every module imported anywhere in the file."""
    with open(path, encoding="utf-8") as handle:
        tree = ast.parse(handle.read(), filename=path)
    names = []
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            names += [alias.name.split(".")[0] for alias in node.names]
        elif isinstance(node, ast.ImportFrom):
            if node.level:
                names.append("." * node.level + (node.module or ""))
            else:
                names.append(node.module.split(".")[0])
    return names


@rule("rule_standard_library_only")
def _(path):
    """Python 3 standard library only."""
    foreign = sorted({name for name in imports_of(path)
                      if name.lstrip(".") != name or name not in sys.stdlib_module_names})
    expect(not foreign, "imports outside the standard library: %s" % ", ".join(foreign))


@rule("rule_imports_no_other_unit")
def _(path):
    """A unit's module imports no other unit's module."""
    units = sorted({name for name in imports_of(path) if name.lstrip(".") in OTHER_UNITS})
    expect(not units, "imports another unit's module: %s" % ", ".join(units))


@rule("rule_no_network")
def _(path):
    """No network."""
    network = sorted({name for name in imports_of(path) if name in NETWORK})
    expect(not network, "imports network modules: %s" % ", ".join(network))


@rule("rule_no_line_over_100_characters")
def _(path):
    """No line longer than 100 characters."""
    with open(path, encoding="utf-8") as handle:
        long = [str(n) for n, line in enumerate(handle.read().splitlines(), 1)
                if len(line) > MAX_LINE]
    expect(not long, "lines longer than %d characters: %s" % (MAX_LINE, ", ".join(long)))


# ------------------------------------------------------------- the running

def describe(error):
    text = "%s: %s" % (type(error).__name__, error)
    return " ".join(text.split())[:300]


def child(build_dir, result_path):
    """Run every case against the build's sales.py; one JSON line per case."""
    here = os.path.dirname(os.path.abspath(__file__))
    sys.path[:] = [p for p in sys.path if os.path.abspath(p or ".") != here]
    out = open(result_path, "a", encoding="utf-8")

    def report(name, problem):
        out.write(json.dumps([name, problem]) + "\n")
        out.flush()

    try:
        spec = importlib.util.spec_from_file_location(
            "sales", os.path.join(build_dir, "sales.py"))
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
    except BaseException as error:
        report("import_sales", describe(error))
        return
    report("import_sales", None)
    for name, function in CASES:
        try:
            function(module)
        except BaseException as error:
            report(name, describe(error))
        else:
            report(name, None)


def run_cases(build_dir):
    """Results of the child: {case name: None or the problem}."""
    names = ["import_sales"] + [name for name, _ in CASES]
    results = {}
    with tempfile.TemporaryDirectory() as tmp:
        result_path = os.path.join(tmp, "results")
        env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
        command = [sys.executable, "-B", os.path.abspath(__file__), "--child",
                   build_dir, result_path]
        note = "not run: the build crashed or exited"
        try:
            subprocess.run(command, cwd=tmp, env=env, timeout=TIMEOUT,
                           stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            note = "not run: the build hung (timeout %ds)" % TIMEOUT
        if os.path.exists(result_path):
            with open(result_path, encoding="utf-8") as handle:
                for line in handle:
                    try:
                        name, problem = json.loads(line)
                    except ValueError:
                        continue
                    results[name] = problem
    if results.get("import_sales"):
        note = "not run: sales.py could not be imported"
    return [(name, results.get(name, note)) for name in names]


def main(argv):
    if len(argv) == 4 and argv[1] == "--child":
        child(argv[2], argv[3])
        return 0
    if len(argv) != 2:
        sys.stderr.write("usage: check <build-dir>\n")
        return 1
    build_dir = os.path.abspath(argv[1])
    path = os.path.join(build_dir, "sales.py")
    if not os.path.isfile(path):
        sys.stderr.write("FAIL build_has_sales_py: no sales.py in %s\n" % build_dir)
        return 1
    results = []
    for name, function in RULES:
        try:
            function(path)
        except Exception as error:
            results.append((name, describe(error)))
        else:
            results.append((name, None))
    results += run_cases(build_dir)
    failed = [(name, problem) for name, problem in results if problem]
    for name, problem in failed:
        sys.stderr.write("FAIL %s: %s\n" % (name, problem))
    if failed:
        print("%d of %d cases failed" % (len(failed), len(results)))
        return 1
    print("%d cases passed" % len(results))
    print(os.path.getsize(path))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
