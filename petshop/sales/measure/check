#!/usr/bin/env python3
"""Measure of the sales unit (docs/petshop/sales/unit.md).

Usage: check <build-dir>          (the build dir holds sales.py)

All cases pass: exit 0, last line of stdout = size of sales.py in bytes.
Any case fails: exit 1, the failing case names on stderr.

The cases call sales.py in a child process (this same script, --child), so a
build that crashes, hangs or exits cannot take the check down with it. The
rule cases (rule 3 of docs/petshop/unit.md) read the source and never run it.
"""
import ast
import importlib.util
import json
import os
import subprocess
import sys
import tempfile

TIMEOUT = 60          # seconds for the whole child run
MAX_LINE = 100
OTHER_UNITS = {"catalog", "stock", "customers", "shop"}
NETWORK = {
    "socket", "socketserver", "ssl", "http", "urllib", "ftplib", "smtplib", "smtpd",
    "poplib", "imaplib", "nntplib", "telnetlib", "xmlrpc", "asyncio", "asyncore",
    "asynchat", "webbrowser",
}

CASES = []            # (name, function taking the module), run in the child
RULES = []            # (name, function taking the path of sales.py), run in the parent


def case(name):
    def register(function):
        CASES.append((name, function))
        return function
    return register


def rule(name):
    def register(function):
        RULES.append((name, function))
        return function
    return register


def expect(condition, message):
    if not condition:
        raise AssertionError(message)


# ---------------------------------------------------------------- the fakes

PRICES = {"food": 1250, "bone": 29, "fish": 1999, "cat": 15000, "leaflet": 0}


class World:
    """The three callables sales receives, as fakes that record their calls."""

    def __init__(self, on_hand=None, prices=None):
        self.prices = dict(PRICES if prices is None else prices)
        self.on_hand = {item: 50 for item in self.prices}
        self.on_hand.update(on_hand or {})
        self.takes = []

    def price_of(self, item_id):
        return self.prices[item_id]            # KeyError when unknown

    def available(self, item_id):
        return self.on_hand.get(item_id, 0)

    def take(self, item_id, quantity):
        self.takes.append((item_id, quantity))
        self.on_hand[item_id] = self.on_hand.get(item_id, 0) - quantity

    def sell(self, m, state, customer_id, lines):
        return m.sell(state, customer_id, lines, self.price_of, self.available, self.take)


def wanted(sale_id, customer_id, lines, prices=PRICES):
    """The sale the document describes for these lines."""
    rows = [{"item_id": item, "quantity": quantity, "unit_price_cents": prices[item],
             "line_total_cents": quantity * prices[item]} for item, quantity in lines]
    return {"id": sale_id, "customer_id": customer_id, "lines": rows,
            "total_cents": sum(row["line_total_cents"] for row in rows)}


def plain(sale):
    """A sale as plain data, so that sales can be compared."""
    expect(isinstance(sale, dict), "a sale must be a dict, got %r" % (sale,))
    expect("lines" in sale, "a sale must have 'lines', got %r" % (sale,))
    out = dict(sale)
    out["lines"] = [dict(line) for line in sale["lines"]]
    return out


def same(sale, expected, what="sale"):
    got = plain(sale)
    expect(got == expected, "%s: expected %r, got %r" % (what, expected, got))


def all_sales(m, state):
    return [plain(sale) for sale in m.sales(state)]


def roundtrip(state):
    return json.loads(json.dumps(state))


# ------------------------------------------------- new, sale shape, totals

@case("new_state_is_empty")
def _(m):
    """new() returns an empty state: no sales, takings 0."""
    state = m.new()
    expect(all_sales(m, state) == [], "sales of a new state must be empty")
    expect(m.takings(state) == 0, "takings of a new state must be 0")


@case("sale_has_exactly_the_stated_keys")
def _(m):
    """Sale: exactly id, customer_id, lines, total_cents; line: exactly four keys."""
    w = World()
    sale = w.sell(m, m.new(), "C1", [("food", 2), ("bone", 1)])
    expect(isinstance(sale, dict), "sell must return a dict")
    expect(set(sale) == {"id", "customer_id", "lines", "total_cents"},
           "sale keys are %r" % sorted(sale))
    expect(len(sale["lines"]) == 2, "one dict per given line")
    for line in sale["lines"]:
        expect(isinstance(line, dict), "a line must be a dict")
        expect(set(line) == {"item_id", "quantity", "unit_price_cents", "line_total_cents"},
               "line keys are %r" % sorted(line))


