#!/usr/bin/env python3
"""Measure of petshop/catalog (docs/petshop/catalog/unit.md, declaration 5).

Usage: check <build-dir>      (<build-dir> holds catalog.py)

Pass: exit 0, last stdout line = size in bytes of catalog.py.
Fail: exit 1, the failing case names on stderr.

Each function named case_* below is one claim of the unit's document; its
docstring says which. Every case runs twice: mode [plain], where rt(state)
gives the state back untouched, and mode [json], where rt(state) is
json.loads(json.dumps(state)) and only the result is used from then on.
The state is never looked into: cases use only the documented functions.
The rule_* cases are the rules of docs/petshop/unit.md rule 3 that can be
checked on the module file. The module is loaded and run in a separate
process with a timeout, never in this one.
"""
import ast
import json
import os
import subprocess
import sys
import tempfile
import tokenize

UNIT = "catalog"
TIMEOUT = 20        # seconds for all cases together
MAX_LINE = 100      # characters, docs/petshop/unit.md rule 3
NETWORK = {         # modules that reach the network
    "socket", "socketserver", "ssl", "urllib", "http", "ftplib", "smtplib", "smtpd",
    "poplib", "imaplib", "nntplib", "telnetlib", "xmlrpc", "webbrowser", "asyncore",
    "asynchat", "wsgiref",
}


# ---------------------------------------------------------------- helpers

class Failed(Exception):
    """A case's claim does not hold for this build."""


def same(got, want):
    """Strict equality: 1 is not True is not 1.0; a tuple is not a list."""
    if want is None or isinstance(want, bool):
        return got is want
    if isinstance(want, int):
        return isinstance(got, int) and not isinstance(got, bool) and got == want
    if isinstance(want, str):
        return isinstance(got, str) and got == want
    if isinstance(want, list):
        return (isinstance(got, list) and len(got) == len(want)
                and all(same(g, w) for g, w in zip(got, want)))
    if isinstance(want, dict):
        return (isinstance(got, dict) and set(got.keys()) == set(want.keys())
                and all(same(got[k], want[k]) for k in want))
    return type(got) is type(want) and got == want


def expect(got, want, what):
    if not same(got, want):
        raise Failed("%s: got %r, want %r" % (what, got, want))


def raises(exc, what, fn, *args):
    """fn(*args) must raise exc (a KeyError is not a ValueError, nor the reverse)."""
    try:
        got = fn(*args)
    except exc:
        return
    except Exception as err:
        raise Failed("%s: raised %s, want %s" % (what, type(err).__name__, exc.__name__))
    raise Failed("%s: returned %r, want %s" % (what, got, exc.__name__))


def outcome(fn, *args):
    """What a caller sees from fn(*args): the value, or the kind of exception."""
    try:
        return ["returned", fn(*args)]
    except Exception as err:
        return ["raised", type(err).__name__]


# ---------------------------------------------------------------- cases
# Signature: case(m, rt). m is the build's catalog module; rt is described above.

import enum

def item(item_id, name, kind, price_cents):
    return {"id": item_id, "name": name, "kind": kind, "price_cents": price_cents}


def view(m, state, ids):
    """Everything a caller can observe: items(), and get() of each id in ids."""
    return [outcome(m.items, state)] + [outcome(m.get, state, i) for i in ids]


def refused(m, state, exc, ids, what, fn, *args):
    """fn(state, *args) raises exc and changes nothing a caller can observe."""
    before = view(m, state, ids)
    raises(exc, what, fn, state, *args)
    expect(view(m, state, ids), before, "state after refused " + what)


def shop(m, rt):
    """A state with three items, added out of id order."""
    s = m.new()
    m.add(s, "cat", "Tom", "animal", 15000)
    s = rt(s)
    m.add(s, "ant", "Farm", "product", 2500)
    m.add(s, "bee", "Maya", "animal", 0)
    return rt(s)


NOT_TEXT = ["", None, 7, 1.5, True, ["cat"], b"cat"]        # not a non-empty string
NOT_KIND = ["Animal", "animals", "PRODUCT", " animal", "", "pet", None, 1, ["animal"]]
NOT_PRICE = [-1, -100, True, False, 1.5, 100.0, "100", None, [100]]


class Cents(int):
    """An int subclass a caller might write: an instance is not exactly an int."""


class Tag(enum.IntEnum):
    """An enum whose members are ints by subclass."""
    SALE = 500


SUBCLASS_PRICE = [Cents(100), Cents(0), Tag.SALE]           # int by subclass only
NOT_A_STRING_ID = [None, 7, True, 1.5, b"cat", ("cat",), ["cat"], {"id": "cat"}]


def case_new_is_empty(m, rt):
    """new() returns an empty state: items() is []; get() of anything is KeyError."""
    s = rt(m.new())
    expect(m.items(s), [], "items(new())")
    raises(KeyError, "get on empty state", m.get, s, "cat")


def case_add_returns_none_and_get_returns_the_item(m, rt):
    """add returns None; get returns a dict with exactly id, name, kind, price_cents."""
    s = m.new()
    expect(m.add(s, "cat", "Tom", "animal", 15000), None, "add returned")
    s = rt(s)
    expect(m.get(s, "cat"), item("cat", "Tom", "animal", 15000), "get after add")
    expect(m.add(s, "ant", "Farm", "product", 2500), None, "second add returned")
    s = rt(s)
    expect(m.get(s, "ant"), item("ant", "Farm", "product", 2500), "get second item")
    expect(m.get(s, "cat"), item("cat", "Tom", "animal", 15000), "get first item")


def case_price_zero_and_large_prices_are_valid(m, rt):
    """A valid price is an int of 0 or more: 0 and 123456789012 are accepted."""
    s = m.new()
    m.add(s, "free", "Leaflet", "product", 0)
    m.add(s, "dear", "Horse", "animal", 123456789012)
    s = rt(s)
    expect(m.get(s, "free"), item("free", "Leaflet", "product", 0), "price 0")
    expect(m.get(s, "dear"), item("dear", "Horse", "animal", 123456789012), "large price")


def case_strings_are_kept_as_given(m, rt):
    """The item holds the id and name it was added with (spaces, case, non-ASCII)."""
    s = m.new()
    m.add(s, "Dog Food 2kg", " Ração  Extra ", "product", 4990)
    m.add(s, "dog food 2kg", "ração", "product", 1)
    s = rt(s)
    expect(m.get(s, "Dog Food 2kg"), item("Dog Food 2kg", " Ração  Extra ", "product", 4990),
           "get item with spaces")
    expect(m.get(s, "dog food 2kg"), item("dog food 2kg", "ração", "product", 1),
           "get item differing only in case")


def case_add_refuses_id_that_is_not_a_non_empty_string(m, rt):
    """add: ValueError when item_id is not a non-empty string; nothing changes."""
    s = shop(m, rt)
    for bad in NOT_TEXT:
        refused(m, s, ValueError, ["cat", "ant", "bee"], "add with id %r" % (bad,),
                m.add, bad, "Rex", "animal", 100)
        s = rt(s)


def case_add_refuses_name_that_is_not_a_non_empty_string(m, rt):
    """add: ValueError when name is not a non-empty string; nothing changes."""
    s = shop(m, rt)
    for bad in NOT_TEXT:
        refused(m, s, ValueError, ["cat", "ant", "bee", "dog"], "add with name %r" % (bad,),
                m.add, "dog", bad, "animal", 100)
        s = rt(s)


def case_add_refuses_kind_other_than_animal_or_product(m, rt):
    """add: ValueError when kind is not "animal" or "product"; nothing changes."""
    s = shop(m, rt)
    for bad in NOT_KIND:
        refused(m, s, ValueError, ["cat", "ant", "bee", "dog"], "add with kind %r" % (bad,),
                m.add, "dog", "Rex", bad, 100)
        s = rt(s)


def case_add_refuses_invalid_price(m, rt):
    """add: ValueError when the price is not an int (not a bool) of 0 or more."""
    s = shop(m, rt)
    for bad in NOT_PRICE:
        refused(m, s, ValueError, ["cat", "ant", "bee", "dog"], "add with price %r" % (bad,),
                m.add, "dog", "Rex", "animal", bad)
        s = rt(s)


def case_add_refuses_existing_id(m, rt):
    """add: ValueError when the id already exists; the existing item is unchanged."""
    s = shop(m, rt)
    refused(m, s, ValueError, ["cat", "ant", "bee"], "add of existing id, other values",
            m.add, "cat", "Felix", "product", 1)
    s = rt(s)
    refused(m, s, ValueError, ["cat", "ant", "bee"], "add of existing id, same values",
            m.add, "cat", "Tom", "animal", 15000)
    expect(m.get(s, "cat"), item("cat", "Tom", "animal", 15000), "item after refused adds")


def case_get_unknown_is_keyerror(m, rt):
    """get: KeyError when the id is unknown."""
    s = shop(m, rt)
    for unknown in ["dog", "Cat", "ca", "cats", "Tom", "animal"]:
        refused(m, s, KeyError, ["cat", "ant", "bee"], "get(%r)" % unknown, m.get, unknown)


def case_set_price_changes_the_price_and_nothing_else(m, rt):
    """set_price returns None; afterwards get and items show the new price."""
    s = shop(m, rt)
    expect(m.set_price(s, "cat", 17550), None, "set_price returned")
    s = rt(s)
    expect(m.get(s, "cat"), item("cat", "Tom", "animal", 17550), "get after set_price")
    expect(m.set_price(s, "ant", 0), None, "set_price to 0 returned")
    expect(m.set_price(s, "bee", 0), None, "set_price to the same price returned")
    s = rt(s)
    expect(m.items(s), [item("ant", "Farm", "product", 0), item("bee", "Maya", "animal", 0),
                        item("cat", "Tom", "animal", 17550)], "items after set_price")


def case_set_price_unknown_is_keyerror(m, rt):
    """set_price: KeyError when the id is unknown; no item appears."""
    s = shop(m, rt)
    refused(m, s, KeyError, ["cat", "ant", "bee", "dog"], "set_price of unknown id",
            m.set_price, "dog", 100)
    s = rt(m.new())
    refused(m, s, KeyError, ["dog"], "set_price on empty state", m.set_price, "dog", 100)


def case_set_price_refuses_invalid_price(m, rt):
    """set_price: ValueError when the price is not valid; the price is unchanged."""
    s = shop(m, rt)
    for bad in NOT_PRICE:
        refused(m, s, ValueError, ["cat", "ant", "bee"], "set_price to %r" % (bad,),
                m.set_price, "cat", bad)
        s = rt(s)
    expect(m.get(s, "cat"), item("cat", "Tom", "animal", 15000), "item after refusals")


def case_items_are_ordered_by_id(m, rt):
    """items returns all items as a list ordered by id (not by name, not as added)."""
    s = m.new()
    added = [("dog", "Ace", "animal", 4), ("ant", "Zed", "product", 3),
             ("eel", "Bob", "animal", 5), ("cat", "Kim", "animal", 1),
             ("bee", "Moe", "product", 2), ("fox", "Abe", "animal", 0)]
    for args in added:
        m.add(s, *args)
        s = rt(s)
    want = [item(*args) for args in sorted(added)]
    expect(m.items(s), want, "items")
    m.set_price(s, "ant", 99)
    want[0] = item("ant", "Zed", "product", 99)
    expect(m.items(rt(s)), want, "items after set_price")


def case_get_returns_a_copy(m, rt):
    """Returned items are copies: changing what get returned changes nothing."""
    s = shop(m, rt)
    got = m.get(s, "cat")
    got["price_cents"] = 1
    got["name"] = "Changed"
    got["extra"] = True
    del got["kind"]
    expect(m.get(s, "cat"), item("cat", "Tom", "animal", 15000), "get after mutation")
    got = m.get(s, "ant")
    got.clear()
    s = rt(s)
    expect(m.items(s), [item("ant", "Farm", "product", 2500), item("bee", "Maya", "animal", 0),
                        item("cat", "Tom", "animal", 15000)], "items after mutations")


def case_items_returns_copies(m, rt):
    """Returned items are copies: changing the list or its items changes nothing."""
    s = shop(m, rt)
    want = [item("ant", "Farm", "product", 2500), item("bee", "Maya", "animal", 0),
            item("cat", "Tom", "animal", 15000)]
    got = m.items(s)
    got[0]["price_cents"] = 1
    got[1]["id"] = "zzz"
    got[2].clear()
    expect(m.items(s), want, "items after mutating returned items")
    expect(m.get(s, "ant"), want[0], "get after mutating returned items")
    got = m.items(s)
    got.reverse()
    got.pop()
    got.append(item("dog", "Rex", "animal", 1))
    s = rt(s)
    expect(m.items(s), want, "items after mutating returned list")
    raises(KeyError, "get of item appended to returned list", m.get, s, "dog")


def case_states_are_independent(m, rt):
    """The state is made by new() and holds everything: two states share nothing."""
    a = shop(m, rt)
    b = rt(m.new())
    expect(m.items(b), [], "items of a new state while another has items")
    m.add(b, "cat", "Other", "product", 7)
    m.set_price(a, "cat", 8)
    a, b = rt(a), rt(b)
    expect(m.get(a, "cat"), item("cat", "Tom", "animal", 8), "first state")
    expect(m.items(b), [item("cat", "Other", "product", 7)], "second state")


def case_state_survives_json_round_trips(m, rt):
    """json.loads(json.dumps(state)) behaves as the state did, at every step."""
    def js(state):
        return json.loads(json.dumps(json.loads(json.dumps(state))))
    s = js(m.new())
    expect(m.items(s), [], "items of round-tripped new()")
    m.add(s, "cat", "Tom", "animal", 15000)
    s = js(s)
    m.add(s, "ant", "Farm", "product", 2500)
    s = js(s)
    raises(ValueError, "duplicate add after round trip", m.add, s, "cat", "Tom", "animal", 1)
    m.set_price(s, "cat", 16000)
    s = js(s)
    raises(KeyError, "get unknown after round trip", m.get, s, "bee")
    expect(m.items(s), [item("ant", "Farm", "product", 2500),
                        item("cat", "Tom", "animal", 16000)], "items after round trips")


def shop_with_number_like_ids(m, rt):
    """shop() plus items whose ids are the texts "7", "None", "True" and "1.5"."""
    s = shop(m, rt)
    for text in ["7", "None", "True", "1.5"]:
        m.add(s, text, "Item " + text, "product", 300)
    return rt(s)


def case_get_of_id_that_is_not_a_string_is_keyerror(m, rt):
    """get: an id that is not a string is unknown, so KeyError (never TypeError)."""
    s = shop_with_number_like_ids(m, rt)
    for bad in NOT_A_STRING_ID:
        refused(m, s, KeyError, ["cat", "ant", "bee", "7"], "get(%r)" % (bad,), m.get, bad)
    s = rt(m.new())
    for bad in NOT_A_STRING_ID:
        raises(KeyError, "get(%r) on empty state" % (bad,), m.get, s, bad)


def case_set_price_of_id_that_is_not_a_string_is_keyerror(m, rt):
    """set_price: an id that is not a string is unknown, so KeyError; nothing changes."""
    s = shop_with_number_like_ids(m, rt)
    for bad in NOT_A_STRING_ID:
        refused(m, s, KeyError, ["cat", "ant", "bee", "7", "None", "True", "1.5"],
                "set_price(%r, 100)" % (bad,), m.set_price, bad, 100)
        s = rt(s)
    s = rt(m.new())
    for bad in NOT_A_STRING_ID:
        refused(m, s, KeyError, ["cat"], "set_price(%r, 100) on empty state" % (bad,),
                m.set_price, bad, 100)


def case_add_refuses_price_of_an_int_subclass(m, rt):
    """add: a valid price is exactly an int; an instance of a subclass is ValueError."""
    s = shop(m, rt)
    for bad in SUBCLASS_PRICE:
        refused(m, s, ValueError, ["cat", "ant", "bee", "dog"],
                "add with price %s(%d)" % (type(bad).__name__, bad),
                m.add, "dog", "Rex", "animal", bad)
        s = rt(s)


def case_set_price_refuses_price_of_an_int_subclass(m, rt):
    """set_price: an instance of an int subclass is not a valid price: ValueError."""
    s = shop(m, rt)
    for bad in SUBCLASS_PRICE:
        refused(m, s, ValueError, ["cat", "ant", "bee"],
                "set_price to %s(%d)" % (type(bad).__name__, bad), m.set_price, "cat", bad)
        s = rt(s)
    expect(m.get(s, "cat"), item("cat", "Tom", "animal", 15000), "item after refusals")


def case_set_price_refuses_unknown_id_before_invalid_price(m, rt):
    """set_price with an unknown id AND an invalid price: KeyError, not ValueError."""
    s = shop(m, rt)
    for bad in NOT_PRICE + SUBCLASS_PRICE:
        refused(m, s, KeyError, ["cat", "ant", "bee", "dog"],
                "set_price of unknown id to invalid %r" % (bad,), m.set_price, "dog", bad)
        s = rt(s)
    for not_text in [None, 7]:
        refused(m, s, KeyError, ["cat", "ant", "bee"],
                "set_price(%r, -1)" % (not_text,), m.set_price, not_text, -1)
    s = rt(m.new())
    refused(m, s, KeyError, ["dog"], "set_price('dog', -1) on empty state",
            m.set_price, "dog", -1)


# ---------------------------------------------------------------- harness

MODES = ("plain", "json")


def cases():
    found = [(n, f) for n, f in globals().items() if n.startswith("case_") and callable(f)]
    return [("%s[%s]" % (n[5:], mode), f, mode) for mode in MODES for n, f in found]


def load(build):
    import importlib.util
    path = os.path.join(build, UNIT + ".py")
    spec = importlib.util.spec_from_file_location(UNIT, path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def child(build, out_path):
    """Runs in the subprocess: every case, one JSON line per start and per result."""
    out = open(out_path, "a")

    def emit(record):
        out.write(json.dumps(record) + "\n")
        out.flush()

    sys.stdout = sys.stderr = open(os.devnull, "w")
    for label, fn, mode in cases():
        emit({"start": label})
        rt = (lambda s: json.loads(json.dumps(s))) if mode == "json" else (lambda s: s)
        try:
            fn(load(build), rt)
            emit({"done": label, "ok": True})
        except Failed as err:
            emit({"done": label, "ok": False, "why": str(err)[:300]})
        except BaseException as err:
            why = "%s: %s" % (type(err).__name__, err)
            emit({"done": label, "ok": False, "why": "unexpected " + why[:300]})
    emit({"end": True})
    out.close()
    os._exit(0)


def imported_names(tree):
    """(line, module name) for every import, and for constant dynamic imports."""
    names = []
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            names += [(node.lineno, alias.name) for alias in node.names]
        elif isinstance(node, ast.ImportFrom):
            if node.level:
                names.append((node.lineno, "." * node.level + (node.module or "")))
            else:
                names.append((node.lineno, node.module))
                names += [(node.lineno, node.module + "." + a.name) for a in node.names]
        elif isinstance(node, ast.Call) and node.args:
            fn, arg = node.func, node.args[0]
            called = fn.id if isinstance(fn, ast.Name) else getattr(fn, "attr", "")
            if called in ("__import__", "import_module") and isinstance(arg, ast.Constant):
                if isinstance(arg.value, str):
                    names.append((node.lineno, arg.value))
    return names


def rules(path):
    """The rules of docs/petshop/unit.md rule 3 checkable on the file: failures."""
    fails = []
    try:
        with tokenize.open(path) as handle:
            text = handle.read()
        tree = ast.parse(text, filename=path)
    except (SyntaxError, UnicodeError, ValueError) as err:
        return ["rule_module_is_python: %s" % type(err).__name__]
    long_lines = [i for i, line in enumerate(text.splitlines(), 1) if len(line) > MAX_LINE]
    if long_lines:
        fails.append("rule_no_line_over_100_characters: line(s) %s" % long_lines[:5])
    stdlib = sys.stdlib_module_names
    for line, name in imported_names(tree):
        top = name.split(".")[0]
        if top not in stdlib:
            fails.append("rule_standard_library_only_no_other_unit: line %d imports %s"
                         % (line, name))
        elif top in NETWORK:
            fails.append("rule_no_network: line %d imports %s" % (line, name))
    return fails


def parent(build):
    path = os.path.join(build, UNIT + ".py")
    if not os.path.isfile(path):
        return ["module_present: no %s.py in %s" % (UNIT, build)], 0
    fails = rules(path)
    if fails and fails[0].startswith("rule_module_is_python"):
        return fails, 0
    labels = [label for label, _, _ in cases()]
    with tempfile.TemporaryDirectory() as tmp:
        out_path = os.path.join(tmp, "results.jsonl")
        env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
        cmd = [sys.executable, "-B", "-I", os.path.abspath(__file__), "--child",
               os.path.abspath(build), out_path]
        timed_out = False
        try:
            subprocess.run(cmd, cwd=tmp, env=env, timeout=TIMEOUT, stdin=subprocess.DEVNULL,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            timed_out = True
        records = []
        if os.path.isfile(out_path):
            with open(out_path) as handle:
                for line in handle:
                    try:
                        records.append(json.loads(line))
                    except ValueError:
                        pass
    done = {r["done"]: r for r in records if isinstance(r, dict) and "done" in r}
    started = [r["start"] for r in records if isinstance(r, dict) and "start" in r]
    for label in labels:
        if label in done:
            if done[label].get("ok") is not True:
                fails.append("%s: %s" % (label, done[label].get("why", "")))
        elif label in started:
            fails.append("%s: %s" % (label, "timed out" if timed_out else "process died"))
        else:
            fails.append("%s: not run" % label)
    return fails, len(labels)


def main(argv):
    if len(argv) == 4 and argv[1] == "--child":
        child(argv[2], argv[3])
    if len(argv) != 2:
        sys.stderr.write("usage: check <build-dir>\n")
        return 1
    if not hasattr(sys, "stdlib_module_names"):
        sys.stderr.write("FAIL harness_needs_python_3_10_or_later\n")
        return 1
    try:
        fails, count = parent(argv[1])
    except Exception as err:        # a fail, never a traceback of ours
        fails, count = ["harness: %s: %s" % (type(err).__name__, err)], 0
    if fails:
        for line in fails:
            sys.stderr.write("FAIL " + line + "\n")
        sys.stderr.write("%d failing of %d case runs\n" % (len(fails), count))
        return 1
    print("%s: %d case runs passed (%d cases, plain and json), rules kept"
          % (UNIT, count, count // len(MODES)))
    print(os.path.getsize(os.path.join(argv[1], UNIT + ".py")))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
