# Doc: "the module holds no state of its own" + round trip (the JSON text is made in another
# process and the state continues here).
@case
def no_module_state_across_processes(m):
    code = ("import importlib.util, json, sys\n"
            "spec = importlib.util.spec_from_file_location('customers', sys.argv[1])\n"
            "mod = importlib.util.module_from_spec(spec)\n"
            "sys.modules['customers'] = mod\n"
            "spec.loader.exec_module(mod)\n"
            "s = mod.new()\n"
            "for n in [' Ann ', 'Bob', 'Cy', 'Di', 'Ed', 'Flo', 'Gus', 'Hal', 'Ida', 'Jo']:\n"
            "    mod.register(s, n)\n"
            "sys.stdout.write('\\n@@STATE@@' + json.dumps(s) + '\\n')\n")
    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
    out = subprocess.run([sys.executable, "-B", "-c", code, os.path.join(BUILD, "customers.py")],
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=env,
                         timeout=TIMEOUT, universal_newlines=True).stdout
    lines = [ln for ln in out.splitlines() if ln.startswith("@@STATE@@")]
    check(lines, "the other process produced no state")
    s = json.loads(lines[-1][len("@@STATE@@"):])
    names = ["Ann", "Bob", "Cy", "Di", "Ed", "Flo", "Gus", "Hal", "Ida", "Jo"]
    is_found(m, s, "", list(zip(ids(10), names)))
    is_customer(m.get(s, "C10"), "C10", "Jo")
    is_id(m.register(s, "Kay"), "C11")
    is_found(m, s, "A", [("C1", "Ann"), ("C8", "Hal"), ("C9", "Ida"), ("C11", "Kay")])


# ----------------------------------------------------------------------------- runner

def _short(text, limit=300):
    text = " ".join(str(text).split())
    return text if len(text) <= limit else text[: limit - 3] + "..."


def child(name, build):
    global BUILD
    BUILD = build
    sys.dont_write_bytecode = True
    fn = dict(CASES)[name]
    sys.path.insert(0, build)
    try:
        fn(load())
        result = "PASS"
    except AssertionError as e:
        result = "FAIL " + _short(e)
    except BaseException as e:  # noqa: BLE001 - anything the build raises is a failed case
        result = "FAIL unexpected %s: %s" % (type(e).__name__, _short(e))
    sys.stdout.write("\n" + MARK + result + "\n")
    sys.stdout.flush()
    os._exit(0)


def run_case(name, build, workdir):
    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1", PYTHONIOENCODING="utf-8")
    cmd = [sys.executable, "-B", os.path.abspath(__file__), "--run-case", name, build]
    try:
        proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env,
                              cwd=workdir, timeout=TIMEOUT, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return "timeout after %d s" % TIMEOUT
    out = proc.stdout.decode("utf-8", "replace")
    marks = [ln for ln in out.splitlines() if ln.startswith(MARK)]
    if not marks:
        err = proc.stderr.decode("utf-8", "replace").strip().splitlines()
        return "no result (exit %s) %s" % (proc.returncode, _short(err[-1] if err else ""))
    res = marks[-1][len(MARK):]
    return None if res == "PASS" else (res[5:] or "failed")


def main(argv):
    if len(argv) == 4 and argv[1] == "--run-case":
        child(argv[2], argv[3])
    if len(argv) != 2:
        sys.stderr.write("usage: check <build-dir>\n")
        return 2
    build = os.path.abspath(argv[1])
    path = os.path.join(build, "customers.py")
    results = []
    for name, fn in STATIC:
        try:
            fn(path)
            results.append((name, None))
        except AssertionError as e:
            results.append((name, _short(e)))
        except Exception as e:  # noqa: BLE001
            results.append((name, "%s: %s" % (type(e).__name__, _short(e))))
    with tempfile.TemporaryDirectory() as workdir:
        for name, _ in CASES:
            if not os.path.isfile(path):
                results.append((name, "no customers.py in the build dir"))
            else:
                results.append((name, run_case(name, build, workdir)))
    passed = 0
    for name, reason in results:
        if reason is None:
            passed += 1
            print("PASS %s" % name)
        else:
            print("FAIL %s: %s" % (name, reason))
    print("%d/%d" % (passed, len(results)))
    return 0 if passed == len(results) else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
