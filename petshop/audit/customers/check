# ----------------------------------------------------------------------------- long sequence

def _model_run(m, seed, steps, m2=None):
    """Drive the module against a plain model; round trips and refusals mixed in."""
    rnd = random.Random(seed)
    pool = ["Ann", "ann", "ANNA", "Bob", "bobby", "Cy Lee", "Di-Ann", "Ed", "O'Bo", "nan",
            "Lee Ann", "x", "Xavier", "be", "B", "Cyd"]
    pads = ["", " ", "  ", "\t", "\n", " \r\n"]
    texts = ["", "a", "A", "an", "ANN", "b", "BO", "ee", " ", "x", "y l", "-", "'", "n",
             "c1", "1", "zz", "D", "e a", "nn"]
    bad_names = [None, "", " ", "\t\n", 0, 3, 2.5, True, ["Ann"], {"a": 1}, b"Ann"]
    model = []
    s = m.new()
    mods = [m] if m2 is None else [m, m2]
    for step in range(steps):
        mod = mods[step % len(mods)]
        op = rnd.random()
        what = "step %d" % step
        if op < 0.30:
            name = rnd.choice(pool)
            got = mod.register(s, rnd.choice(pads) + name + rnd.choice(pads))
            is_id(got, "C%d" % (len(model) + 1), what + " register")
            model.append(name)
        elif op < 0.40:
            raises(ValueError, mod.register, s, rnd.choice(bad_names))
        elif op < 0.55 and model:
            i = rnd.randrange(len(model))
            got = mod.get(s, "C%d" % (i + 1))
            is_customer(got, "C%d" % (i + 1), model[i], what + " get")
            if rnd.random() < 0.3:
                got["name"] = "changed"
        elif op < 0.65:
            cid = rnd.choice(["C%d" % (len(model) + 1), "C0", "c1", "", "C01", "C999", "x"])
            raises(KeyError, mod.get, s, cid)
        elif op < 0.90:
            text = rnd.choice(texts)
            want = [{"id": "C%d" % (i + 1), "name": n} for i, n in enumerate(model)
                    if text.lower() in n.lower()]
            res = mod.find(s, text)
            check(res is not None and not isinstance(res, (dict, str, bytes)),
                  "%s find(%r) returned %r" % (what, text, res))
            got = list(res)
            eq(got, want, what + " find(%r)" % text)
            if got and rnd.random() < 0.3:
                got[0]["name"] = "changed"
        else:
            s = rt(s)
    want = [{"id": "C%d" % (i + 1), "name": n} for i, n in enumerate(model)]
    eq(list(mod.find(s, "")), want, "final find all")
    check(len(model) > 9, "sequence too short")


