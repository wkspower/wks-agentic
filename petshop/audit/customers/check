#!/usr/bin/env python3
"""Audit cases for the unit `customers` (customers.py), written from docs/customers.md alone.

Usage: check <build-dir>      (the build dir holds customers.py)

Prints one line per case, `PASS <case>` or `FAIL <case>: <reason>`, then `<passed>/<total>`.
Exit status 0 only if every case passes.  Each behavioural case runs in its own subprocess
(timeout, no bytecode written, nothing written into the build dir).
"""
import ast
import importlib.util
import json
import os
import random
import subprocess
import sys
import tempfile

TIMEOUT = 30
MARK = "@@AUDIT-RESULT@@ "
CASES = []          # (name, function) in order; function takes the loaded module
STATIC = []         # (name, function) taking the path of customers.py
BUILD = None        # set in the child


def case(fn):
    CASES.append((fn.__name__, fn))
    return fn


def static(fn):
    STATIC.append((fn.__name__, fn))
    return fn


# ----------------------------------------------------------------------------- helpers

def load(alias="customers"):
    """Load a fresh instance of the build's customers.py under the given module name."""
    path = os.path.join(BUILD, "customers.py")
    spec = importlib.util.spec_from_file_location(alias, path)
    mod = importlib.util.module_from_spec(spec)
    sys.modules[alias] = mod
    spec.loader.exec_module(mod)
    return mod


def rt(state):
    return json.loads(json.dumps(state))


def check(cond, msg):
    if not cond:
        raise AssertionError(msg)


def eq(got, want, what):
    check(got == want, "%s: got %r, want %r" % (what, got, want))


def is_id(got, want, what="register"):
    check(isinstance(got, str), "%s returned %r, want the string %r" % (what, got, want))
    eq(got, want, what + " returned id")


def is_customer(got, cid, name, what="customer"):
    check(isinstance(got, dict), "%s is %r, want a dict" % (what, got))
    eq(sorted(got.keys(), key=repr), ["id", "name"], what + " keys")
    check(isinstance(got["id"], str) and isinstance(got["name"], str),
          "%s has non-string values: %r" % (what, got))
    eq(got, {"id": cid, "name": name}, what)


def found(m, state, text):
    """find() result as a list (the document does not name the container type)."""
    res = m.find(state, text)
    check(res is not None and not isinstance(res, (dict, str, bytes)),
          "find(%r) returned %r, want the customers in order" % (text, res))
    return list(res)


def is_found(m, state, text, pairs):
    got = found(m, state, text)
    want = [{"id": i, "name": n} for i, n in pairs]
    eq(got, want, "find(%r)" % (text,))
    for c, (i, n) in zip(got, pairs):
        is_customer(c, i, n, "find(%r) item" % (text,))


def raises(exc, fn, *args):
    try:
        res = fn(*args)
    except exc:
        return
    except Exception as e:  # noqa: BLE001 - the wrong class is the finding
        raise AssertionError("%s%r raised %s, want %s"
                             % (fn.__name__, args[1:], type(e).__name__, exc.__name__))
    raise AssertionError("%s%r returned %r, want %s" % (fn.__name__, args[1:], res, exc.__name__))


def fill(m, state, names):
    return [m.register(state, n) for n in names]


def ids(n):
    return ["C%d" % i for i in range(1, n + 1)]


# ----------------------------------------------------------------------------- static cases

# Rule 3 (petshop): "no line longer than 100 characters".
@static
def static_no_line_over_100(path):
    with open(path, "rb") as f:
        text = f.read().decode("utf-8")
    for no, line in enumerate(text.splitlines(), 1):
        check(len(line) <= 100, "line %d has %d characters" % (no, len(line)))


def _stdlib_names():
    names = getattr(sys, "stdlib_module_names", None)
    if names is not None:
        return set(names)
    import sysconfig  # fallback for Python < 3.10
    std = sysconfig.get_paths()["stdlib"]
    found_names = set(sys.builtin_module_names)
    for root in (std, os.path.join(std, "lib-dynload")):
        if os.path.isdir(root):
            for entry in os.listdir(root):
                found_names.add(entry.split(".")[0])
    return found_names


# Rule 3 (petshop): "Python 3 standard library only ... a unit's module imports no other
# unit's module."
@static
def static_imports_stdlib_only(path):
    with open(path, "rb") as f:
        tree = ast.parse(f.read(), filename="customers.py")
    std = _stdlib_names()
    bad = []
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            mods = [a.name for a in node.names]
        elif isinstance(node, ast.ImportFrom):
            mods = ["." * node.level + (node.module or "")] if node.level else [node.module]
        elif (isinstance(node, ast.Call) and node.args
              and isinstance(node.args[0], ast.Constant)
              and isinstance(node.args[0].value, str)
              and ((isinstance(node.func, ast.Name) and node.func.id == "__import__")
                   or (isinstance(node.func, ast.Attribute)
                       and node.func.attr == "import_module"))):
            mods = [node.args[0].value]
        else:
            continue
        for mod in mods:
            if mod.startswith(".") or mod.split(".")[0] not in std:
                bad.append("%s (line %d)" % (mod, node.lineno))
    check(not bad, "not standard library: " + ", ".join(bad))


