def _refusal_case(label, bad):
    def fn(m):
        s = m.new()
        raises(ValueError, m.register, s, bad)                 # refused on an empty state
        eq(found(m, s, ""), [], "find all after refused register on empty state")
        is_id(m.register(s, "Ann"), "C1")                      # the refusal consumed no id
        raises(ValueError, m.register, s, bad)
        raises(ValueError, m.register, s, bad)
        is_found(m, s, "", [("C1", "Ann")])
        raises(KeyError, m.get, s, "C2")
        is_id(m.register(s, "Bob"), "C2")
        is_found(m, s, "", [("C1", "Ann"), ("C2", "Bob")])
    fn.__name__ = "register_refuses_" + label
    return fn


