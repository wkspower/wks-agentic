    check(c.add(s, "a", "A", "animal", 5) is None, "add returned non-None")
    check(c.add(s, "b", "B", "product", 0) is None, "add returned non-None")


@case("add_then_get_exact_item", "Doc: An item is a dict with exactly `id`, `name`, `kind`, "
