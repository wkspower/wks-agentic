@case("add_price_zero_valid", "Doc: A valid price is an `int` (not a `bool`) of 0 or more.")
def _(c):
    s = c.new()
    c.add(s, "free", "Free leaflet", "product", 0)
    same_item(c.get(s, "free"), item("free", "Free leaflet", "product", 0))
    same_items(c.items(s), [item("free", "Free leaflet", "product", 0)])


@case("add_large_int_price", "Doc: A valid price is an `int` (not a `bool`) of 0 or more "
      "(no upper bound stated).")
def _(c):
    s = c.new()
    c.add(s, "a", "A", "animal", 10 ** 30)
    c.add(s, "b", "B", "product", 2 ** 63)
    c.add(s, "c", "C", "product", 2 ** 53 + 1)
    exp = [item("a", "A", "animal", 10 ** 30), item("b", "B", "product", 2 ** 63),
           item("c", "C", "product", 2 ** 53 + 1)]
    same_items(c.items(s), exp)
    s = rt(s)
    same_items(c.items(s), exp)
    c.set_price(s, "c", 10 ** 40 + 7)
    same_item(c.get(s, "c"), item("c", "C", "product", 10 ** 40 + 7))


@case("add_odd_but_valid_strings", "Doc: ValueError only when `item_id` or `name` is not a "
      "non-empty string; any non-empty string is accepted and returned as given.")
def _(c):
    ids = [" ", " a", "a ", "A", "a", "id", "name", "kind", "price_cents", "items",
           "__class__", "0", "None", "a\nb", 'q"uote', "back\\slash", "caf\xe9",
           "\u72ac", "x" * 500, "a.b", "a/b", "\t"]
    s = c.new()
    exp = []
    for n, i in enumerate(ids):
        nm = " " if n == 0 else "  %s  " % i
        k = "animal" if n % 2 else "product"
        c.add(s, i, nm, k, n)
        exp.append(item(i, nm, k, n))
    for e in exp:
        same_item(c.get(s, e["id"]), e)
    check(len(c.items(s)) == len(ids), "items() has %d, expected %d"
          % (len(c.items(s)), len(ids)))
    s2 = rt(s)
    for e in exp:
        same_item(c.get(s2, e["id"]), e, "after round trip")


@case("add_same_name_different_ids", "Doc: only an existing *id* refuses an add; names may repeat.")
def _(c):
