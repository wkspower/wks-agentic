@case("round_trip_empty_state", "Doc: the state ... survives `json.loads(json.dumps(state))` "
      "unchanged in behaviour.")
def _(c):
    s = rt(c.new())
    same_items(c.items(s), [])
    raises(KeyError, c.get, s, "a")
    raises(KeyError, c.set_price, s, "a", 1)
    check(c.add(s, "a", "A", "animal", 1) is None, "add returned non-None")
    same_items(c.items(s), [item("a", "A", "animal", 1)])


@case("round_trip_mid_use_then_continue", "Doc: the state ... survives "
      "`json.loads(json.dumps(state))` unchanged in behaviour.")
def _(c):
    s, exp = basic(c)
    c.set_price(s, "ball", 300)
    exp[0]["price_cents"] = 300
    s = rt(s)
    same_items(c.items(s), exp, "items() after round trip")
    same_item(c.get(s, "cat"), exp[1], "get after round trip")
    check(c.add(s, "ant", "Ant", "animal", 0) is None, "add returned non-None")
    check(c.set_price(s, "cat", 1) is None, "set_price returned non-None")
    raises(KeyError, c.get, s, "dog")
    raises(KeyError, c.set_price, s, "dog", 1)
    raises(ValueError, c.set_price, s, "cat", True)
    raises(ValueError, c.set_price, s, "cat", 1.0)
    raises(ValueError, c.add, s, "ant", "Ant2", "animal", 1)
    same_items(c.items(s), [item("ant", "Ant", "animal", 0),
                            item("ball", "Rubber ball", "product", 300),
                            item("cat", "Tabby cat", "animal", 1)])


@case("round_trip_repeated", "Doc: the state ... survives `json.loads(json.dumps(state))` "
      "unchanged in behaviour (each time).")
def _(c):
    s = c.new()
    exp = []
    for n in range(12):
        s = rt(s)
        i = "id%02d" % (11 - n)
        c.add(s, i, "N%d" % n, "animal" if n % 2 else "product", n)
        exp.append(item(i, "N%d" % n, "animal" if n % 2 else "product", n))
        s = rt(rt(s))
        c.set_price(s, i, n * 10)
        exp[-1]["price_cents"] = n * 10
        same_items(c.items(s), sorted(exp, key=lambda e: e["id"]))


