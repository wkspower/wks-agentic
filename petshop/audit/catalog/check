def _(c):
    s, exp = basic(c)
    refused(c, ValueError, s, exp, c.add, "dog", "Dog", "animal", -1)
    refused(c, ValueError, s, exp, c.add, "dog", "Dog", "dog", 1)
    refused(c, ValueError, s, exp, c.add, "dog", "", "animal", 1)
    refused(c, ValueError, s, exp, c.add, "cat", "Dog", "animal", 1)
    refused(c, KeyError, s, exp, c.set_price, "dog", 1)
    refused(c, ValueError, s, exp, c.set_price, "cat", -1)
