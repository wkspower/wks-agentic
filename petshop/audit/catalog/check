#!/usr/bin/env python3
"""Audit cases for catalog.py, written from docs/catalog.md alone.

Usage: check <build-dir>      (the build dir holds catalog.py)

Each case runs in its own subprocess with a timeout. Nothing is written
into the build dir. One line per case is printed (PASS/FAIL), then
<passed>/<total>. Exit 0 if all pass, else 1.

"Doc" below is docs/catalog.md, declaration 2 (Interface) unless said
otherwise; "Rule 3" is docs/petshop-rule-3.md.
"""
import ast
import decimal
import fractions
import importlib.util
import json
import os
import subprocess
import sys
import tempfile

TIMEOUT = 20
CASES = []  # (name, basis, function)


def case(name, basis):
    def deco(fn):
        CASES.append((name, basis, fn))
        return fn
    return deco


class Fail(Exception):
    pass


def check(cond, msg):
    if not cond:
        raise Fail(msg)


def short(x, n=70):
    r = repr(x)
    return r if len(r) <= n else r[:n] + "..."


BUILD = None
_counter = [0]


def load():
    """Load a fresh, separate instance of the build's catalog module."""
    _counter[0] += 1
    path = os.path.join(BUILD, "catalog.py")
    name = "catalog" if _counter[0] == 1 else "catalog_%d" % _counter[0]
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    if _counter[0] == 1:
        sys.modules["catalog"] = mod
    spec.loader.exec_module(mod)
    return mod


def rt(state):
    return json.loads(json.dumps(state))


def item(i, n, k, p):
    return {"id": i, "name": n, "kind": k, "price_cents": p}


def same_item(got, exp, what="item"):
    """Exact dict, exact key set, exact value types (no bool/float price)."""
    check(isinstance(got, dict), "%s is not a dict: %s" % (what, short(got)))
    check(set(got.keys()) == {"id", "name", "kind", "price_cents"},
          "%s keys are %s" % (what, short(sorted(map(str, got.keys())))))
    for k in ("id", "name", "kind"):
        check(type(got[k]) is str, "%s[%r] is %s" % (what, k, type(got[k]).__name__))
    check(type(got["price_cents"]) is int,
          "%s price_cents is %s" % (what, type(got["price_cents"]).__name__))
    check(got == exp, "%s is %s, expected %s" % (what, short(got), short(exp)))


def same_items(got, exp, what="items()"):
    check(isinstance(got, list), "%s is not a list: %s" % (what, short(got)))
    check(len(got) == len(exp), "%s has %d items, expected %d: %s"
          % (what, len(got), len(exp), short(got)))
    check([g.get("id") if isinstance(g, dict) else g for g in got]
          == [e["id"] for e in exp],
          "%s order/ids %s, expected %s" % (what, short([
              g.get("id") if isinstance(g, dict) else g for g in got]),
              short([e["id"] for e in exp])))
    for g, e in zip(got, exp):
        same_item(g, e, "%s entry %r" % (what, e["id"]))


def raises(exc, fn, *args):
    """fn(*args) must raise exc (ValueError or KeyError)."""
    try:
        r = fn(*args)
    except exc:
        return
    except Exception as e:
        raise Fail("expected %s, got %s: %s"
                   % (exc.__name__, type(e).__name__, short(str(e), 50)))
    raise Fail("expected %s, nothing raised (returned %s)" % (exc.__name__, short(r)))


def refused(c, exc, state, expected, fn, *args):
    """A refused call: right exception, and the state is left as it was."""
    snap = rt(state)
    raises(exc, fn, state, *args)
    check(rt(state) == snap, "refused call changed the state")
    same_items(c.items(state), expected, "items() after refused call")
    for e in expected:
        same_item(c.get(state, e["id"]), e, "get(%r) after refused call" % e["id"])


def basic(c):
    s = c.new()
    c.add(s, "cat", "Tabby cat", "animal", 12000)
    c.add(s, "ball", "Rubber ball", "product", 250)
    exp = [item("ball", "Rubber ball", "product", 250),
           item("cat", "Tabby cat", "animal", 12000)]
    return s, exp


# --------------------------------------------------------------- new / add / get

@case("new_is_empty", "Doc: `new()` returns an empty state.")
def _(c):
    s = c.new()
    same_items(c.items(s), [])


@case("new_empty_get_keyerror", "Doc: `new()` returns an empty state; get: `KeyError` when "
      "unknown.")
def _(c):
    s = c.new()
    raises(KeyError, c.get, s, "cat")
    same_items(c.items(s), [])


@case("new_states_independent", "Doc: the state is made only by `new()`; principle 1: the module "
      "holds no state of its own.")
def _(c):
    a = c.new()
    b = c.new()
    c.add(a, "x", "X", "animal", 1)
    same_items(c.items(b), [])
    raises(KeyError, c.get, b, "x")
    c.add(b, "x", "Other", "product", 2)  # same id is free in the other state
    c.add(b, "y", "Y", "product", 3)
    same_items(c.items(a), [item("x", "X", "animal", 1)])
    same_items(c.items(b), [item("x", "Other", "product", 2), item("y", "Y", "product", 3)])
    c.set_price(a, "x", 9)
    same_item(c.get(b, "x"), item("x", "Other", "product", 2))
    same_items(c.items(c.new()), [])


@case("add_returns_none", "Doc: `add(...)` returns `None`.")
def _(c):
