@case("state_works_in_fresh_module_instance", "Doc: principle 1: the module holds no state of its "
      "own; the state survives the JSON round trip unchanged in behaviour.")
def _(c):
    s, exp = basic(c)
    text = json.dumps(s)
    d = load()  # a second, separate instance of the module
    same_items(d.items(json.loads(text)), exp, "items() in a fresh module instance")
    same_items(d.items(s), exp, "items() of the same state in a fresh module instance")
    same_items(d.items(d.new()), [], "new() in a fresh module instance")
    s2 = json.loads(text)
    raises(ValueError, d.add, s2, "cat", "Again", "animal", 1)
    d.add(s2, "dog", "Dog", "animal", 5)
    d.set_price(s2, "cat", 3)
    same_items(c.items(json.loads(json.dumps(s2))),
               [exp[0], item("cat", "Tabby cat", "animal", 3), item("dog", "Dog", "animal", 5)])
    same_items(c.items(s), exp, "original state")


