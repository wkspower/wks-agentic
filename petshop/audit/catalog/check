def _mk_bad_string(label, bad):
    # Doc: add: `ValueError` when `item_id` or `name` is not a non-empty string.
    @case("add_refuses_id_" + label, "Doc: add: `ValueError` when `item_id` ... is not a non-empty "
          "string; a refused call changes nothing.")
    def _(c):
        s, exp = basic(c)
        refused(c, ValueError, s, exp, c.add, bad, "Name", "animal", 100)
        e = c.new()
        refused(c, ValueError, e, [], c.add, bad, "Name", "product", 0)

    @case("add_refuses_name_" + label, "Doc: add: `ValueError` when ... `name` is not a non-empty "
          "string; a refused call changes nothing.")
    def _(c):
        s, exp = basic(c)
        refused(c, ValueError, s, exp, c.add, "new", bad, "animal", 100)
        raises(KeyError, c.get, s, "new")
        e = c.new()
        refused(c, ValueError, e, [], c.add, "new", bad, "product", 0)
        c.add(s, "new", "New", "animal", 7)  # the id is still free
        same_item(c.get(s, "new"), item("new", "New", "animal", 7))


for _l, _b in BAD_STRINGS:
    _mk_bad_string(_l, _b)


