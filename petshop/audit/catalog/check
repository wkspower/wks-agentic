# --------------------------------------------------------------- copies

@case("get_returns_copy_mutation", "Doc: returned items are copies.")
def _(c):
    s, exp = basic(c)
    g = c.get(s, "cat")
    g["price_cents"] = 1
    g["name"] = "HACKED"
    g["kind"] = "product"
    g["id"] = "dog"
    g["extra"] = True
    same_item(c.get(s, "cat"), exp[1], "get after mutating a returned item")
    same_items(c.items(s), exp, "items() after mutating a returned item")
    raises(KeyError, c.get, s, "dog")
    g2 = c.get(s, "ball")
    g2.clear()
    same_item(c.get(s, "ball"), exp[0], "get after clearing a returned item")
    same_items(c.items(s), exp)


@case("items_returns_copies_mutation", "Doc: returned items are copies.")
def _(c):
    s, exp = basic(c)
    lst = c.items(s)
    lst[0]["price_cents"] = -5
    lst[0]["name"] = "HACKED"
    lst[1]["id"] = "zzz"
    del lst[1]["kind"]
    same_items(c.items(s), exp, "items() after mutating returned items")
    same_item(c.get(s, "ball"), exp[0])
    same_item(c.get(s, "cat"), exp[1])
    raises(KeyError, c.get, s, "zzz")


@case("items_list_mutation_harmless", "Doc: `items(state)` returns all items as a list; returned "
      "items are copies.")
def _(c):
    s, exp = basic(c)
    lst = c.items(s)
    lst.clear()
    same_items(c.items(s), exp, "items() after clearing the returned list")
    lst = c.items(s)
    lst.append(item("zzz", "Z", "animal", 1))
    lst.reverse()
    lst.pop()
    same_items(c.items(s), exp, "items() after editing the returned list")
    raises(KeyError, c.get, s, "zzz")
    same_item(c.get(s, "cat"), exp[1])
    c.add(s, "ant", "Ant", "animal", 3)
    same_items(c.items(s), [item("ant", "Ant", "animal", 3)] + exp)


@case("returned_copy_survives_later_changes", "Doc: returned items are copies (a copy does not "
      "follow later changes of the state).")
def _(c):
    s, exp = basic(c)
    g = c.get(s, "cat")
    lst = c.items(s)
    c.set_price(s, "cat", 1)
    c.set_price(s, "ball", 2)
    c.add(s, "ant", "Ant", "animal", 3)
    same_item(g, exp[1], "item returned before set_price")
    same_items(lst, exp, "list returned before the changes")


@case("copies_after_round_trip", "Doc: returned items are copies; state survives the JSON round "
      "trip unchanged in behaviour.")
def _(c):
    s, exp = basic(c)
    s = rt(s)
    g = c.get(s, "cat")
    g["price_cents"] = 1
    lst = c.items(s)
    lst[0]["name"] = "HACKED"
    lst.clear()
    same_items(c.items(s), exp)
    same_item(c.get(s, "cat"), exp[1])


