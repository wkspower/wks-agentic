# --------------------------------------------------------------- inherited rules (static)

def _source():
    with open(os.path.join(BUILD, "catalog.py"), encoding="utf-8") as f:
        return f.read()


@case("rule_no_line_over_100_chars", "Rule 3: no line longer than 100 characters.")
def _(c):
    for n, line in enumerate(_source().splitlines(), 1):
        check(len(line) <= 100, "line %d has %d characters" % (n, len(line)))


@case("rule_imports_standard_library_only", "Rule 3: Python 3 standard library only; a unit's "
      "module imports no other unit's module.")
def _(c):
    std = getattr(sys, "stdlib_module_names", None)
    if std is None:
        return  # cannot tell on this interpreter; do not guess
    for node in ast.walk(ast.parse(_source())):
        names = []
        if isinstance(node, ast.Import):
            names = [a.name for a in node.names]
        elif isinstance(node, ast.ImportFrom):
            check(node.level == 0, "relative import on line %d" % node.lineno)
            names = [node.module or ""]
        for nm in names:
            check(nm.split(".")[0] in std, "imports %r (not standard library)" % nm)


# --------------------------------------------------------------- runner

def run_one(name, build):
    global BUILD
    BUILD = os.path.abspath(build)
    sys.dont_write_bytecode = True
    sys.path.insert(0, BUILD)
    fn = dict((n, f) for n, _b, f in CASES)[name]
    try:
        mod = load()
        fn(mod)
    except Fail as e:
        reason = str(e)
    except BaseException as e:  # noqa: any other failure of the build is a failed case
        reason = "%s: %s" % (type(e).__name__, str(e))
    else:
        sys.stderr.write("\n@@AUDIT-OK@@\n")
        sys.stderr.flush()
        os._exit(0)
    sys.stderr.write("\n@@AUDIT-FAIL@@ " + " ".join(reason.split())[:200] + "\n")
    sys.stderr.flush()
    os._exit(1)


def main(argv):
    if len(argv) == 4 and argv[1] == "--run-case":
        run_one(argv[2], argv[3])
        return 2
    if len(argv) != 2:
        sys.stderr.write("usage: check <build-dir>\n")
        return 2
    build = os.path.abspath(argv[1])
    env = dict(os.environ)
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    env.pop("PYTHONPATH", None)
    me = os.path.abspath(__file__)
    passed = 0
    with tempfile.TemporaryDirectory() as cwd:
        for name, _basis, _fn in CASES:
            reason = None
            try:
                p = subprocess.run(
                    [sys.executable, "-B", me, "--run-case", name, build],
                    stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                    stderr=subprocess.PIPE, cwd=cwd, env=env, timeout=TIMEOUT)
                err = p.stderr.decode("utf-8", "replace")
                lines = [ln for ln in err.splitlines() if ln.startswith("@@AUDIT-")]
                if p.returncode == 0 and lines and lines[-1].startswith("@@AUDIT-OK@@"):
                    pass
                elif lines and lines[-1].startswith("@@AUDIT-FAIL@@"):
                    reason = lines[-1][len("@@AUDIT-FAIL@@"):].strip() or "failed"
                else:
                    reason = "case process ended abnormally (exit %s)" % p.returncode
            except subprocess.TimeoutExpired:
                reason = "timeout after %ds" % TIMEOUT
            except Exception as e:
                reason = "could not run case: %s" % type(e).__name__
            if reason is None:
                passed += 1
                print("PASS %s" % name)
            else:
                print("FAIL %s: %s" % (name, reason))
            sys.stdout.flush()
    print("%d/%d" % (passed, len(CASES)))
    return 0 if passed == len(CASES) else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
