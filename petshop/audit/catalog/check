    c.add(s, "cat", "Tabby cat", "animal", 12000)
    same_item(c.get(s, "cat"), item("cat", "Tabby cat", "animal", 12000))
    c.add(s, "ball", "Rubber ball", "product", 250)
    same_item(c.get(s, "ball"), item("ball", "Rubber ball", "product", 250))
    same_item(c.get(s, "cat"), item("cat", "Tabby cat", "animal", 12000))


@case("add_both_kinds", "Doc: `kind` is `\"animal\"` or `\"product\"`.")
def _(c):
    s = c.new()
    c.add(s, "1", "n", "product", 1)
    c.add(s, "2", "n", "animal", 1)
