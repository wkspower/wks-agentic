                            item("b", "Same", "animal", 1)])


@case("ids_case_and_space_sensitive", "Doc: ValueError when the id already exists; get: KeyError "
      "when unknown (ids are strings, compared as given).")
def _(c):
    s = c.new()
    c.add(s, "cat", "lower", "animal", 1)
    c.add(s, "Cat", "upper", "animal", 2)
    c.add(s, "cat ", "space", "animal", 3)
    same_item(c.get(s, "cat"), item("cat", "lower", "animal", 1))
    same_item(c.get(s, "Cat"), item("Cat", "upper", "animal", 2))
    same_item(c.get(s, "cat "), item("cat ", "space", "animal", 3))
    raises(KeyError, c.get, s, "CAT")
    raises(KeyError, c.get, s, " cat")
    raises(KeyError, c.set_price, s, "CAT", 5)


