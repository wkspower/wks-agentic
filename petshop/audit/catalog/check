]


def _mk_bad_price(label, bad):
    # Doc: add: `ValueError` when ... the price is not valid. A valid price is an `int` (not a
    # `bool`) of 0 or more. A refused call changes nothing.
    @case("add_refuses_price_" + label, "Doc: add: `ValueError` when the price is not valid; a "
          "valid price is an `int` (not a `bool`) of 0 or more; a refused call changes nothing.")
    def _(c):
        s, exp = basic(c)
        refused(c, ValueError, s, exp, c.add, "new", "New", "product", bad)
        raises(KeyError, c.get, s, "new")
        e = c.new()
        refused(c, ValueError, e, [], c.add, "new", "New", "animal", bad)
        c.add(s, "new", "New", "product", 7)  # the id is still free
        same_item(c.get(s, "new"), item("new", "New", "product", 7))

    # Doc: set_price: `ValueError` when the price is not valid. A refused call changes nothing.
    @case("set_price_refuses_price_" + label, "Doc: set_price: `ValueError` when the price is not "
          "valid; a valid price is an `int` (not a `bool`) of 0 or more; a refused call changes "
          "nothing.")
    def _(c):
        s, exp = basic(c)
        refused(c, ValueError, s, exp, c.set_price, "cat", bad)
        refused(c, ValueError, s, exp, c.set_price, "ball", bad)
        s2 = c.new()
        c.add(s2, "one", "One", "animal", 1)
        c.add(s2, "zero", "Zero", "animal", 0)
        exp2 = [item("one", "One", "animal", 1), item("zero", "Zero", "animal", 0)]
        refused(c, ValueError, s2, exp2, c.set_price, "one", bad)   # True == 1, 1.0 == 1
        refused(c, ValueError, s2, exp2, c.set_price, "zero", bad)  # False == 0, 0.0 == 0
        c.set_price(s, "cat", 5)
        same_item(c.get(s, "cat"), item("cat", "Tabby cat", "animal", 5))


for _l, _b in BAD_PRICES:
    _mk_bad_price(_l, _b)


