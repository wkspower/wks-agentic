#!/usr/bin/env python3
"""Audit cases for the unit `stock` (stock.py), written from docs/stock.md alone.

Usage: check <build-dir>      (the build dir holds stock.py)

Prints one line per case, `PASS <case>` or `FAIL <case>: <reason>`, then
`<passed>/<total>`; exits 0 only if every case passes. Each behavioural case
runs in its own Python subprocess with a timeout; nothing is written into the
build dir. Standard library only.
"""
import ast
import importlib.util
import json
import os
import random
import subprocess
import sys
import tempfile
from decimal import Decimal
from fractions import Fraction

TIMEOUT = 30
MARK = "@@AUDIT-RESULT@@"
CASES = []          # (name, function) for behavioural cases, in order
STATIC = []         # (name, function(build_dir)) for static cases
BUILD = None        # set in the child process


def case(name):
    def deco(fn):
        CASES.append((name, fn))
        return fn
    return deco


def static(name):
    def deco(fn):
        STATIC.append((name, fn))
        return fn
    return deco


# ----------------------------------------------------------------- helpers

class Fail(Exception):
    pass


def check(cond, msg):
    if not cond:
        raise Fail(msg)


def load(alias="stock"):
    """Load a fresh, separate instance of the build's stock.py."""
    path = os.path.join(BUILD, "stock.py")
    spec = importlib.util.spec_from_file_location(alias, path)
    mod = importlib.util.module_from_spec(spec)
    sys.modules[alias] = mod
    spec.loader.exec_module(mod)
    return mod


def rt(state):
    """The round trip named in the document."""
    return json.loads(json.dumps(state))


def short(v):
    r = repr(v)
    return r if len(r) <= 60 else r[:57] + "..."


def is_int(v):
    return type(v) is int


def oh(m, s, item, want):
    """on_hand must be exactly an int (not bool/float) equal to `want`."""
    got = m.on_hand(s, item)
    check(is_int(got), "on_hand(%s) returned %s, not an int" % (short(item), short(got)))
    check(got == want, "on_hand(%s) is %s, expected %s" % (short(item), short(got), want))


def ret(got, want, what):
    """Return value of receive/remove: the quantity now on hand."""
    check(not isinstance(got, bool) and isinstance(got, (int, float)) and got == want,
          "%s returned %s, expected %s" % (what, short(got), want))


def refused(fn, *args):
    """The call must raise ValueError (the class stated in the document)."""
    what = "%s(state, %s)" % (fn.__name__, ", ".join(short(a) for a in args[1:]))
    try:
        got = fn(*args)
    except ValueError:
        return
    except Exception as e:  # any other class is the wrong exception
        raise Fail("%s raised %s, not ValueError" % (what, type(e).__name__))
    raise Fail("%s was not refused, returned %s" % (what, short(got)))


def stocked(m):
    """A state with a few items on hand, and what it should hold."""
    s = m.new()
    want = {"a": 10, "b": 3, "c": 1}
    for k, v in want.items():
        m.receive(s, k, v)
    return s, want


def same(m, s, want):
    for k, v in want.items():
        oh(m, s, k, v)


def bad_ids_hashable():
    return [None, 5, 0, 1.5, True, False, b"a", ("a",), frozenset(["a"]), object()]


def bad_ids_unhashable():
    return [["a"], [], {"a": 1}, {}, {"a"}, bytearray(b"a")]


def bad_quantities():
    return [0, -1, -5, -10 ** 30, True, False, 1.0, 2.0, 2.5, 0.0, -1.0,
            float("nan"), float("inf"), None, "1", "", "one", [1], [], (1,), {}, {1},
            b"1", 1 + 0j, Decimal(1), Fraction(1)]


# ------------------------------------------------------------ static cases

# Rule 3: "no line longer than 100 characters".
@static("static-no-line-over-100-characters")
def static_lines(build):
    with open(os.path.join(build, "stock.py"), "rb") as f:
        text = f.read().decode("utf-8")
    for n, line in enumerate(text.splitlines(), 1):
        check(len(line) <= 100, "line %d has %d characters" % (n, len(line)))


# Rule 3: "Python 3 standard library only ... a unit's module imports no other unit's module".
@static("static-imports-standard-library-only")
def static_imports(build):
    with open(os.path.join(build, "stock.py"), "rb") as f:
        tree = ast.parse(f.read())
    names = getattr(sys, "stdlib_module_names", None)
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            mods = [a.name for a in node.names]
        elif isinstance(node, ast.ImportFrom):
            check(node.level == 0, "relative import on line %d" % node.lineno)
            mods = [node.module]
        else:
            continue
        for mod in mods:
            top = mod.split(".")[0]
            if names is not None:
                ok = top in names
            else:  # old interpreter: accept what resolves outside the build dir
                spec = importlib.util.find_spec(top)
                origin = getattr(spec, "origin", None) or ""
                ok = spec is not None and "site-packages" not in origin \
                    and not origin.startswith(os.path.abspath(build))
            check(ok, "imports %s (line %d), not standard library" % (mod, node.lineno))


