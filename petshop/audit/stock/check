# ---------------------------------------------- refusals: quantity, receive

def recv_quantities(bads):
    m = load()
    s = m.new()
    for bad in bads:
        refused(m.receive, s, "a", bad)
        oh(m, s, "a", 0)
    s, want = stocked(m)
    for bad in bads:
        refused(m.receive, s, "a", bad)
        refused(m.receive, s, "new", bad)
        same(m, s, want)
        oh(m, s, "new", 0)
    s2 = rt(s)
    for bad in bads:
        refused(m.receive, s2, "a", bad)
    same(m, s2, want)
    ret(m.receive(s, "a", 1), 11, "valid receive after refusals")


