# "A module `stock.py`" with `new`, `on_hand`, `receive`, `remove`.
@case("interface-four-functions-present")
def c_interface():
    m = load()
    for name in ("new", "on_hand", "receive", "remove"):
        check(callable(getattr(m, name, None)), "no callable %s" % name)


# "`new()` returns an empty state." / "0 for an item never received."
@case("new-is-empty")
def c_new_empty():
    m = load()
    s = m.new()
    for item in ("a", "b", "x", " ", "0", "never"):
        oh(m, s, item, 0)


# "`on_hand(state, item_id)` returns the quantity as an `int`"
@case("on-hand-is-exactly-int")
def c_on_hand_int():
    m = load()
    s = m.new()
    oh(m, s, "a", 0)
    m.receive(s, "a", 1)
    oh(m, s, "a", 1)
    m.receive(s, "a", 41)
    oh(m, s, "a", 42)
    m.remove(s, "a", 2)
    oh(m, s, "a", 40)
    m.remove(s, "a", 40)
    oh(m, s, "a", 0)
    s2 = rt(s)
    oh(m, s2, "a", 0)
    m.receive(s2, "a", 7)
    oh(m, rt(s2), "a", 7)


# "`receive(state, item_id, quantity)` adds and returns the quantity now on hand."
@case("receive-adds-and-returns-total")
def c_receive():
    m = load()
    s = m.new()
    ret(m.receive(s, "a", 3), 3, "first receive")
    oh(m, s, "a", 3)
    ret(m.receive(s, "a", 4), 7, "second receive")
    oh(m, s, "a", 7)
    ret(m.receive(s, "a", 1), 8, "third receive")
    oh(m, s, "a", 8)
    ret(m.receive(s, "b", 1), 1, "receive of another item")
    oh(m, s, "a", 8)
    oh(m, s, "b", 1)


# "returns the quantity now on hand" - the quantity is an `int` (see on_hand).
@case("receive-returns-exactly-int")
def c_receive_int():
    m = load()
    s = m.new()
    for q, total in ((1, 1), (2, 3), (10 ** 20, 10 ** 20 + 3)):
        got = m.receive(s, "a", q)
        check(is_int(got) and got == total, "receive returned %s, expected int %d"
              % (short(got), total))
    got = m.receive(rt(s), "a", 1)
    check(is_int(got), "receive after round trip returned %s, not an int" % short(got))


# "`remove(state, item_id, quantity)` takes away and returns the quantity now on hand"
@case("remove-takes-away-and-returns-remaining")
def c_remove():
    m = load()
    s = m.new()
    m.receive(s, "a", 10)
    m.receive(s, "b", 5)
    ret(m.remove(s, "a", 3), 7, "remove 3 of 10")
    oh(m, s, "a", 7)
    ret(m.remove(s, "a", 1), 6, "remove 1 of 7")
    oh(m, s, "a", 6)
    oh(m, s, "b", 5)
    ret(m.remove(s, "b", 4), 1, "remove 4 of 5")
    oh(m, s, "a", 6)
    oh(m, s, "b", 1)


# "returns the quantity now on hand" - the quantity is an `int` (see on_hand).
@case("remove-returns-exactly-int")
def c_remove_int():
    m = load()
    s = m.new()
    m.receive(s, "a", 10)
    for q, left in ((1, 9), (4, 5), (5, 0)):
        got = m.remove(s, "a", q)
        check(is_int(got) and got == left, "remove returned %s, expected int %d"
              % (short(got), left))
    m.receive(s, "a", 2)
    got = m.remove(rt(s), "a", 2)
    check(is_int(got) and got == 0, "remove after round trip returned %s" % short(got))


# "`ValueError` when `quantity` exceeds what is on hand" - exactly what is there does not.
@case("remove-exactly-what-is-on-hand")
def c_remove_all():
    m = load()
    s = m.new()
    m.receive(s, "a", 5)
    m.receive(s, "b", 2)
    ret(m.remove(s, "a", 5), 0, "remove 5 of 5")
    oh(m, s, "a", 0)
    oh(m, s, "b", 2)
    refused(m.remove, s, "a", 1)
    oh(m, s, "a", 0)
    ret(m.receive(s, "a", 2), 2, "receive after emptying")
    ret(m.remove(s, "a", 1), 1, "remove 1 of 2")
    ret(m.remove(s, "a", 1), 0, "remove 1 of 1")
    oh(m, s, "a", 0)
    oh(m, s, "b", 2)
    ret(m.remove(s, "b", 2), 0, "remove 2 of 2")
    oh(m, s, "b", 0)


# "`ValueError` when `quantity` exceeds what is on hand." / "A refused call changes nothing."
@case("remove-one-more-than-on-hand-refused")
def c_remove_over():
    m = load()
    s, want = stocked(m)
    refused(m.remove, s, "a", 11)
    same(m, s, want)
    refused(m.remove, s, "c", 2)
    same(m, s, want)
    refused(m.remove, s, "b", 4)
    refused(m.remove, s, "b", 1000)
    same(m, s, want)
    ret(m.remove(s, "a", 10), 0, "remove 10 of 10 after refusals")
    ret(m.remove(s, "c", 1), 0, "remove 1 of 1 after refusals")
    ret(m.remove(s, "b", 3), 0, "remove 3 of 3 after refusals")


