    code = (
        "import importlib.util, json, sys\n"
        "spec = importlib.util.spec_from_file_location('stock', sys.argv[1])\n"
        "m = importlib.util.module_from_spec(spec)\n"
        "sys.modules['stock'] = m\n"
        "spec.loader.exec_module(m)\n"
        "s = json.loads(sys.stdin.read())\n"
        "out = [m.on_hand(s, 'a'), m.on_hand(s, 'b'), m.on_hand(s, 'c')]\n"
        "out.append(m.remove(s, 'a', 4))\n"
        "out.append(m.receive(s, 'c', 3))\n"
        "try:\n"
        "    m.remove(s, 'b', 1)\n"
        "    out.append('no refusal')\n"
        "except ValueError:\n"
        "    out.append('refused')\n"
        "print(%r + json.dumps([out, s]))\n" % MARK
    )
    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
    p = subprocess.run([sys.executable, "-B", "-c", code, os.path.join(BUILD, "stock.py")],
                       input=json.dumps(s), stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                       universal_newlines=True, timeout=TIMEOUT / 2, env=env)
    lines = [ln for ln in p.stdout.splitlines() if ln.startswith(MARK)]
    check(lines, "other process failed: %s" % short(p.stderr.strip().splitlines()[-1:]))
    out, s2 = json.loads(lines[-1][len(MARK):])
    check(out == [10, 0, 0, 6, 3, "refused"], "other process got %s" % short(out))
    same(m, s2, {"a": 6, "b": 0, "c": 3})
    same(m, s, {"a": 10, "b": 0, "c": 0})
    ret(m.remove(s2, "a", 6), 0, "remove on state returned from other process")


