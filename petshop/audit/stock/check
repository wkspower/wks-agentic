# ----------------------------------------------- refusals: quantity, remove

def rem_quantities(bads):
    m = load()
    s, want = stocked(m)
    for bad in bads:
        refused(m.remove, s, "a", bad)   # 10 on hand: only the quantity is at fault
        refused(m.remove, s, "c", bad)   # 1 on hand
        refused(m.remove, s, "none", bad)
        same(m, s, want)
        oh(m, s, "none", 0)
    s2 = rt(s)
