# ---------------------------------------------------- long mixed sequences

def sequence(seed, steps, with_rt, two_modules):
    """Every call checked against a plain model of the declared behaviour."""
    rng = random.Random(seed)
    mods = [load("stock")]
    if two_modules:
        mods.append(load("stock_second_instance"))
    ids = ["a", "b", "A", " ", "é", "10", "item-7", "x" * 200]
    states = [mods[0].new() for _ in range(3)]
    models = [{} for _ in range(3)]
    for step in range(steps):
        m = rng.choice(mods)
        k = rng.randrange(3)
        s, model = states[k], models[k]
        item = rng.choice(ids)
        have = model.get(item, 0)
        where = "step %d" % step
        roll = rng.random()
        if roll < 0.30:
            q = rng.choice([1, 1, 2, 3, 7, 50, 10 ** 12])
            model[item] = have + q
            ret(m.receive(s, item, q), have + q, where + " receive")
        elif roll < 0.55:
            if have == 0:
                refused(m.remove, s, item, rng.randint(1, 3))
            else:
                q = have if rng.random() < 0.3 else rng.randint(1, have)
                model[item] = have - q
                ret(m.remove(s, item, q), have - q, where + " remove")
        elif roll < 0.67:
            refused(m.remove, s, item, have + rng.choice([1, 1, 2, 100]))
        elif roll < 0.77:
            fn = rng.choice([m.receive, m.remove])
            refused(fn, s, item, rng.choice(bad_quantities()))
        elif roll < 0.85:
            fn = rng.choice([m.receive, m.remove])
            bad = rng.choice([""] + bad_ids_hashable() + bad_ids_unhashable())
            refused(fn, s, bad, rng.randint(1, 3))
        elif roll < 0.92 and with_rt:
            states[k] = rt(s)
        oh(m, states[k], item, model.get(item, 0))
        if step % 40 == 0 or step == steps - 1:
            for j in range(3):
                for i in ids:
                    oh(m, states[j], i, models[j].get(i, 0))


