# Purpose: "never fewer than none" - no sequence of removals goes below zero.
@case("never-fewer-than-none")
def c_never_negative():
    m = load()
    s = m.new()
    m.receive(s, "a", 3)
    ret(m.remove(s, "a", 2), 1, "remove 2 of 3")
    refused(m.remove, s, "a", 2)
    oh(m, s, "a", 1)
