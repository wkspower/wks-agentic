# "Item ids are data: any non-empty string" - different strings are different items.
@case("item-ids-distinct-strings-distinct-items")
def c_ids_distinct():
    m = load()
    s = m.new()
    ids = ["a", "A", " a", "a ", "a\n", "1", "01", "1.0", "1e0", "true", "True",
           "null", "None", "é", "é", "a/b", "a.b"]
    for n, item in enumerate(ids, 1):
        ret(m.receive(s, item, n), n, "receive(%s)" % short(item))
    for n, item in enumerate(ids, 1):
        oh(m, s, item, n)
    s2 = rt(s)
    for n, item in enumerate(ids, 1):
        oh(m, s2, item, n)
    for n, item in enumerate(ids, 1):
        ret(m.remove(s2, item, n), 0, "remove(%s)" % short(item))
        refused(m.remove, s2, item, 1)
    for n, item in enumerate(ids, 1):
        oh(m, s, item, n)


# "Item ids are data: any non-empty string, known to the catalog or not."
@case("item-ids-any-non-empty-string")
def c_ids_any():
    m = load()
    s = m.new()
    ids = [" ", "  ", "\t", "\n", "\x00", "0", "-1", "x" * 10000, "猫", "\U0001F431",
           'a"b', "a\\b", "a:b", "a,b", "a=b", "{}", "[]", "__class__", "__proto__",
           "items", "state", "quantity", "on_hand", "keys", "version", "stock"]
    for n, item in enumerate(ids, 2):
        refused(m.remove, s, item, 1)
        ret(m.receive(s, item, n), n, "receive(%s)" % short(item))
        oh(m, s, item, n)
    s = rt(s)
    for n, item in enumerate(ids, 2):
        oh(m, s, item, n)
        ret(m.remove(s, item, 1), n - 1, "remove(%s)" % short(item))
        refused(m.remove, s, item, n)
    for n, item in enumerate(ids, 2):
        oh(m, s, item, n - 1)
    oh(m, s, "unseen", 0)


# "Functions change the state they are given, in place."
@case("state-changed-in-place")
def c_in_place():
    m = load()
    s = m.new()
    alias = s
    r = m.receive(s, "a", 5)
    check(r is not s, "receive returned the state")
    oh(m, alias, "a", 5)
    check(alias is s, "state object replaced")
    r = m.remove(s, "a", 2)
    check(r is not s, "remove returned the state")
    oh(m, alias, "a", 3)

    def worker(state):
        m.receive(state, "b", 9)
        m.remove(state, "a", 3)
    worker(s)
    oh(m, s, "b", 9)
    oh(m, s, "a", 0)
    s2 = rt(s)
    alias2 = s2
    m.receive(s2, "a", 4)
    oh(m, alias2, "a", 4)
    oh(m, s, "a", 0)


# "`new()` returns an empty state." - each one its own; the module "holds no state".
@case("new-states-independent")
def c_new_independent():
    m = load()
    s1 = m.new()
    s2 = m.new()
    check(s1 is not s2, "new() returned the same object twice")
    m.receive(s1, "a", 5)
    oh(m, s2, "a", 0)
    refused(m.remove, s2, "a", 1)
    m.receive(s2, "a", 2)
    m.receive(s2, "b", 8)
    oh(m, s1, "a", 5)
    oh(m, s1, "b", 0)
    m.remove(s1, "a", 5)
    oh(m, s2, "a", 2)
    s3 = m.new()
    oh(m, s3, "a", 0)
    oh(m, s3, "b", 0)
    refused(m.remove, s3, "b", 1)
    oh(m, s2, "b", 8)


# "`new()` returns an empty state." - also after other states have been used.
@case("new-empty-after-other-states-used")
def c_new_after_use():
    m = load()
    for i in range(5):
        s = m.new()
        oh(m, s, "a", 0)
        oh(m, s, "k%d" % i, 0)
        ret(m.receive(s, "a", 3), 3, "receive on fresh state %d" % i)
        ret(m.receive(s, "k%d" % i, 1), 1, "receive on fresh state %d" % i)
        refused(m.receive, s, "a", 0)
        refused(m.remove, s, "a", 4)
    s = rt(m.new())
    oh(m, s, "a", 0)


