# ------------------------------------------------------------------ runner

def run_child(name, build):
    """Child process: run one behavioural case and report on the last line."""
    global BUILD
    BUILD = build
    sys.dont_write_bytecode = True
    fn = dict(CASES)[name]
    try:
        fn()
        result = "PASS"
    except Fail as e:
        result = "FAIL " + str(e)
    except BaseException as e:
        result = "FAIL %s: %s" % (type(e).__name__, e)
    sys.stdout.flush()
    sys.stdout.write("\n%s %s\n" % (MARK, " ".join(result.split())[:200]))
    sys.stdout.flush()
    os._exit(0)


def run_case(name, build, workdir):
    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
    cmd = [sys.executable, "-B", os.path.abspath(__file__), "--case", name, build]
    try:
        p = subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                           stderr=subprocess.PIPE, timeout=TIMEOUT, cwd=workdir, env=env)
    except subprocess.TimeoutExpired:
        return "timed out after %d s" % TIMEOUT
    out = p.stdout.decode("utf-8", "replace")
    for line in reversed(out.splitlines()):
        if line.startswith(MARK + " "):
            res = line[len(MARK) + 1:]
            if res == "PASS":
                return None
            if res.startswith("FAIL "):
                return res[5:]
            break
    return "case process ended without a result (exit %s)" % p.returncode


def main(argv):
    if len(argv) == 4 and argv[1] == "--case":
        run_child(argv[2], argv[3])
    if len(argv) != 2:
        print("usage: check <build-dir>", file=sys.stderr)
        return 2
    build = os.path.abspath(argv[1])
    results = []
    present = os.path.isfile(os.path.join(build, "stock.py"))
    for name, fn in STATIC:
        try:
            if not present:
                raise Fail("no stock.py in the build dir")
            fn(build)
            results.append((name, None))
        except Fail as e:
            results.append((name, str(e)))
        except Exception as e:
            results.append((name, "%s: %s" % (type(e).__name__, e)))
    with tempfile.TemporaryDirectory() as workdir:
        for name, _ in CASES:
            if not present:
                results.append((name, "no stock.py in the build dir"))
            else:
                results.append((name, run_case(name, build, workdir)))
    passed = 0
    for name, reason in results:
        if reason is None:
            passed += 1
            print("PASS %s" % name)
        else:
            print("FAIL %s: %s" % (name, " ".join(reason.split())[:200]))
    print("%d/%d" % (passed, len(results)))
    return 0 if passed == len(results) else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
