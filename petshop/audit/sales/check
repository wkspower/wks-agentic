# doc: principle 1 "the module holds no state of its own" (a state made and filled by one
# loaded instance of the module is served by another).
@case("module_holds_no_state_second_instance_serves_the_state")
def _():
    m1 = load()
    s = m1.new()
    shop = Shop()
    l1 = [("kibble", 1), ("kibble", 2)]
    e1 = expected("S1", "ann", l1)
    e2 = expected("S2", "bob", [("toy", 1)])
    sell_ok(m1, s, shop, "ann", l1)
    sell_ok(m1, s, shop, "bob", [("toy", 1)])
    m2 = load()
    ok(m2 is not m1, "module not loaded twice")
    check_state(m2, s, [e1, e2], "state seen by the second instance")
    e3 = expected("S3", "cat", [("bowl", 2)])
    check_sale(sell_ok(m2, s, shop, "cat", [("bowl", 2)]), e3)
    check_state(m1, s, [e1, e2, e3], "state seen by the first instance")
    s2 = roundtrip(s)
    m3 = load()
    e4 = expected("S4", "dan", [("leash", 1)])
    check_sale(sell_ok(m3, s2, shop, "dan", [("leash", 1)]), e4)
    check_state(m1, s2, [e1, e2, e3, e4], "round-tripped state")
    check_state(m3, s, [e1, e2, e3], "original state")


# doc: principle 1 "the module holds no state of its own" (nothing of earlier states leaks
# into a new state, in this instance or in another).
@case("module_holds_no_state_new_states_start_empty")
def _():
    m1 = load()
    shop = Shop()
    a = m1.new()
    sell_ok(m1, a, shop, "ann", [("kibble", 1)])
    sell_ok(m1, a, shop, "ann", [("toy", 1)])
    try:
        sell(m1, a, shop, "ann", [("toy", 99)])
    except ValueError:
        pass
    b = m1.new()
    check_state(m1, b, [], "new state in the same instance")
    eb = expected("S1", "bob", [("bowl", 1)])
    check_sale(sell_ok(m1, b, shop, "bob", [("bowl", 1)]), eb)
    m2 = load()
    c = m2.new()
    check_state(m2, c, [], "new state in a second instance")
    ec = expected("S1", "cat", [("leash", 1)])
    check_sale(sell_ok(m2, c, shop, "cat", [("leash", 1)]), ec)
    check_state(m1, c, [ec], "state of the second instance seen by the first")
    check_state(m2, b, [eb], "state of the first instance seen by the second")


# doc: principle 5 "A refused call leaves the state as it was" (a long mixed history).
@case("mixed_history_of_sales_and_refusals")
def _():
    m = load()
    s = m.new()
    shop = Shop(stock={"kibble": 6, "leash": 2, "bowl": 3, "toy": 4})
    shop.stock["ghost"] = 9
    exps = []
    script = [
        ("ann", [("kibble", 2), ("kibble", 2)], None),
        ("ann", [("kibble", 2), ("kibble", 1)], ValueError),
        ("", [("toy", 1)], ValueError),
        ("bob", [("leash", 2), ("toy", 4)], None),
        ("bob", [("leash", 1)], ValueError),
        ("bob", [("bowl", 1), ("ghost", 1)], KeyError),
        ("cat", [("bowl", 1), ("bowl", 1), ("bowl", 1)], None),
        ("cat", [("kibble", 2.0)], ValueError),
        ("cat", [], ValueError),
        ("dan", [("kibble", 1), ("kibble", 1)], None),
        ("dan", [("kibble", 1)], ValueError),
    ]
    for cust, lines, exc in script:
        shop.taken = []
        if exc is None:
            e = expected("S%d" % (len(exps) + 1), cust, lines)
            check_sale(sell_ok(m, s, shop, cust, lines), e)
            taken_matches(shop, lines)
            exps.append(e)
        else:
            refused(m, s, shop, cust, lines, exc, exps)
        check_state(m, s, exps)
    ok(len(exps) == 4 and exps[-1]["id"] == "S4", "history miscounted")
    ok(shop.stock == {"kibble": 0, "leash": 0, "bowl": 0, "toy": 0, "ghost": 9},
       "stock left is %r" % shop.stock)


# ---------------------------------------------------------------- runner

def run_child(name, build):
    global _BUILD
    _BUILD = build
    sys.dont_write_bytecode = True
    fn = dict(CASES)[name]
    try:
        fn()
        result = "OK"
    except Fail as e:
        result = "FAIL " + str(e)
    except BaseException as e:
        result = "FAIL unexpected %s: %s" % (type(e).__name__, e)
    result = " ".join(result.split())
    sys.stdout.write("\n" + MARK + result[:300] + "\n")
    sys.stdout.flush()
    os._exit(0)


def run_case(name, build, workdir):
    env = dict(os.environ)
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    env.pop("PYTHONPATH", None)
    cmd = [sys.executable, os.path.abspath(__file__), "--case", name, build]
    try:
        p = subprocess.run(cmd, cwd=workdir, env=env, timeout=TIMEOUT, stdin=subprocess.DEVNULL,
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except subprocess.TimeoutExpired:
        return "timed out after %d s" % TIMEOUT
    out = p.stdout.decode("utf-8", "replace")
    for line in reversed(out.splitlines()):
        if line.startswith(MARK):
            res = line[len(MARK):]
            return None if res == "OK" else (res[5:] or "failed")
    err = " ".join(p.stderr.decode("utf-8", "replace").split())
    return "no result (exit %s) %s" % (p.returncode, err[-200:])


def main(argv):
    if len(argv) == 4 and argv[1] == "--case":
        run_child(argv[2], argv[3])
    if len(argv) != 2:
        sys.stderr.write("usage: check <build-dir>\n")
        return 2
    build = os.path.abspath(argv[1])
    names = [n for n, _ in CASES]
    assert len(set(names)) == len(names)
    with tempfile.TemporaryDirectory() as workdir:
        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
            results = list(pool.map(lambda n: run_case(n, build, workdir), names))
    passed = 0
    for name, reason in zip(names, results):
        if reason is None:
            passed += 1
            print("PASS %s" % name)
        else:
            print("FAIL %s: %s" % (name, reason))
    print("%d/%d" % (passed, len(names)))
    return 0 if passed == len(names) else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
