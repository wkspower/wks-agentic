# ---------------------------------------------------------------- refusals: customer id

def _bad_customer(value):
    def run():
        m = load()
        s = m.new()
        shop = Shop()
        refused(m, s, shop, value, [("kibble", 1)], ValueError, [])
        refused(m, s, shop, value, [("kibble", 1), ("toy", 2)], ValueError, [])
        e1 = expected("S1", "ann", [("kibble", 1)])
        check_sale(sell_ok(m, s, shop, "ann", [("kibble", 1)]), e1)
        shop.taken = []
        refused(m, s, shop, value, [("toy", 1)], ValueError, [e1])
    return run


# doc: "`ValueError` when `customer_id` is not a non-empty string".
for _n, _v in [("empty_string", ""), ("none", None), ("int", 7), ("zero", 0), ("float", 1.5),
