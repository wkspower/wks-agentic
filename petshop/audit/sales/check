#!/usr/bin/env python3
"""Audit cases for the unit `sales` (module sales.py), written from docs/sales.md alone.

Usage: check <build-dir>      (the build dir holds sales.py)

Prints one line per case, `PASS <case>` or `FAIL <case>: <reason>`, then `<passed>/<total>`.
Exit status 0 only if every case passes. Each case runs in its own Python subprocess
(timeout, PYTHONDONTWRITEBYTECODE=1, working directory outside the build dir).
Every case carries a comment `# doc:` naming the sentence of the document it rests on.
"""
import ast
import concurrent.futures
import importlib.util
import json
import os
import subprocess
import sys
import tempfile

TIMEOUT = 20
MARK = "@@AUDIT-RESULT@@ "
CASES = []  # (name, function) in order of definition

SALE_KEYS = {"id", "customer_id", "lines", "total_cents"}
LINE_KEYS = {"item_id", "quantity", "unit_price_cents", "line_total_cents"}
PRICES = {"kibble": 1250, "leash": 899, "bowl": 400, "toy": 1}
STOCK = {"kibble": 10, "leash": 10, "bowl": 10, "toy": 10}


def case(name):
    def deco(fn):
        CASES.append((name, fn))
        return fn
    return deco


class Fail(Exception):
    pass


def ok(cond, msg):
    if not cond:
        raise Fail(msg)


# ---------------------------------------------------------------- helpers (child side)

_BUILD = None
_COUNT = [0]


def load():
    """Load a fresh, separate instance of the build's sales.py."""
    _COUNT[0] += 1
    name = "sales" if _COUNT[0] == 1 else "sales_instance_%d" % _COUNT[0]
    path = os.path.join(_BUILD, "sales.py")
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    sys.modules[name] = mod
    spec.loader.exec_module(mod)
    return mod


class Shop:
    """Fake prices and stock; records every call of take."""

    def __init__(self, prices=None, stock=None):
        self.prices = dict(PRICES if prices is None else prices)
        self.stock = dict(STOCK if stock is None else stock)
        self.taken = []

    def price_of(self, item_id):
        return self.prices[item_id]  # KeyError when unknown

    def available(self, item_id):
        return self.stock.get(item_id, 0)

    def take(self, item_id, quantity):
        self.taken.append((item_id, quantity))
        try:
            self.stock[item_id] = self.stock.get(item_id, 0) - quantity
        except Exception:
            pass


def sell(m, state, shop, customer_id, lines):
    return m.sell(state, customer_id, lines, shop.price_of, shop.available, shop.take)


def sell_ok(m, state, shop, customer_id, lines):
    try:
        return sell(m, state, shop, customer_id, lines)
    except Exception as e:
        raise Fail("sell(%r, %r) raised %s: %s" % (customer_id, lines, type(e).__name__, e))


def expected(sale_id, customer_id, lines, prices=PRICES):
    out = []
    for item_id, quantity in lines:
        out.append({"item_id": item_id, "quantity": quantity,
                    "unit_price_cents": prices[item_id],
                    "line_total_cents": prices[item_id] * quantity})
    return {"id": sale_id, "customer_id": customer_id, "lines": out,
            "total_cents": sum(x["line_total_cents"] for x in out)}


def is_int(v):
    return type(v) is int


def check_sale(sale, exp, what="sale"):
    """Exact shape and content of one sale."""
    ok(isinstance(sale, dict), "%s is not a dict but %s" % (what, type(sale).__name__))
    ok(set(sale.keys()) == SALE_KEYS, "%s keys are %r" % (what, sorted(map(str, sale))))
    ok(type(sale["id"]) is str and sale["id"] == exp["id"],
       "%s id is %r, expected %r" % (what, sale["id"], exp["id"]))
    ok(type(sale["customer_id"]) is str and sale["customer_id"] == exp["customer_id"],
       "%s customer_id is %r" % (what, sale["customer_id"]))
    ok(isinstance(sale["lines"], (list, tuple)), "%s lines is not a list" % what)
    lines = list(sale["lines"])
    ok(len(lines) == len(exp["lines"]),
       "%s has %d lines, expected %d" % (what, len(lines), len(exp["lines"])))
    for i, (got, want) in enumerate(zip(lines, exp["lines"])):
        ok(isinstance(got, dict), "%s line %d is not a dict" % (what, i))
        ok(set(got.keys()) == LINE_KEYS,
           "%s line %d keys are %r" % (what, i, sorted(map(str, got))))
        ok(got["item_id"] == want["item_id"],
           "%s line %d item_id is %r, expected %r" % (what, i, got["item_id"], want["item_id"]))
        for k in ("quantity", "unit_price_cents", "line_total_cents"):
            ok(is_int(got[k]), "%s line %d %s is not an int: %r" % (what, i, k, got[k]))
            ok(got[k] == want[k],
               "%s line %d %s is %r, expected %r" % (what, i, k, got[k], want[k]))
    ok(is_int(sale["total_cents"]),
       "%s total_cents is not an int: %r" % (what, sale["total_cents"]))
    ok(sale["total_cents"] == exp["total_cents"],
       "%s total_cents is %r, expected %r" % (what, sale["total_cents"], exp["total_cents"]))


def check_state(m, state, exps, what="state"):
    """sales, get and takings agree with the expected list of sales."""
    got = m.sales(state)
    ok(isinstance(got, (list, tuple)), "%s: sales() is not a list" % what)
    got = list(got)
    ok(len(got) == len(exps), "%s: sales() has %d sales, expected %d" % (what, len(got), len(exps)))
    for g, e in zip(got, exps):
        check_sale(g, e, "%s: sales() entry %s" % (what, e["id"]))
    for e in exps:
        check_sale(m.get(state, e["id"]), e, "%s: get(%s)" % (what, e["id"]))
    t = m.takings(state)
    ok(is_int(t), "%s: takings is not an int: %r" % (what, t))
    ok(t == sum(e["total_cents"] for e in exps),
       "%s: takings is %r, expected %r" % (what, t, sum(e["total_cents"] for e in exps)))


def snapshot(state):
    return json.dumps(state, sort_keys=True)


def refused(m, state, shop, customer_id, lines, exc, exps):
    """The call raises exc; take never called; nothing recorded; state as it was."""
    before = snapshot(state)
    stock = dict(shop.stock)
    try:
        r = sell(m, state, shop, customer_id, lines)
    except exc:
        pass
    except Exception as e:
        raise Fail("sell(%r, %r) raised %s, expected %s"
                   % (customer_id, lines, type(e).__name__, exc.__name__))
    else:
        raise Fail("sell(%r, %r) returned %r, expected %s"
                   % (customer_id, lines, r, exc.__name__))
    ok(shop.taken == [], "take was called on a refused sale: %r" % (shop.taken,))
    ok(shop.stock == stock, "stock changed on a refused sale")
    ok(snapshot(state) == before, "a refused call changed the state")
    check_state(m, state, exps, "after refusal")


def taken_matches(shop, lines):
    ok(sorted(shop.taken) == sorted(lines),
       "take calls were %r, expected one per line of %r" % (shop.taken, lines))


def roundtrip(state):
    return json.loads(json.dumps(state))


def mutate(sale):
    """Deface a returned sale as thoroughly as its type allows."""
    sale["total_cents"] = 987654321
    sale["customer_id"] = "defaced"
    sale["id"] = "S999"
    sale["extra"] = 1
    for line in list(sale["lines"]):
        line["quantity"] = 4242
        line["unit_price_cents"] = 4242
        line["line_total_cents"] = 4242
        line["item_id"] = "defaced"
        line["extra"] = 1
    try:
        sale["lines"].append({"item_id": "defaced"})
        del sale["lines"][0]
    except Exception:
        pass


