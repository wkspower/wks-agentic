def _source():
    with open(os.path.join(_BUILD, "sales.py"), "rb") as f:
        return f.read().decode("utf-8")


# doc: petshop rule 3, "no line longer than 100 characters".
@case("static_no_line_over_100_characters")
def _():
    for n, line in enumerate(_source().split("\n"), 1):
        line = line.rstrip("\r")
        ok(len(line) <= 100, "line %d has %d characters" % (n, len(line)))


def _is_stdlib(name):
    names = getattr(sys, "stdlib_module_names", None)
    if names is not None:
        return name in names
    if name in sys.builtin_module_names:
        return True
    stdlib = os.path.dirname(os.__file__)
    return (os.path.exists(os.path.join(stdlib, name + ".py"))
            or os.path.isdir(os.path.join(stdlib, name)))


# doc: petshop rule 3, "Python 3 standard library only ... a unit's module imports no other
# unit's module"; sales.md principle 1, "imports no other unit's module".
@case("static_imports_standard_library_only")
def _():
    tree = ast.parse(_source())
    for node in ast.walk(tree):
        names = []
        if isinstance(node, ast.Import):
            names = [a.name for a in node.names]
        elif isinstance(node, ast.ImportFrom):
            ok(node.level == 0, "relative import on line %d" % node.lineno)
            names = [node.module or ""]
        elif isinstance(node, ast.Call):
            f = node.func
            fname = f.id if isinstance(f, ast.Name) else getattr(f, "attr", "")
            if fname in ("__import__", "import_module") and node.args:
                a = node.args[0]
                if isinstance(a, ast.Constant) and isinstance(a.value, str):
                    names = [a.value]
        for name in names:
            top = name.split(".")[0]
            ok(_is_stdlib(top), "imports %r, not standard library (line %d)" % (name, node.lineno))


