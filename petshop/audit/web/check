# ----------------------------------------------------------------------------- main

def main():
    global WORK, APP
    if len(sys.argv) != 2 or not os.path.isdir(sys.argv[1]):
        print("usage: check <build-dir>", file=sys.stderr)
        return 2
    WORK = tempfile.mkdtemp(prefix="audit-web-")
    atexit.register(stop_all)
    APP = os.path.join(WORK, "app")
    shutil.copytree(sys.argv[1], APP, ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))
    setup_error = None
    if not os.path.isfile(os.path.join(APP, "web.py")):
        setup_error = "the build has no web.py"
    else:
        try:
            sys.path.insert(0, APP)
            for key in KEYS:
                MODS[key] = importlib.import_module(key)
        except Exception as error:
            setup_error = "cannot import the build's modules: %r" % (error,)
    passed = total = failed_starts = 0
    for _group_name, cases in GROUPS:
        srv = None
        error = setup_error
        if error is None and failed_starts >= 2:
            error = start_error
        if error is None:
            try:
                srv = Server()
                failed_starts = 0
            except Fail as failure:
                error = "the server did not start: %s" % failure
            except Exception as failure:
                error = "the server did not start: %r" % (failure,)
            if srv is None:
                failed_starts += 1
                start_error = error
        for name, function in cases:
            total += 1
            reason = error
            if reason is None:
                try:
                    function(srv)
                except Fail as failure:
                    reason = str(failure)
                except Exception as failure:
                    reason = "%s: %s" % (type(failure).__name__, failure)
            if reason is None:
                passed += 1
                print("PASS %s" % name)
            else:
                print("FAIL %s: %s" % (name, " ".join(str(reason).split())[:300]))
            sys.stdout.flush()
        if srv is not None:
            srv.stop()
    print("%d/%d" % (passed, total))
    return 0 if passed == total else 1


def terminated(*_args):
    sys.exit(1)


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, terminated)
    try:
        code = main()
    finally:
        stop_all()
    sys.exit(code)
