# pages.md Running: "always replaced whole (written beside itself, then renamed)"
@case("state_replaced_whole_not_rewritten_in_place")
def _(srv):
    data = std().dump()
    srv.put(data)
    link = os.path.join(srv.dir, "audit-link")
    linked = True
    try:
        os.link(srv.state, link)
    except OSError:
        linked = False
    inode = os.stat(srv.state).st_ino
    try:
        done(srv, "/customers/register", [("name", "Dora")], "/customers")
        ensure(srv.raw() != data, "the state file did not change")
        if linked:
            with open(link, "rb") as handle:
                ensure(handle.read() == data, "the old file was written over in place")
        else:
            ensure(os.stat(srv.state).st_ino != inode, "the state file was not replaced")
    finally:
        if linked:
            os.remove(link)


