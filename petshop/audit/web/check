        ensure(srv.raw() is None, "GET %s created the state file" % path)
        if path == "/":
            for ident in ("count-items", "count-customers", "count-sales"):
                shows_count(resp.root, ident, 0, path)
            shows_money(resp.root, "takings", 0, path)
            row_ids(resp.root, "out-of-stock", [], path)
        if path == "/catalog":
            row_ids(resp.root, "items", [], path)
        if path == "/customers":
            row_ids(resp.root, "customers", [], path)
        if path == "/sales":
            row_ids(resp.root, "sales", [], path)
            shows_money(resp.root, "takings", 0, path)


