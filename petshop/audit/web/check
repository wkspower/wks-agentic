#!/usr/bin/env python3
"""Audit of the pet shop's web interface: check <build-dir>

Cases written from docs/web.md (declaration 2) and docs/pages.md alone. Each case is
preceded by a one-line comment naming the sentence of pages.md (or web.md) it rests on.
Prints `PASS name` / `FAIL name: reason` per case, then `<passed>/<total>`; exit 0 only
if all pass. Standard library only; everything is done over HTTP.
"""
import atexit
import http.client
import importlib
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
from html.parser import HTMLParser
from urllib.parse import quote, unquote, urlencode, urljoin, urlsplit

sys.dont_write_bytecode = True

SECTIONS = ["/", "/catalog", "/customers", "/sell", "/sales"]
KEYS = ("catalog", "stock", "customers", "sales")
TIMEOUT = 10
WORK = None      # temp dir holding the copy of the build
APP = None       # the copy of the build
MODS = {}        # the four modules, imported from the copy
SERVERS = []


class Fail(Exception):
    pass


def ensure(condition, message):
    if not condition:
        raise Fail(message)


# ----------------------------------------------------------------------------- HTML

VOID = {"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta",
        "source", "track", "wbr"}
TABLE_PARTS = ("td", "th", "tr", "thead", "tbody", "tfoot")
IMPLIED = {"option": ("option",), "optgroup": ("option", "optgroup"), "li": ("li",),
           "tr": ("td", "th", "tr"), "td": ("td", "th"), "th": ("td", "th"),
           "tbody": TABLE_PARTS, "thead": TABLE_PARTS, "tfoot": TABLE_PARTS,
           "dt": ("dt", "dd"), "dd": ("dt", "dd"), "p": ("p",)}
CLOSES_P = {"div", "table", "form", "ul", "ol", "dl", "h1", "h2", "h3", "h4", "h5", "h6",
            "section", "article", "nav", "main", "header", "footer", "fieldset", "pre",
            "aside", "details", "figure", "hr", "address", "blockquote"}


class Node:
    def __init__(self, tag, attrs, parent):
        self.tag = tag
        self.attrs = {}
        for key, value in attrs:
            self.attrs.setdefault(key, "" if value is None else value)
        self.kids = []
        self.parent = parent

    def walk(self):
        for kid in self.kids:
            if isinstance(kid, Node):
                yield kid
                yield from kid.walk()

    def all(self, *tags):
        return [node for node in self.walk() if node.tag in tags]

    def text(self, sep=""):
        parts = []

        def collect(node):
            for kid in node.kids:
                if isinstance(kid, Node):
                    if kid.tag not in ("script", "style", "template"):
                        collect(kid)
                else:
                    parts.append(kid)
        collect(self)
        return sep.join(parts)

    def clean(self):
        return " ".join(self.text().split())

    def has_class(self, name):
        return name in self.attrs.get("class", "").split()


class Dom(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.root = Node("#root", [], None)
        self.cur = self.root
        self.doctype = None

    def handle_decl(self, decl):
        if self.doctype is None:
            self.doctype = decl

    def handle_starttag(self, tag, attrs):
        while self.cur.tag in IMPLIED.get(tag, ()):
            self.cur = self.cur.parent
        if tag in CLOSES_P and self.cur.tag == "p":
            self.cur = self.cur.parent
        node = Node(tag, attrs, self.cur)
        self.cur.kids.append(node)
        if tag not in VOID:
            self.cur = node

    def handle_endtag(self, tag):
        node = self.cur
        while node is not None and node.tag != tag:
            node = node.parent
        if node is not None and node.parent is not None:
            self.cur = node.parent

    def handle_data(self, data):
        self.cur.kids.append(data)


def parse(text):
    dom = Dom()
    dom.feed(text)
    dom.close()
    return dom


# ----------------------------------------------------------------------------- server

class Response:
    def __init__(self, status, headers, body, path):
        self.status = status
        self.headers = headers          # list of (name, value)
        self.body = body
        self.path = path
        self._dom = None

    def header(self, name):
        for key, value in self.headers:
            if key.lower() == name.lower():
                return value
        return None

    @property
    def text(self):
        try:
            return self.body.decode("utf-8")
        except UnicodeDecodeError:
            raise Fail("%s: the body is not UTF-8" % self.path)

    @property
    def dom(self):
        if self._dom is None:
            self._dom = parse(self.text)
        return self._dom

    @property
    def root(self):
        return self.dom.root


class Server:
    def __init__(self, port=0):
        self.dir = tempfile.mkdtemp(prefix="state-", dir=WORK)
        self.state = os.path.join(self.dir, "shop.json")
        self.first_line = None
        self.port = None
        env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
        self.proc = subprocess.Popen(
            [sys.executable, "web.py", "--state", self.state, "--port", str(port)],
            cwd=APP, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL)
        SERVERS.append(self)
        got = []

        def reader():
            got.append(self.proc.stdout.readline())
            while self.proc.stdout.read(4096):       # keep the pipe drained
                pass
        thread = threading.Thread(target=reader, daemon=True)
        thread.start()
        for _ in range(TIMEOUT * 20):
            if got or self.proc.poll() is not None:
                break
            thread.join(0.05)
        if not got:
            thread.join(0.2)
        if not got or not got[0]:
            self.stop()
            raise Fail("the program printed no line on stdout within %d s" % TIMEOUT)
        self.first_line = got[0].decode("utf-8", "replace").rstrip("\r\n")
        match = re.fullmatch(r"http://127\.0\.0\.1:([0-9]+)/", self.first_line)
        if not match:
            self.stop()
            raise Fail("first stdout line is %r, not http://127.0.0.1:PORT/" % self.first_line)
        self.port = int(match.group(1))
        self.base = "http://127.0.0.1:%d" % self.port

    def stop(self):
        if self.proc.poll() is None:
            self.proc.kill()
        try:
            self.proc.wait(5)
        except Exception:
            pass

    # state file
    def raw(self):
        try:
            with open(self.state, "rb") as handle:
                return handle.read()
        except FileNotFoundError:
            return None

    def put(self, shop):
        data = shop if isinstance(shop, bytes) else shop.dump()
        temp = os.path.join(self.dir, "audit-put.tmp")
        with open(temp, "wb") as handle:
            handle.write(data)
        os.replace(temp, self.state)

    def clear(self):
        if os.path.exists(self.state):
            os.remove(self.state)

    def shop(self):
        """The state file as it is now, read through the modules."""
        data = self.raw()
        ensure(data is not None, "the state file does not exist")
        try:
            obj = json.loads(data.decode("utf-8"))
        except ValueError:
            raise Fail("the state file is not valid JSON")
        ensure(isinstance(obj, dict), "the state file is not one JSON object")
        for key in KEYS:
            ensure(key in obj, "the state file has no %r" % key)
        return Shop(obj)

    # requests
    def request(self, method, path, body=None, headers=None):
        conn = http.client.HTTPConnection("127.0.0.1", self.port, timeout=TIMEOUT)
        try:
            send = {"Connection": "close"}
            send.update(headers or {})
            conn.request(method, path, body=body, headers=send)
            resp = conn.getresponse()
            return Response(resp.status, resp.getheaders(), resp.read(), path)
        except (OSError, http.client.HTTPException) as error:
            raise Fail("%s %s: no answer (%s)" % (method, path, error))
        finally:
            conn.close()

    def get(self, path, headers=None):
        return self.request("GET", path, headers=headers)

    def post(self, path, fields=()):
        body = urlencode(list(fields), encoding="utf-8").encode("ascii")
        return self.request("POST", path, body=body, headers={
            "Content-Type": "application/x-www-form-urlencoded",
            "Content-Length": str(len(body))})


def stop_all():
    for server in SERVERS:
        server.stop()
    if WORK:
        shutil.rmtree(WORK, ignore_errors=True)


# ----------------------------------------------------------------------------- the shop

class Shop:
    """A shop state built and read only through the four modules' documented functions."""

    def __init__(self, obj=None):
        self.s = obj if obj is not None else {key: MODS[key].new() for key in KEYS}

    def item(self, item_id, name, kind, cents, on_hand=0):
        MODS["catalog"].add(self.s["catalog"], item_id, name, kind, cents)
        if on_hand:
            MODS["stock"].receive(self.s["stock"], item_id, on_hand)
        return self

    def cust(self, name):
        return MODS["customers"].register(self.s["customers"], name)

    def sell(self, customer_id, lines):
        return MODS["sales"].sell(
            self.s["sales"], customer_id, lines,
            lambda i: MODS["catalog"].get(self.s["catalog"], i)["price_cents"],
            lambda i: MODS["stock"].on_hand(self.s["stock"], i),
            lambda i, q: MODS["stock"].remove(self.s["stock"], i, q))

    def items(self):
        return MODS["catalog"].items(self.s["catalog"])

    def ids(self):
        return [item["id"] for item in self.items()]

    def get(self, item_id):
        return MODS["catalog"].get(self.s["catalog"], item_id)

    def price(self, item_id):
        return self.get(item_id)["price_cents"]

    def on_hand(self, item_id):
        return MODS["stock"].on_hand(self.s["stock"], item_id)

    def custs(self):
        return MODS["customers"].find(self.s["customers"], "")

    def cust_name(self, customer_id):
        return MODS["customers"].get(self.s["customers"], customer_id)["name"]

    def sales(self):
        return MODS["sales"].sales(self.s["sales"])

    def takings(self):
        return MODS["sales"].takings(self.s["sales"])

    def out(self):
        return [i for i in self.ids() if self.on_hand(i) == 0]

    def dump(self):
        return json.dumps(self.s).encode("utf-8")


