def money(cents):
    return "{:,}.{:02d}".format(cents // 100, cents % 100)


# ----------------------------------------------------------------------------- checks

def numbers(text):
    """Every number written in a text, with its commas and decimals."""
    return re.findall(r"[0-9][0-9,]*(?:\.[0-9]+)?", text)


def path_of(base_path, href):
    return unquote(urlsplit(urljoin("http://127.0.0.1" + base_path, href)).path)


def by_id(root, ident):
    found = [node for node in root.walk() if node.attrs.get("id") == ident]
    ensure(found, 'no element with id="%s"' % ident)
    return found[0]


def roles(root, role):
    return [node for node in root.walk() if node.attrs.get("role") == role]


def shows_money(root, ident, cents, where):
    got = numbers(by_id(root, ident).text(" "))
    ensure(got == [money(cents)], "%s: #%s shows %r, expected %s" % (
        where, ident, by_id(root, ident).clean(), money(cents)))


def shows_count(root, ident, count, where):
    got = numbers(by_id(root, ident).text(" "))
    ensure(got == [str(count)], "%s: #%s shows %r, expected %d" % (
        where, ident, by_id(root, ident).clean(), count))


def table_rows(root, ident, may_be_absent=False):
    tables = [node for node in root.all("table") if node.attrs.get("id") == ident]
    if not tables:
        ensure(may_be_absent, 'no <table id="%s">' % ident)
        return []
    return [row for row in tables[0].all("tr") if "data-id" in row.attrs]


def row_ids(root, ident, expected, where):
    rows = table_rows(root, ident, may_be_absent=not expected)
    got = [row.attrs["data-id"] for row in rows]
    ensure(got == expected, "%s: rows of #%s are %r, expected %r" % (where, ident, got, expected))
    return rows


def cell(row, name):
    cells = [node for node in row.all("td", "th") if node.has_class(name)]
    ensure(cells, 'row data-id="%s" has no cell of class "%s"' % (row.attrs.get("data-id"), name))
    return cells[0]


def cell_is(row, name, expected):
    got = cell(row, name).clean()
    ensure(got == " ".join(expected.split()), "row %r: cell %s shows %r, expected %r" % (
        row.attrs.get("data-id"), name, got, expected))


def cell_number(row, name, expected):
    got = numbers(cell(row, name).text(" "))
    ensure(got == [expected], "row %r: cell %s shows %r, expected %s" % (
        row.attrs.get("data-id"), name, cell(row, name).clean(), expected))


def check_page(resp, section=None, nav_only=False):
    """What pages.md states under 'Every page'. section: the nav link to carry aria-current."""
    where = resp.path
    root = resp.root
    if not nav_only:
        doctype = (resp.dom.doctype or "").lower().split()
        ensure(doctype[:2] == ["doctype", "html"], "%s: no <!DOCTYPE html>" % where)
        htmls = root.all("html")
        ensure(htmls and htmls[0].attrs.get("lang", "").strip(), "%s: <html> has no lang" % where)
        titles = root.all("title")
        ensure(titles, "%s: no <title>" % where)
        title = titles[0].text().strip()
        ensure(re.fullmatch(r"\S(.*\S)? · Pet shop", title, re.S),
               "%s: title %r is not of the form 'PAGE · Pet shop'" % (where, title))
        ensure(len(root.all("h1")) == 1, "%s: %d <h1>, expected exactly one" % (
            where, len(root.all("h1"))))
        ensure(root.all("main"), "%s: no <main>" % where)
    navs = root.all("nav")
    ensure(navs, "%s: no <nav>" % where)
    links = [(path_of(where, a.attrs["href"]), a.attrs.get("aria-current"))
             for nav in navs for a in nav.all("a") if "href" in a.attrs]
    for target in SECTIONS:
        ensure(any(path == target for path, _ in links), "%s: <nav> has no link to %s" % (
            where, target))
    if section is not None:
        ensure(any(path == section and current == "page" for path, current in links),
               '%s: the nav link to %s lacks aria-current="page"' % (where, section))
        for path, current in links:
            ensure(not (current == "page" and path in SECTIONS and path != section),
                   '%s: the nav link to %s carries aria-current="page"' % (where, path))


def get_page(srv, path, section=None):
    resp = srv.get(path)
    ensure(resp.status == 200, "GET %s: status %d, expected 200" % (path, resp.status))
    check_page(resp, section)
    return resp


def forms(resp, action, method="post"):
    found = []
    for form in resp.root.all("form"):
        if form.attrs.get("method", "get").strip().lower() != method:
            continue
        if "action" in form.attrs and path_of(resp.path, form.attrs["action"]) == action:
            found.append(form)
    return found


def one_form(resp, action, method="post"):
    found = forms(resp, action, method)
    ensure(found, '%s: no form method="%s" action="%s"' % (resp.path, method, action))
    return found[0]


def control(form, name, required=True):
    for node in form.all("input", "select", "textarea"):
        if node.attrs.get("name") == name:
            return node
    ensure(not required, 'form %s has no field named "%s"' % (form.attrs.get("action"), name))
    return None


def is_text_input(node):
    return node.tag == "input" and node.attrs.get("type", "text").strip().lower() in ("text", "")


def option_value(option):
    return option.attrs["value"] if "value" in option.attrs else option.clean()


def value_of(node):
    if node.tag == "select":
        options = node.all("option")
        chosen = [o for o in options if "selected" in o.attrs]
        if chosen:
            return option_value(chosen[-1])
        return option_value(options[0]) if options else ""
    if node.tag == "textarea":
        return node.text()
    return node.attrs.get("value", "")


def holds(form, name, expected):
    node = control(form, name, required=False)
    return node is not None and value_of(node) == expected


def keeps(resp, action, values):
    """Some form with this action still holds every submitted value."""
    candidates = forms(resp, action)
    ensure(candidates, "%s: no form with action %s on the refusal page" % (resp.path, action))
    for form in candidates:
        if all(holds(form, name, value) for name, value in values.items()):
            return
    raise Fail("the form %s does not hold the submitted values %r" % (action, values))


def done(srv, path, fields, back):
    """A change that is done: 303, Location, then a page with exactly one role=status."""
    resp = srv.post(path, fields)
    ensure(resp.status == 303, "POST %s %r: status %d, expected 303" % (
        path, list(fields), resp.status))
    location = resp.header("Location")
    ensure(location, "POST %s: 303 without Location" % path)
    url = urlsplit(urljoin(srv.base + path, location))
    ensure(url.hostname == "127.0.0.1" and url.port == srv.port,
           "POST %s: Location %r leaves this server" % (path, location))
    ensure(unquote(url.path) == back, "POST %s: Location %r, expected the page %s" % (
        path, location, back))
    headers = {}
    cookies = [v.split(";")[0] for k, v in resp.headers if k.lower() == "set-cookie"]
    if cookies:
        headers["Cookie"] = "; ".join(cookies)
    target = url.path + ("?" + url.query if url.query else "")
    page = srv.get(target, headers)
    page.path = target
    ensure(page.status == 200, "GET %s after POST %s: status %d" % (target, path, page.status))
    count = len(roles(page.root, "status"))
    ensure(count == 1, 'page after POST %s has %d elements role="status", expected exactly one'
           % (path, count))
    ensure(roles(page.root, "status")[0].clean(), 'role="status" after POST %s is empty' % path)
    srv.shop()              # the file is one valid JSON object with the four states
    return page


def refused(srv, path, fields, section):
    """A change that is refused: 400, the form's page, one role=alert, file byte-identical."""
    before = srv.raw()
    resp = srv.post(path, fields)
    ensure(resp.status == 400, "POST %s %r: status %d, expected 400" % (
        path, list(fields), resp.status))
    after = srv.raw()
    ensure(after == before, "POST %s %r refused, but the state file %s" % (
        path, list(fields), "was created" if before is None else "changed"))
    check_page(resp, section)
    count = len(roles(resp.root, "alert"))
    ensure(count == 1, 'refusal of POST %s %r has %d elements role="alert", expected exactly one'
           % (path, list(fields), count))
    ensure(roles(resp.root, "alert")[0].clean(), 'role="alert" is empty')
    if section == "/catalog":
        ensure([n for n in resp.root.all("table") if n.attrs.get("id") == "items"],
               "refusal of POST %s does not show the catalog page (no table #items)" % path)
        one_form(resp, path)
    elif section == "/customers":
        one_form(resp, "/customers/register")
    else:
        one_form(resp, "/sell")
    return resp


def sell_fields(shop, customer, quantities):
    fields = [] if customer is None else [("customer", customer)]
    for item_id in shop.ids():
        fields.append(("qty-" + item_id, quantities.get(item_id, "")))
    return fields


def check_receipt(resp, shop, sale):
    root = resp.root
    found = re.findall(r"S[0-9]+", by_id(root, "sale-id").text(" "))
    ensure(found == [sale["id"]], "#sale-id shows %r, expected %s" % (
        by_id(root, "sale-id").clean(), sale["id"]))
    name = " ".join(shop.cust_name(sale["customer_id"]).split())
    ensure(name in by_id(root, "customer").clean(), "#customer shows %r, expected %r" % (
        by_id(root, "customer").clean(), name))
    shows_money(root, "total", sale["total_cents"], resp.path)
    rows = table_rows(root, "lines")
    got = sorted(row.attrs["data-id"] for row in rows)
    want = sorted(line["item_id"] for line in sale["lines"])
    ensure(got == want, "rows of #lines are %r, expected %r" % (got, want))
    for row in rows:
        line = [l for l in sale["lines"] if l["item_id"] == row.attrs["data-id"]][0]
        cell_is(row, "name", shop.get(line["item_id"])["name"])
        cell_number(row, "quantity", str(line["quantity"]))
        cell_number(row, "unit-price", money(line["unit_price_cents"]))
        cell_number(row, "line-total", money(line["line_total_cents"]))


def answers(host, port):
    """True when something speaks HTTP on host:port."""
    try:
        conn = http.client.HTTPConnection(host, port, timeout=2)
        try:
            conn.request("GET", "/")
            conn.getresponse().read()
            return True
        finally:
            conn.close()
    except (OSError, http.client.HTTPException):
        return False


def outside_address():
    try:
        probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            probe.connect(("192.0.2.1", 9))
            address = probe.getsockname()[0]
        finally:
            probe.close()
        return None if address.startswith("127.") else address
    except OSError:
        return None


