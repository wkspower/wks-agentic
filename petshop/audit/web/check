# pages.md Running: "listens on `127.0.0.1` only, on port N"
@case("run_port_option")
def _(srv):
    probe = socket.socket()
    probe.bind(("127.0.0.1", 0))
    port = probe.getsockname()[1]
    probe.close()
    other = Server(port)
    try:
        ensure(other.port == port, "asked for port %d, printed %s" % (port, other.first_line))
        ensure(other.get("/").status == 200, "GET / on the asked port is not 200")
    finally:
        other.stop()


# pages.md Running / web.md Interface: "listens on `127.0.0.1` only"
@case("run_loopback_only")
