#!/usr/bin/env python3
# Stand-in for the rest of the shop: pets 1 and 2 exist, nothing else.
import json, sys
r = json.load(sys.stdin)
if r.get("op") == "customers.pet_get" and r.get("id") in (1, 2):
    print(json.dumps({"ok": True, "pet": {"id": r["id"], "name": "Thor", "species": "dog", "customer": 1}}))
elif r.get("op") == "customers.pet_get":
    print(json.dumps({"ok": False, "error": "not_found"}))
else:
    print(json.dumps({"ok": False, "error": "unknown_op"}))
