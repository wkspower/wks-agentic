#!/usr/bin/env python3
"""Measure of the unit `enforcer`. usage: check <tree> <work>

Each case builds a base and a head toy tree, asks <tree>/units/enforcer/enforce
whether the change may happen, and compares with what the principles require.
Planted violations must be blocked; the legitimate change beside each must pass.
"""
import os, shutil, sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
import toy

tree, work = os.path.abspath(sys.argv[1]), os.path.abspath(sys.argv[2])
enforce = os.path.join(tree, "units/enforcer/enforce")
shutil.rmtree(work, ignore_errors=True)
os.makedirs(work)
cases, n = toy.Cases(), [0]


def case(name, unit, expect, edit, decision=None, kind=None, base_edit=None, **values):
    n[0] += 1
    d = os.path.join(work, f"c{n[0]}")
    base = toy.make(d + "/base", **values)
    if base_edit:
        base_edit(base)
    head = toy.clone(base, d + "/head")
    edit(head)
    cmd = [enforce, "change", base, head, unit, "--work", d + "/w"]
    if decision:
        cmd += ["--decision", decision]
    code, out = toy.run(cmd)
    ok = out.get("allowed") is expect and (code == 0) is expect
    if ok and kind:
        ok = out.get("kind") == kind
    cases.add(name, ok, str(out)[:300])


W = toy.write
ALWAYS = "#!/bin/sh\necho '{\"pass\": true, \"number\": 9}'\n"
rm = lambda rel: (lambda h: shutil.rmtree(os.path.join(h, rel)))

# boundary and ownership
case("unit builds its own artefact", "toy", True, lambda h: W(h, "units/toy/value", "1\n"), kind="change")
case("PLANT unit alters its own measure", "toy", False, lambda h: W(h, "measures/toy/check", ALWAYS, 0o755))
case("PLANT unit alters its own declarations", "toy", False, lambda h: W(h, "units/toy/unit.md", toy.doc("root") + "\nmore\n"))
case("PLANT unit alters a sibling", "toy", False, lambda h: W(h, "units/judge/value", "5\n"))
case("PLANT unit alters its child's work", "toy", False, lambda h: W(h, "units/toy/part/value", "5\n"))
case("PLANT unit writes the ledger", "toy", False, lambda h: W(h, "ledger.jsonl", "{}\n"))
case("PLANT unit writes the person's queue", "toy", False, lambda h: W(h, "queue.md", "x\n"))
case("PLANT unknown unit", "ghost", False, lambda h: W(h, "units/toy/value", "1\n"))
case("PLANT nothing changed", "toy", False, lambda h: None)
case("PLANT path no unit owns", "toy", False, lambda h: W(h, "units/stray/file", "x\n"))
# records and queues
case("unit writes its record", "toy", True, lambda h: W(h, "units/toy/record.md", "tried x\n"), kind="record")
case("unit asks its parent (root's queue)", "toy", True, lambda h: W(h, "units/queue.md", "item\n"), kind="record")
case("child asks its parent (unit's queue)", "toy/part", True, lambda h: W(h, "units/toy/queue.md", "item\n"), kind="record")
case("PLANT grandchild writes root's queue", "toy/part", False, lambda h: W(h, "units/queue.md", "item\n"))
# the person's documents
case("PLANT principles changed with no decision", "root", False, lambda h: W(h, "principles.md", "new\n"))
case("principles changed under an answered decision", "root", True, lambda h: W(h, "principles.md", "new\n"), decision="Q1", kind="decision")
case("PLANT principles changed under an open item", "root", False, lambda h: W(h, "principles.md", "new\n"), decision="Q2")
case("PLANT a unit changes root.md", "toy", False, lambda h: W(h, "root.md", "new\n"), decision="Q1")
# measures: given by the parent, proven at every change, written before the unit
case("parent changes a measure, plant still fails", "root", True, lambda h: W(h, "measures/toy/check", (toy.CHECK % "toy") + "# note\n", 0o755), kind="giving")
case("PLANT measure that passes its plant", "root", False, lambda h: W(h, "measures/toy/check", ALWAYS, 0o755))
case("PLANT measure left with no plant", "root", False, rm("measures/toy/plants"))
case("unit gives its child's measure", "toy", True, lambda h: W(h, "measures/toy/part/check", (toy.CHECK % "toy/part") + "# note\n", 0o755), kind="giving")
case("PLANT root reaches past a unit to its child", "root", False, lambda h: W(h, "measures/toy/part/check", (toy.CHECK % "toy/part") + "# note\n", 0o755))


def new_unit(h, text=None):
    W(h, "units/new/unit.md", text or toy.doc("root"))
    W(h, "measures/new/check", toy.CHECK % "new", 0o755)
    W(h, "measures/new/plants/zero/units/new/value", "0\n")


case("parent declares a new unit with a proven measure", "root", True, new_unit, kind="giving")
case("PLANT new unit with a declaration missing a value", "root", False, lambda h: new_unit(h, toy.doc("root").replace("— b", "— not yet given")))
case("PLANT new unit with a declaration absent", "root", False, lambda h: new_unit(h, toy.doc("root").replace("5. **Measure** — m\n", "")))
case("PLANT new unit with a principle absent", "root", False, lambda h: new_unit(h, toy.doc("root").replace("| 4 | here |\n", "")))
case("PLANT measure and unit in one change", "toy", False, lambda h: (W(h, "units/toy/value", "1\n"), W(h, "measures/toy/part/check", (toy.CHECK % "toy/part") + "#\n", 0o755)))
case("PLANT unit built before its measure existed", "toy", False, lambda h: W(h, "units/toy/value", "1\n"), base_edit=rm("measures/toy"))
case("PLANT unit acts while its declarations are incomplete", "toy", False, lambda h: W(h, "units/toy/value", "1\n"),
     base_edit=lambda b: W(b, "units/toy/unit.md", toy.doc("root").replace("— b", "— not yet given")))
# a measure above a unit is part of what measures the unit
FLAGGED = (toy.CHECK % "toy/part").replace("import json, os, sys\n", """import json, os, sys
if open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "flag")).read().strip() == "loose":
    print(json.dumps({"pass": True, "number": 1}))
    sys.exit(0)
""")
shared = lambda b: (W(b, "measures/toy/flag", "strict\n"), W(b, "measures/toy/part/check", FLAGGED, 0o755))
case("PLANT a file a child's measure reads is loosened above it", "root", False, lambda h: W(h, "measures/toy/flag", "loose\n"), base_edit=shared)
case("that file changes and the child's plant still fails", "root", True, lambda h: W(h, "measures/toy/flag", "strict \n"), base_edit=shared, kind="giving")
# root's own files
case("root keeps its state", "root", True, lambda h: W(h, "state.md", "now\n"), kind="record")
case("PLANT a unit writes root's state", "toy", False, lambda h: W(h, "state.md", "now\n"))

# prove, on its own
d = os.path.join(work, "prove")
t = toy.make(d + "/t")
code, out = toy.run([enforce, "prove", t, "toy", "--work", d + "/w1"])
cases.add("prove: plant fails the measure", code == 0 and out.get("proven") is True, str(out)[:300])
W(t, "measures/toy/controls/one/units/toy/value", "0\n")
code, out = toy.run([enforce, "prove", t, "toy", "--work", d + "/w2"])
cases.add("PLANT prove: a control that does not pass", code != 0 and out.get("proven") is False, str(out)[:300])
cases.finish()
