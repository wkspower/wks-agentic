   ["goto", "/places/1"],
   ["see", ["Tap <drips> & leaks"], "the place's page does not show its open request above the form"],
   ["goto", "/workers"],
   ["fill", "form[action=\"/workers\"] input[name=name]", "Joe <Pipe>"],
   ["fill", "form[action=\"/workers\"] input[name=trade]", "plumber"],
   ["fill", "form[action=\"/workers\"] input[name=phone]", "555 0199"],
   ["submit", "form[action=\"/workers\"]"],
   ["see", ["Joe <Pipe>", "1 worker or contractor"], "the new worker is not shown, or the name was not escaped"],
   ["goto", "/requests/1"],
   ["select", "form[action=\"/requests/1/assign\"] select[name=worker_id]", "1"],
   ["submit", "form[action=\"/requests/1/assign\"]"],
   ["see", ["assigned", "to Joe <Pipe>"], "giving the request to a worker is not in its history"],
   ["fill", "form[action=\"/requests/1/note\"] input[name=note]", "Waiting for a part"],
   ["submit", "form[action=\"/requests/1/note\"]"],
   ["see", ["Waiting for a part"], "a note is not in the history of the request"],
   ["goto", "/requests"],
   ["see", ["1 open or in progress", "Joe <Pipe>"], "the open list does not show the request and its worker"],
   ["submit", "form[action=\"/requests/1/start\"]"],
   ["text", "tbody tr td.st", "in progress", "a started request is not shown as in progress on the list"],
   ["count", "main form[action$=\"/start\"]", 0, "a started request still has its Start button"],
   ["submit", "form[action=\"/requests/1/done\"]"],
   ["see", ["0 open or in progress", "Nothing is open"], "after Done the request is still on the open list"],
   ["goto", "/closed"],
   ["see", ["1 closed request", "Tap <drips> & leaks"], "the done request is not on the closed list"],
   ["submit", "form[action=\"/requests/1/reopen\"]"],
   ["see", ["0 closed requests"], "a reopened request is still on the closed list"],
   ["goto", "/requests/1"],
   ["follow", "main a[href=\"/requests/1/edit\"]"],
   ["value", "form[action=\"/requests/1/edit\"] textarea[name=description]", "Tap <drips> & leaks", "the form to correct a request does not hold its description"],
   ["value", "form[action=\"/requests/1/edit\"] select[name=priority]", "urgent", "the form to correct a request does not hold its priority"],
   ["fill", "form[action=\"/requests/1/edit\"] textarea[name=description]", "Tap drips"],
   ["select", "form[action=\"/requests/1/edit\"] select[name=priority]", "low"],
   ["submit", "form[action=\"/requests/1/edit\"]"],
   ["see", ["Tap drips", "low", "corrected", "priority, description"], "the corrected request is not shown with its correction in the history"],
   ["goto", "/requests"],
   ["fill", "form[method=get][action=\"/requests\"] input[name=q]", "DRIPS"],
   ["submit", "form[method=get][action=\"/requests\"]"],
   ["see", ["1 matching request", "Tap drips"], "searching for a word of the description does not find the request"],
   ["goto", "/places"],
   ["follow", "main a[href=\"/places/1/edit\"]"],
   ["value", "form[action=\"/places/1/edit\"] input[name=name]", "12B", "the form to correct a place does not hold its name"],
   ["select", "form[action=\"/places/1/edit\"] select[name=active]", "0"],
   ["submit", "form[action=\"/places/1/edit\"]"],
   ["see", ["inactive and takes no new request", "Tap drips"], "a place made inactive does not say so, or lost its open request"],
   ["count", "form[method=post][action=\"/requests\"]", 0, "an inactive place is still offered the form for a new request"]
