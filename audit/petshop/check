#!/usr/bin/env python3
"""Audit scenarios for the pet shop program `shop.py`.

Usage: check <build-dir>

Every scenario follows from sentences of docs/petshop.md and of the documents
of its four units (catalog, stock, customers, sales). The build is a black
box: each step runs `python3 <build-dir>/shop.py --state FILE COMMAND ...` in
a subprocess; state files live in temporary directories; nothing is written
into the build directory.

Short names used in the one-line comments:
  P  = petshop.md, declaration 2 (Interface)
  P5 = petshop.md, principle row 5 ("The state file of a refused command is unchanged")
  C  = catalog.md, declaration 2      K = stock.md, declaration 2
  U  = customers.md, declaration 2    S = sales.md, declaration 2
"""
import os
import random
import shutil
import subprocess
import sys
import tempfile

TIMEOUT = 30
SCENARIOS = []


class Fail(Exception):
    pass


def scenario(fn):
    SCENARIOS.append((fn.__name__, fn))
    return fn


def show(args):
    return " ".join(repr(a) for a in args)


class Shop:
    """One state file, driven only through the command line."""

    def __init__(self, build, state, cwd):
        self.program = os.path.join(build, "shop.py")
        self.state = state
        self.cwd = cwd

    def raw(self, *args):
        env = dict(os.environ)
        env["PYTHONDONTWRITEBYTECODE"] = "1"
        cmd = [sys.executable, self.program, "--state", self.state] + list(args)
        try:
            p = subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                               stderr=subprocess.PIPE, cwd=self.cwd, env=env,
                               timeout=TIMEOUT)
        except subprocess.TimeoutExpired:
            raise Fail("%s: no answer within %d s" % (show(args), TIMEOUT))
        return (p.returncode, p.stdout.decode("utf-8", "replace"),
                p.stderr.decode("utf-8", "replace"))

    def path(self):
        return os.path.join(self.cwd, self.state)

    def content(self):
        try:
            with open(self.path(), "rb") as f:
                return f.read()
        except FileNotFoundError:
            return None

    def ok(self, expected, *args):
        """Success: exit 0 and exactly one line on stdout, holding `expected`."""
        expected = str(expected)
        code, out, err = self.raw(*args)
        if code != 0:
            raise Fail("%s: exit %d, expected 0 (stderr: %r)" % (show(args), code, err[-200:]))
        if out not in (expected + "\n", expected):
            raise Fail("%s: stdout %r, expected the one line %r" % (show(args), out, expected))

    def refuse(self, *args):
        """Refusal: exit 1, something on stderr, nothing on stdout, state file unchanged."""
        before = self.content()
        code, out, err = self.raw(*args)
        if code != 1:
            raise Fail("%s: exit %d, expected 1 (stdout: %r)" % (show(args), code, out[-200:]))
        if out != "":
            raise Fail("%s: refused but stdout is %r, expected nothing" % (show(args), out))
        if err.strip() == "":
            raise Fail("%s: refused but no message on stderr" % show(args))
        # Only where the file existed before: whether a refused command creates a
        # missing state file is not stated by the documents.
        if before is not None and self.content() != before:
            raise Fail("%s: refused but the state file changed" % show(args))


class Env:
    def __init__(self, build, tmp):
        self.build = build
        self.tmp = tmp
        self.n = 0

    def shop(self, name=None, cwd=None):
        self.n += 1
        return Shop(self.build, os.path.join(self.tmp, name or "state%d.json" % self.n),
                    cwd or self.tmp)


def fixture(env):
    """bone: product, 250 c, 10 on hand; cat: animal, 12000 c, 2 on hand;
    eel: animal, 900 c, never received; customer C1."""
    s = env.shop()
    s.ok("bone", "add-item", "bone", "Dog Bone", "product", "250")
    s.ok("cat", "add-item", "cat", "Cat", "animal", "12000")
    s.ok("eel", "add-item", "eel", "Eel", "animal", "900")
    s.ok(10, "receive", "bone", "10")
    s.ok(2, "receive", "cat", "2")
    s.ok("C1", "register", "Ann")
    return s


def after_refusal(s):
    """The fixture still behaves as if the refused command had never been given."""
    s.ok(10, "stock", "bone")
    s.ok(2, "stock", "cat")
    s.ok(0, "stock", "eel")
    s.ok(0, "takings")
    s.ok("S1 12500", "sell", "C1", "bone=2", "cat=1")
    s.ok("C2", "register", "Bob")


