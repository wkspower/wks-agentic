# ------------------------------------------------------------- long sequences
def long_sequence(env, seed, steps):
    """A model of the shop, written from the documents, followed step by step."""
    rnd = random.Random(seed)
    s = env.shop()
    price, hand = {}, {}
    customers = sales = takings = 0
    names = ["Ann", "Bob Lee", " Cy ", "Ann", "Dee  Dee", "Eve\t"]
    for _ in range(steps):
        roll = rnd.randrange(100)
        known = sorted(price)
        if roll < 8 or not known:
            item = "i%d" % rnd.randrange(12)
            cents = rnd.choice([0, 1, 99, 250, 12000, 1000000007])
            kind = rnd.choice(["animal", "product"])
            if item in price:
                s.refuse("add-item", item, "Thing", kind, str(cents))
            else:
                s.ok(item, "add-item", item, "Thing " + item, kind, str(cents))
                price[item], hand[item] = cents, 0
        elif roll < 28:
            item = rnd.choice(known + ["nothing"])
            q = rnd.choice([1, 1, 2, 5, 40, 0, -2])
            if item in price and q >= 1:
                hand[item] += q
                s.ok(hand[item], "receive", item, str(q))
            else:
                s.refuse("receive", item, str(q))
        elif roll < 38:
            name = rnd.choice(names + ["", "  "])
            if name.strip():
                customers += 1
                s.ok("C%d" % customers, "register", name)
            else:
                s.refuse("register", name)
        elif roll < 55:
            item = rnd.choice(known + ["nothing"])
            if item in price:
                s.ok(hand[item], "stock", item)
            else:
                s.refuse("stock", item)
        elif roll < 63:
            s.ok(takings, "takings")
        else:
            cust = rnd.randrange(1, customers + 2)
            lines, asked, good = [], {}, 1 <= cust <= customers
            for _ in range(rnd.choice([1, 1, 2, 3, 4])):
                item = rnd.choice(known + known + known + ["nothing"])
                q = rnd.choice([1, 1, 1, 2, 3, 7, 0])
                lines.append("%s=%d" % (item, q))
                asked[item] = asked.get(item, 0) + q
                if item not in price or q < 1:
                    good = False
            for item, q in asked.items():
                if q > hand.get(item, 0):
                    good = False
            if good:
                total = 0
                for line in lines:
                    item, q = line.split("=")
                    total += price[item] * int(q)
                    hand[item] -= int(q)
                sales += 1
                takings += total
                s.ok("S%d %d" % (sales, total), "sell", "C%d" % cust, *lines)
            else:
                s.refuse("sell", "C%d" % cust, *lines)
    for item in sorted(price):
        s.ok(hand[item], "stock", item)
    s.ok(takings, "takings")
    s.ok("C%d" % (customers + 1), "register", "Last")


