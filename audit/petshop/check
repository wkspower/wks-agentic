def make_refusal(name, args):
    def run(env):
        s = fixture(env)
        s.refuse(*args)
        after_refusal(s)
    run.__name__ = "refuse_" + name
    return run


for _name, _args in REFUSALS:
    scenario(make_refusal(_name, _args))


