def doc(name):
    parent, c, t, x, a, al, at, cap = UNITS[name]
    s = '# %s\n\nParent: %s. Governed by the principles.\n\n## The six declarations\n\n' % (name, parent)
    s += '1. **Purpose** — the purpose of %s.\n' % name
    s += '2. **Interface** — what it receives and offers.\n'
    s += '3. **Rules** — the root\'s.\n'
    s += ('4. **Budget** — cost %d runs; time %s h; context %d KB; attempts %d; alternatives %d; '
          'attention %d; no-undo cap %d.\n' % (c, t, x, a, al, at, cap))
    # Not the budget line: must not be read for the budget.
    s += ('5. **Measure** — its check; unlike a unit with cost 0 runs, time 0 h, context 1 KB, '
          'attempts 0, alternatives 0, attention 0, cap 0.\n')
    s += '6. **Judge** — the judge.\n\n## The principles here\n\n| Principle | Here |\n|---|---|\n'
    for r in ROWS:
        s += '| %s | here. |\n' % r
    return s


def src_hash_files(files):
    """files: {relative path under src: bytes}; __pycache__ already left out."""
    h = hashlib.sha256()
    for p in sorted(files):
        h.update(p.encode() + b'\0' + files[p] + b'\0')
    return h.hexdigest()


def src_hash_dir(d):
    files = {}
    for dp, dn, fn in os.walk(d):
        dn[:] = [x for x in dn if x != '__pycache__']
        for f in fn:
            p = os.path.join(dp, f)
            with open(p, 'rb') as fh:
                files[os.path.relpath(p, d).replace(os.sep, '/')] = fh.read()
    return src_hash_files(files)


