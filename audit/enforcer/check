        F[d + 'verdict'] = SH_OK
        F[d + 'measure/check'] = CHECK
        F[d + 'measure/planted/bad/x'] = b'a wrong build\n'
    F['root.md'] += b'\nRevised once.\n'
    F['principles.md'] = b'# Principles\n\nSeven.\n'
    F['queue.md'] = b'q1\nq2\nq3\n'
    F['record.md'] = b'# Record\n\nThe root record.\n'
    F['alpha/record.md'] = b('# Record\n\nstood unjudged: %s\n\nLater judged.\n' % OLD)
    F['alpha/beta/record.md'] = b('# Record\n\nThe first build.\n\nstood unjudged: %s\n' % H['alpha/beta'])
    F['group/gamma/record.md'] = b'# Record\n'
    F['zeta/record.md'] = b'# Record\n'
    for u, files in SRC.items():
        for p, data in files.items():
            F['%s/src/%s' % (u, p)] = data
    F['judge/stands/alpha.tsv'] = b(stand_line('alpha', OLD, '2026-01-01T10:00Z')
                                    + stand_line('alpha', OLD2, '2026-01-02T10:00Z')
                                    + stand_line('alpha', H['alpha']))
    F['judge/stands/group/gamma.tsv'] = b(stand_line('group/gamma', H['group/gamma']))
    F['ledger.tsv'] = b(LEDGER)
    F['alpha/measure/planted/late/x'] = b'a wrong build added later\n'
    return F


def is_exe(path):
    return path.rsplit('/', 1)[-1] in ('build', 'verdict') or path.endswith('measure/check')


def put(t, path, data, exe=None):
    p = os.path.join(t, path)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, 'wb') as f:
        f.write(b(data))
    os.chmod(p, 0o755 if (is_exe(path) if exe is None else exe) else 0o644)


def get(t, path):
    with open(os.path.join(t, path), 'rb') as f:
        return f.read()


def sub(t, path, old, new):
    data = get(t, path)
    if data.count(b(old)) != 1:
        raise RuntimeError('fixture edit: %r occurs %d times in %s' % (old, data.count(b(old)), path))
    mode = stat.S_IMODE(os.stat(os.path.join(t, path)).st_mode)
    with open(os.path.join(t, path), 'wb') as f:
        f.write(data.replace(b(old), b(new)))
    os.chmod(os.path.join(t, path), mode)


def append(t, path, data):
    with open(os.path.join(t, path), 'ab') as f:
        f.write(b(data))


def rm(t, path):
    p = os.path.join(t, path)
    if os.path.isdir(p):
        shutil.rmtree(p)
    else:
        os.remove(p)


def in_src(p):
    return '/src/' in p


def base_steps(F):
    """The commit order of the clean tree: answer files; everything but src; src and
    stands; a later measure addition; an answer-only change."""
    first_root = F['root.md'][:-len(b'\nRevised once.\n')]
    s1 = {'root.md': first_root, 'principles.md': F['principles.md'], 'queue.md': b'q1\n'}
    late = 'alpha/measure/planted/late/x'
    s2 = {p: d for p, d in F.items()
          if p not in s1 and not in_src(p) and not p.startswith('judge/') and p != late}
    s3 = {p: d for p, d in F.items() if in_src(p) or p.startswith('judge/')}
    s4 = {late: F[late], 'queue.md': b'q1\nq2\n'}
    s5 = {'root.md': F['root.md'], 'queue.md': F['queue.md']}
    return [s1, s2, s3, s4, s5]


def build_repo(t, steps, after=None, skew=False):
    os.makedirs(t)
    git(t, 'init', '-q')
    for i, step in enumerate(steps):
        for p, d in step.items():
            if d is None:
                rm(t, p)
            else:
                put(t, p, d)
        git(t, 'add', '-A')
        date = 1750000000 + (-i if skew else i) * 3600
        git(t, 'commit', '-q', '-m', 'change %d' % (i + 1), date=date)
    if after:
        after(t)
    return t


def snapshot(t):
    snap = {}
    for dp, dn, fn in os.walk(t):
        if dp == t and '.git' in dn:
            dn.remove('.git')
        for d in dn:
            snap[os.path.relpath(os.path.join(dp, d), t) + '/'] = 'dir'
        for f in fn:
            p = os.path.join(dp, f)
            st = os.lstat(p)
            if stat.S_ISLNK(st.st_mode):
                snap[os.path.relpath(p, t)] = ('link', os.readlink(p))
            else:
                with open(p, 'rb') as fh:
                    snap[os.path.relpath(p, t)] = (stat.S_IMODE(st.st_mode), hashlib.sha256(fh.read()).hexdigest())
    return snap


def snap_diff(a, c):
    ch = sorted(k for k in set(a) | set(c) if a.get(k) != c.get(k))
    return ', '.join(ch[:4])


