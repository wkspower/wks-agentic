TIMEOUT = 40
ID = ['-c', 'user.name=Audit', '-c', 'user.email=audit@example.invalid',
      '-c', 'commit.gpgsign=false', '-c', 'core.autocrlf=false']


class Fail(Exception):
    pass


def make_env(home):
    e = dict(os.environ)
    for k in list(e):
        if k.startswith('GIT_'):
            del e[k]
    e.update(HOME=home, XDG_CONFIG_HOME=os.path.join(home, '.config'),
             GIT_CONFIG_NOSYSTEM='1', GIT_TERMINAL_PROMPT='0',
             GIT_AUTHOR_NAME='Audit', GIT_AUTHOR_EMAIL='audit@example.invalid',
             GIT_COMMITTER_NAME='Audit', GIT_COMMITTER_EMAIL='audit@example.invalid',
             LC_ALL='C', PYTHONDONTWRITEBYTECODE='1')
    return e


ENV = None
HUNG = {}


def git(d, *args, date=None):
    env = dict(ENV)
    if date is not None:
        env['GIT_AUTHOR_DATE'] = env['GIT_COMMITTER_DATE'] = '%d +0000' % date
    r = subprocess.run(['git'] + ID + ['-C', d] + list(args), capture_output=True, env=env, timeout=60)
    if r.returncode != 0:
        raise RuntimeError('fixture git %s: %s' % (' '.join(args), r.stderr.decode('utf-8', 'replace')))
    return r.stdout.decode('utf-8', 'replace')


def run_build(exe, args, cwd):
    """Run a build executable; returns (rc, stdout lines)."""
    if not os.path.isfile(exe):
        raise Fail('%s is missing' % os.path.basename(exe))
    if HUNG.get(exe, 0) >= 2:   # do not wait again and again for a build that hangs
        raise Fail('%s not run: it timed out in earlier cases' % os.path.basename(exe))
    try:
        r = subprocess.run([exe] + args, cwd=cwd, env=ENV, stdin=subprocess.DEVNULL,
                           capture_output=True, timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        HUNG[exe] = HUNG.get(exe, 0) + 1
        raise Fail('%s timed out after %d s' % (os.path.basename(exe), TIMEOUT))
    except OSError as e:
        raise Fail('%s cannot be run: %s' % (os.path.basename(exe), e))
    return r.returncode, r.stdout.decode('utf-8', 'replace').splitlines()


