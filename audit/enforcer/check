        append(t, 'alpha/record.md', 'stood unjudged: %s\n' % H['alpha'])
    tree('stands: stale stands file but record says stood unjudged is clean', record_or)

    def pyc(*paths):
        def m(t):
            for p in paths:
                put(t, p, b'\x00compiled')
        return m
    tree('stands: __pycache__ in src left out of the hash', pyc('alpha/src/__pycache__/main.cpython-312.pyc',
                                                               'alpha/beta/src/__pycache__/m.pyc'))
    tree('stands: __pycache__ below a directory of src left out of the hash', pyc('group/gamma/src/x/__pycache__/y.pyc'))
    tree('stands: file modes are not part of the hash', chmod('alpha/src/main', 0o755))

    # ---- answer (history)
    def ins(at, step):
        def f(s):
            s.insert(at, step)
        return f
    first_root = base_steps(F0)[0]['root.md']
    hist('answer: a commit touches root.md and another file, more commits after',
         ins(3, {'root.md': first_root + b'\nAn answer.\n', 'zeta/record.md': b'# Record\n\nmore\n'}), [('answer', None)])
    hist('answer: a commit touches principles.md, queue.md and another file',
         ins(2, {'principles.md': b'# Principles\n\nEight.\n', 'queue.md': b'q0\n', 'notes.txt': b'n\n'}),
         [('answer', None)])
    hist('answer: a commit touches principles.md and adds a file in a unit',
         ins(4, {'principles.md': b'# Principles\n\nNine.\n', 'alpha/notes.txt': b'n\n'}), [('answer', None)])

    def root_commit(s):
        s[0].update(s.pop(1))
    hist('answer: the first commit adds root.md together with other files', root_commit, [('answer', None)])
    hist('answer: principles.md below the root may change with other files',
         ins(3, {'alpha/misc/principles.md': b'local\n', 'alpha/misc/notes.txt': b'n\n', 'queue.md': b'q1\nq2\nqq\n'}))
    hist('answer: root.md, principles.md and queue.md may change together',
         ins(4, {'root.md': first_root + b'\nAn answer.\n', 'principles.md': b'# Principles\n\nEight.\n',
                 'queue.md': b'asked\n'}))

    # ---- spend
    def row(unit, runs):
        return lambda t: append(t, 'ledger.tsv', '2026-01-06T09:00Z\t%s\t%d\tone more\n' % (unit, runs))
    tree('spend: grandchild one over; breaches it, its parent and the root', row('alpha/beta', 1),
         [('spend', 'alpha/beta'), ('spend', 'alpha'), ('spend', 'root')],
         absent=[('spend', 'alpha/misc/delta'), ('spend', 'group/gamma')])
    tree('spend: unit within its own cost, its parent and the root over', row('alpha/misc/delta', 1),
         [('spend', 'alpha'), ('spend', 'root')], absent=[('spend', 'alpha/misc/delta'), ('spend', 'alpha/beta')])
    tree('spend: unit within its own cost, only the root over', row('group/gamma', 1),
         [('spend', 'root')], absent=[('spend', 'group/gamma'), ('spend', 'alpha')])
    tree('spend: a run charged to a unit with cost 0', row('zeta', 1), [('spend', 'zeta'), ('spend', 'root')])
    tree('spend: a run charged to root itself', row('root', 1), [('spend', 'root')],
         absent=[('spend', 'alpha'), ('spend', 'group/gamma')])
    tree('spend: for the root all rows count, whatever unit they name', row('ghost', 1), [('spend', 'root')])
    tree('spend: no ledger.tsv is clean', lambda t: rm(t, 'ledger.tsv'))
    tree('spend: a ledger of comments and blank lines is clean',
         lambda t: put(t, 'ledger.tsv', '# time\tunit\truns\tnote\n\n#2026-01-01T09:00Z\tzeta\t9\tno row\n\n'))
    tree('spend: a unit named al is not charged the rows of alpha',
         lambda t: os.rename(os.path.join(t, 'zeta'), os.path.join(t, 'al')))

    # ---- undo
    def undo_case(name, key, want, cwd_tree=False, dirty=False, extra=()):
        def fn(w):
            t = os.path.join(w, 'tree')
            shutil.copytree(UNDO['dir'], t, symlinks=True)
            if dirty:
                put(t, 'untracked.txt', 'u\n')
                append(t, 'g', 'local edit\n')
            commit = UNDO.get(key, key)
            neutral = os.path.join(w, 'cwd')
            os.makedirs(neutral)

            def state():
                return (git(t, 'rev-parse', 'HEAD'), git(t, 'symbolic-ref', 'HEAD'),
                        git(t, 'for-each-ref'), git(t, 'status', '--porcelain'),
                        git(t, 'worktree', 'list', '--porcelain'), snapshot(t))
            labels = ('HEAD', 'the branch HEAD names', 'refs', 'git status --porcelain', 'worktrees', 'working files')
            before = state()
            args = [commit] + list(extra) + ([] if cwd_tree else [t])
            rc, lines = run_build(os.path.join(BUILD, 'undo'), args, t if cwd_tree else neutral)
            after = state()
            for lab, x, y in zip(labels, before, after):
                if x != y:
                    raise Fail('the tree\'s repository was touched: %s changed' % lab)
            shown = ' | '.join(lines[:3]) if lines else 'no output'
            if want == 'proven':
                if rc != 0:
                    raise Fail('exit %d, wanted 0 (%s)' % (rc, shown))
                if not any(l.startswith('undo proven') for l in lines):
                    raise Fail('exit 0 but no line starting `undo proven` (%s)' % shown)
            elif want == 'refused':
                if rc != 1:
                    raise Fail('exit %d, wanted 1 (%s)' % (rc, shown))
        CASES.append((name, fn))
    undo_case('undo: last commit, which added a file, is proven', 'F', 'proven')
    undo_case('undo: earlier commit, its file untouched since, is proven', 'B', 'proven')
    undo_case('undo: last commit to change a file others changed before is proven', 'C', 'proven')
    undo_case('undo: last change of a file, an earlier change of it kept, is proven', 'E', 'proven')
    undo_case('undo: tree-dir defaults to the repository of the current directory', 'B', 'proven', cwd_tree=True)
    undo_case('undo: a later commit changed the same lines', 'A', 'refused')
    undo_case('undo: revert applies but a touched file is not as it was before the commit', 'D', 'refused')
    undo_case('undo: unknown commit hash', '0123456789abcdef0123456789abcdef01234567', 'refused')
    undo_case('undo: a name that is no commit', 'no-such-commit', 'refused')
    undo_case('undo: a tree with uncommitted work is left untouched', 'F', 'untouched', dirty=True)


def B_record(path, old, new):
    return lambda t: sub(t, path, 'stood unjudged: ' + old + '\n', 'stood unjudged: ' + new + '\n')


def build_undo_repo(d):
    os.makedirs(d)
    git(d, 'init', '-q')
    ten = ['line %d\n' % i for i in range(1, 11)]
    info = {'dir': d}

    def commit(key, files, i):
        for p, data in files.items():
            put(d, p, data, exe=False)
        git(d, 'add', '-A')
        git(d, 'commit', '-q', '-m', key, date=1750000000 + i * 3600)
        info[key] = git(d, 'rev-parse', 'HEAD').strip()

    def lines(**ch):
        l = list(ten)
        for k, v in ch.items():
            l[int(k[1:]) - 1] = v + '\n'
        return ''.join(l)
    commit('init', {'root.md': '# root\n', 'f': lines(), 'g': 'g one\n', 'k': lines()}, 0)
    commit('A', {'f': lines(l2='A changed this')}, 1)
    commit('B', {'g': 'g two\n'}, 2)
    commit('C', {'f': lines(l2='C changed this again')}, 3)
    commit('D', {'k': lines(l1='D changed the top')}, 4)
    commit('E', {'k': lines(l1='D changed the top', l10='E changed the bottom')}, 5)
    commit('F', {'h': 'a new file\n'}, 6)
    return info


def main():
    global BUILD, BASE, UNDO, ENV
    if len(sys.argv) != 2:
        print('usage: check <build-dir>', file=sys.stderr)
        return 2
    BUILD = os.path.abspath(sys.argv[1])
    tmp = tempfile.mkdtemp(prefix='audit-enforcer-')
    try:
        home = os.path.join(tmp, 'home')
        os.makedirs(home)
        ENV = make_env(home)
        BASE = build_repo(os.path.join(tmp, 'base'), base_steps(F0))
        UNDO = build_undo_repo(os.path.join(tmp, 'undo'))
        add_cases()

        def one(i):
            name, fn = CASES[i]
            w = os.path.join(tmp, 'case%03d' % i)
            os.makedirs(w)
            try:
                fn(w)
                res = None
            except Fail as e:
                res = str(e)
            except Exception as e:  # a fixture error is reported, never a traceback
                res = 'audit fixture error: %s: %s' % (type(e).__name__, e)
            shutil.rmtree(w, ignore_errors=True)
            return res
        with concurrent.futures.ThreadPoolExecutor(max_workers=min(8, (os.cpu_count() or 2))) as ex:
            results = list(ex.map(one, range(len(CASES))))
        passed = 0
        for (name, _), res in zip(CASES, results):
            if res is None:
                passed += 1
                print('PASS %s' % name)
            else:
                print('FAIL %s: %s' % (name, ' '.join(res.split())[:300]))
        print('%d/%d' % (passed, len(CASES)))
        return 0 if passed == len(CASES) else 1
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


if __name__ == '__main__':
    sys.exit(main())
