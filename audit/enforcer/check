            if p.startswith('alpha/measure/'):
                put(t, p, d)
    hist('before: src committed, measure only in the working tree (a nested unit\'s measure is committed)',
         no_committed_measure, [('before', 'alpha')], after=write_alpha_measure)

    def no_committed_src(s):
