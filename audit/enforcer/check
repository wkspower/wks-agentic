    hist('before: committed measure with uncommitted src is clean', no_committed_src, None, after=write_alpha_src)

    def readded(s):
        g_src = {p: d for p, d in s[2].items() if p.startswith('group/gamma/src/')}
        g_mea = {p: s[1].pop(p) for p in [p for p in s[1] if p.startswith('group/gamma/measure/')]}
        s[1].update(g_src)
        return [s[0], s[1], {p: None for p in g_src}, g_mea, s[2], s[3], s[4]]
    hist('before: src first added before the measure, removed, added again after it', readded, [('before', 'group/gamma')])

    # ---- stands
    tree('stands: right hash only in an earlier line of the unit\'s file',
         lambda t: append(t, 'judge/stands/alpha.tsv', stand_line('alpha', OLD2)), [('stands', 'alpha')])

    def sixth(t):
        put(t, 'judge/stands/group/gamma.tsv', stand_line('group/gamma', OLD, numbers=H['group/gamma']))
    tree('stands: right hash in the sixth field, not the fifth', sixth, [('stands', 'group/gamma')])

    def other_file(t):
        append(t, 'judge/stands/alpha.tsv', stand_line('alpha', OLD2))
        put(t, 'judge/stands/alpha/beta.tsv', stand_line('alpha', H['alpha']))
        append(t, 'judge/stands/group/gamma.tsv',
               stand_line('alpha', H['alpha']) + stand_line('group/gamma', H['group/gamma']))
    tree('stands: right hash only in other units\' files', other_file, [('stands', 'alpha')])

    def basename_file(t):
        put(t, 'judge/stands/gamma.tsv', stand_line('group/gamma', H['group/gamma']))
        put(t, 'judge/stands/group/gamma.tsv', stand_line('group/gamma', OLD))
    tree('stands: right hash in judge/stands/gamma.tsv, not judge/stands/group/gamma.tsv', basename_file,
         [('stands', 'group/gamma')])
    tree('stands: the unit\'s file absent and no record line', lambda t: rm(t, 'judge/stands/group/gamma.tsv'),
         [('stands', 'group/gamma')])
    tree('stands: a src file changed by one byte', lambda t: append(t, 'alpha/src/a/b', 'x'), [('stands', 'alpha')])
    tree('stands: a src file renamed, bytes unchanged',
         lambda t: os.rename(os.path.join(t, 'group/gamma/src/main'), os.path.join(t, 'group/gamma/src/main2')),
         [('stands', 'group/gamma')])
    tree('stands: an empty file added to src', lambda t: put(t, 'alpha/beta/src/new', ''), [('stands', 'alpha/beta')])
    tree('stands: record says stood unjudged with another hash',
         B_record('alpha/beta/record.md', H['alpha/beta'], OLD), [('stands', 'alpha/beta')])
    tree('stands: record line holds only the start of the hash',
         B_record('alpha/beta/record.md', H['alpha/beta'], H['alpha/beta'][:16]), [('stands', 'alpha/beta')])

    def root_record(t):
        sub(t, 'alpha/beta/record.md', 'stood unjudged: ' + H['alpha/beta'] + '\n', '')
        append(t, 'record.md', 'stood unjudged: %s\n' % H['alpha/beta'])
        append(t, 'alpha/record.md', 'stood unjudged: %s\n' % H['alpha/beta'])
    tree('stands: stood unjudged written in other units\' records only', root_record, [('stands', 'alpha/beta')])

    def record_or(t):
