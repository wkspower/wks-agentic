def expect(t, breaches=None, absent=()):
    """Run enforce on tree t.  breaches None: must exit 0.  Else exit 1 and, for each
    (rule, unit-or-None), a stdout line `<rule> <unit> ...`."""
    rc, lines = run_build(os.path.join(BUILD, 'enforce'), [t], os.path.dirname(t))
    shown = ' | '.join(lines[:3]) if lines else 'no output'
    if breaches is None:
        if rc != 0:
            raise Fail('clean tree: exit %d, wanted 0 (%s)' % (rc, shown))
        return
    if rc != 1:
        raise Fail('exit %d, wanted 1 (%s)' % (rc, shown))
    toks = [l.split(' ') for l in lines]
    for rule, unit in breaches:
        if not any(k[0] == rule and (unit is None or k[1:2] == [unit]) for k in toks):
            raise Fail('no line `%s%s ...` (%s)' % (rule, ' ' + unit if unit else '', shown))
    for rule, unit in absent:
        if any(k[0] == rule and k[1:2] == [unit] for k in toks):
            raise Fail('line `%s %s ...` for a rule that unit does not break' % (rule, unit))


def tree(name, mutate, breaches=None, absent=()):
    """A copy of the clean repository, changed in the working tree by mutate."""
    def fn(w):
        t = os.path.join(w, 'tree')
        shutil.copytree(BASE, t, symlinks=True)
        if mutate:
            mutate(t)
        expect(t, breaches, absent)
    CASES.append((name, fn))


def hist(name, steps_fn, breaches=None, after=None, skew=False):
    """A repository rebuilt with a different commit order."""
    def fn(w):
        steps = base_steps(F0)
        if steps_fn:
            steps = steps_fn(steps) or steps
        t = build_repo(os.path.join(w, 'tree'), steps, after, skew)
        expect(t, breaches)
    CASES.append((name, fn))


def B(old, new, unit):
    path = 'root.md' if unit == 'root' else unit + '/unit.md'
    return lambda t: sub(t, path, old, new)


