def b(s):
    return s if isinstance(s, bytes) else s.encode('utf-8')


def clean_files():
    F = {}
    for u in UNITS:
        d = '' if u == 'root' else u + '/'
        F[d + ('root.md' if u == 'root' else 'unit.md')] = b(doc(u))
