#!/usr/bin/env node
// Case of lesson L0042 (lessons/0042-nothing-under-the-buttons.md).
// Origin: run 010, 2026-11-20. Read in a screenshot at 1100 px, the overdue page said "6 da"
// beside Return and Renew: the column of buttons held in sight covered the state of each loan.
// Enters titles and names of several words, lends, renews one loan and starts the library 20
// days later, so that loans are overdue and one of them renewed. Then, at 1100 px, looks at
// every cell of every list: its text ends before the column held in sight begins, and inside
// the box the list is in. The pages are the library's own; this case is put to no other product.
// Run from the repository root.
const { run, style, surface } = require('../caselib.js');

if (surface.label !== 'school library') { console.log('this case is of the school library, and the product here is ' + surface.label); process.exit(1); }

const later = new Date(Date.now() + 20 * 864e5).toLocaleDateString('en-CA');
const POSTS = [
  ['/titles', { title: 'Noughts & Crosses', author: 'Malorie Blackman', isbn: '9780552555708', shelf: 'F BLA', copies: '3' }],
  ['/titles', { title: 'A Short History of Nearly Everything', author: 'Bill Bryson', isbn: '9780552997041', shelf: '500 BRY', copies: '2' }],
  ['/borrowers', { name: 'Maria Aparecida de Souza', kind: 'pupil', class: '7B' }],
  ['/borrowers', { name: 'Bo Li', kind: 'pupil', class: 'Year 9 A' }],
  ['/borrowers', { name: 'Ms Kay', kind: 'staff', class: '' }],
  ['/loans', { borrower_id: '1', copy: '1' }],
  ['/loans', { borrower_id: '1', copy: '4' }],
  ['/loans', { borrower_id: '2', copy: '2' }],
  ['/loans', { borrower_id: '3', copy: '5' }],
  ['/loans/1/renew', {}],
  ['/loans/3/renew', {}],
  ['/loans/3/renew', {}],
  { restart: ['--today', later] },
  ['/loans', { borrower_id: '2', copy: '3' }],
  ['/copies/5/status', { status: 'lost' }],
];
const PAGES = ['/titles', '/titles/1', '/borrowers', '/borrowers/1', '/loans', '/overdue', '/returned'];

run(async (page, base, expect, fill) => {
  await fill(POSTS);
  await page.setViewportSize({ width: 1100, height: 800 });
  let cells = 0; let held = 0;
  for (const path of PAGES) {
    await page.goto(base + path);
    const seen = await page.$$eval('tbody tr', (trs) => {
      const out = { cells: 0, held: 0, under: [] };
      for (const tr of trs) {
        const fixed = [...tr.cells].filter((td) => getComputedStyle(td).position === 'sticky');
        let box = tr.parentElement;
        while (box && !/auto|scroll/.test(getComputedStyle(box).overflowX)) box = box.parentElement;
        const edge = Math.min(innerWidth, box ? box.getBoundingClientRect().right : innerWidth, ...fixed.map((td) => td.getBoundingClientRect().left));
        out.held += fixed.length;
        for (const td of tr.cells) {
          if (fixed.includes(td) || !td.textContent.trim()) continue;
          const range = document.createRange(); range.selectNodeContents(td);
          const right = Math.max(...[...range.getClientRects()].map((at) => at.right));
          out.cells += 1;
          if (right > edge + 1) out.under.push('"' + td.textContent.trim().slice(0, 30) + '" (' + Math.round(right - edge) + ' px)');
        }
      }
      return out;
    });
    expect(seen.cells > 0, path + ' has no cell of a list to look at');
    expect(seen.under.length === 0, path + ' at 1100 px has text under the buttons held in sight, or past its box: ' + seen.under.slice(0, 3).join('; '));
    cells += seen.cells; held += seen.held;
  }
  expect(cells >= 80 && held >= 15, 'only ' + cells + ' cells were looked at, beside ' + held + ' cells held in sight');
  await page.goto(base + '/overdue');
  const late = await page.textContent('main');
  expect(/\d+ days overdue, renewed once/.test(late) && late.includes('renewed twice'), 'the overdue page has no loan that is both overdue and renewed to measure');
}, [
  ['the first build of run 010: every column 150 px wide whatever it holds, and the buttons on one line',
    style('td { min-width: 150px !important; } td.act { white-space: nowrap !important; }')],
  ['no cell may wrap, so that none is crushed', style('td { white-space: nowrap !important; }')],
]);
