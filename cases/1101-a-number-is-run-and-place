#!/usr/bin/env python3
"""Case of lesson L1101 (lessons/1101-a-number-is-run-and-place.md).
Origin: run 011, 2026-11-20. Two runs made from one base at the same time both
take the next number of one sequence.
Plants the small right tree of the selftest (./check --plant) and spoils it by
a small change each time (L0002): the check must take a lesson numbered by its
run and refuse one in the closed sequence or in the block of a run the tree
has no record of. Then makes the tree a git repository on a run's branch and
asks ./check --next and ./check --start for the next number, as a session
would. A missing git fails. Run from the repository root."""
import os
import re
import shutil
import subprocess
import sys
import tempfile

ENV = dict(os.environ, GIT_CONFIG_GLOBAL=os.devnull, GIT_CONFIG_SYSTEM=os.devnull, GIT_AUTHOR_NAME="case",
           GIT_AUTHOR_EMAIL="case@example.invalid", GIT_COMMITTER_NAME="case", GIT_COMMITTER_EMAIL="case@example.invalid")
LESSON = "# L%s\n\n## Reason\nBecause.\n\n## Source\nA run.\n"
CASE = "#!/bin/sh\n# Case of lesson L%s\necho '1 thing measured'\n"


def fail(what):
    print(what)
    sys.exit(1)


def write(tree, name, text, executable=False):
    path = os.path.join(tree, name)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as handle:
        handle.write(text)
    if executable:
        os.chmod(path, 0o755)


def lesson(tree, number, record=None):
    """One more lesson in the tree, with its file and its case, and the record of its run when asked."""
    with open(os.path.join(tree, "LESSONS.md"), "a", encoding="utf-8") as handle:
        handle.write("- **L%s** [web pages] Another true thing, number %s.\n" % (number, number))
    write(tree, "lessons/%s-y.md" % number, LESSON % number)
    write(tree, "cases/%s-y" % number, CASE % number, True)
    if record:
        write(tree, "runs/%s.md" % record, "# Run\n")


def run(tree, *command):
    return subprocess.run(list(command), cwd=tree, capture_output=True, text=True, env=ENV, timeout=120)


def plant(work, name):
    tree = os.path.join(work, name)
    if subprocess.run(["./check", "--plant", tree]).returncode != 0:
        fail("./check --plant could not write the small right tree")
    shutil.copy("check", os.path.join(tree, "check"))
    return tree


RIGHT = {
    "the third lesson of run 12, with the record of run 12": lambda t: [
        lesson(t, "1201", "012-x"), lesson(t, "1202"), lesson(t, "1203")],
    "lessons of two runs, each with its record": lambda t: [lesson(t, "1201", "012-x"), lesson(t, "1301", "013-y")],
}
WRONG = {
    "a lesson that takes the next number of the old sequence, L0043": lambda t: lesson(t, "0043"),
    "a lesson numbered L0099, in no run's block": lambda t: lesson(t, "0099", "000-x"),
    "a lesson of run 12 in a tree with no record of run 12": lambda t: lesson(t, "1201"),
    "a lesson of run 12 when only run 13 has a record": lambda t: lesson(t, "1201", "013-y"),
}
if shutil.which("git") is None:
    fail("git is missing: a run's number comes from its branch, so nothing was measured")
work = tempfile.mkdtemp()
try:
    counts = []
    for count, (name, change) in enumerate(list(RIGHT.items()) + list(WRONG.items())):
        tree = plant(work, str(count))
        change(tree)
        done = run(tree, "./check")
        if name in RIGHT and done.returncode != 0:
            fail("%s: the check refuses it: %s" % (name, [line for line in done.stdout.splitlines() if line.startswith("FAIL")][:2]))
        if name in WRONG and done.returncode == 0:
            fail("wrong variant ACCEPTED: %s" % name)
        if name in WRONG and not re.search(r"FAIL .*L(0043|0099|1201)", done.stdout):
            fail("%s: refused, but not for its number: %s" % (name, done.stdout.strip().splitlines()[-1][:200]))
        counts.append(name)

    # A session on a run's branch is given the next number, and takes it again after each lesson.
    tree = plant(work, "repo")
    for command in (["git", "init", "-q", "-b", "base"], ["git", "add", "-A"], ["git", "commit", "-qm", "base"]):
        if run(tree, *command).returncode != 0:
            fail("could not make a scratch repository: %s" % " ".join(command))
    on_base = run(tree, "./check", "--next")
    if on_base.returncode == 0 or re.search(r"\bL\d{4}\b", on_base.stdout.split("\n")[0]):
        fail("on a branch that is no run's, ./check --next gives a number: %s" % on_base.stdout.strip()[:100])
    run(tree, "git", "checkout", "-q", "-b", "run/012-shop")
    given = []
    for place in (1, 2, 3):
        said = run(tree, "./check", "--next")
        found = re.match(r"(L\d{4})\b", said.stdout)
        if said.returncode != 0 or not found:
            fail("on branch run/012-shop, ./check --next gives no number: %s" % (said.stdout + said.stderr).strip()[:200])
        if found.group(1) != "L12%02d" % place:
            fail("on branch run/012-shop with %d lessons of the run, ./check --next says %s, not L12%02d"
                 % (place - 1, found.group(1), place))
        start = run(tree, "./check", "--start")
        if start.returncode != 0 or found.group(1) not in start.stdout or not start.stdout.startswith("Lessons at the start"):
            fail("the text a session is given at its start does not say its next number, %s" % found.group(1))
        given.append(found.group(1))
        lesson(tree, found.group(1)[1:], "012-shop")
    done = run(tree, "./check")
    if done.returncode != 0:
        fail("the tree with the three numbers ./check --next gave is refused: %s" % done.stdout.strip().splitlines()[-1][:200])
    run(tree, "git", "checkout", "-q", "-b", "run/013-library")
    other = re.match(r"(L\d{4})\b", run(tree, "./check", "--next").stdout)
    if not other or other.group(1) != "L1301":
        fail("a second run made from the same tree is given %s, not L1301" % (other.group(1) if other else "no number"))
    shutil.rmtree(os.path.join(tree, ".git"))
    bare = run(tree, "./check", "--start")
    if bare.returncode != 0 or re.search(r"next is L\d{4}", bare.stdout):
        fail("in a tree that is no git checkout the start text still names a next number, or fails")
finally:
    shutil.rmtree(work, ignore_errors=True)
print("%d right trees accepted and %d of %d wrong ones refused for their number; on branch run/012-shop a session was "
      "given %s, one after each lesson, by ./check --next and by the start text; a second run from the same tree was "
      "given L1301; a branch that is no run's was given none"
      % (len(RIGHT), len(WRONG), len(WRONG), ", ".join(given)))
