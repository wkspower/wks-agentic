#!/usr/bin/env python3
"""Case of lesson L0023 (lessons/0023-labels-switch-lessons.md).
Origin: the person's decision of 2026-11-19 (run 005).
Works out from CLAUDE.md and product/LABELS, without the check's own code,
which cases should be in force, and compares with what ./check says. Then
takes product/ away in a scratch copy: that tree is the base every product
starts from, and ./check must pass there with only `always` in force.
The wrong trees for these rules are in ./check --selftest (case of L0001).
Run from the repository root."""
import os
import re
import shutil
import subprocess
import sys
import tempfile


def expected(declared):
    cases, on, off = [], 0, []
    for line in open("CLAUDE.md", encoding="utf-8"):
        found = re.match(r"- \*\*(L\d{4})\*\* \[([^\]]+)\]", line)
        if not found:
            continue
        labels = {" ".join(word.split()).lower() for word in found.group(2).split(",")}
        if labels & (declared | {"always"}):
            on += 1
            cases += re.findall(r"\]\((cases/[^)]+)\)", line)
        else:
            off.append(found.group(1))
    return cases, on, off


def fail(what):
    print(what)
    sys.exit(1)


declared = set()
if os.path.exists("product/LABELS"):
    declared = {" ".join(line.split("#")[0].split()).lower() for line in open("product/LABELS")} - {""}
cases, on, off = expected(declared)
listed = subprocess.run(["./check", "--cases"], capture_output=True, text=True)
if listed.returncode != 0 or listed.stdout.split() != cases:
    fail("./check --cases lists %d cases, and the labels switch on %d: %s"
         % (len(listed.stdout.split()), len(cases), sorted(set(listed.stdout.split()) ^ set(cases))[:4]))
if not cases:
    fail("no case is in force: nothing was measured")
here = "%d lessons in force and %d not, %d cases, for the labels: %s" % (
    on, len(off), len(cases), ", ".join(sorted(declared)) or "none")

if os.environ.get("INSIDE_THE_BASE_CHECK"):  # the case of L0019 runs this one again in there: once is enough
    print(here + "; inside the check of the base, which is not taken apart again")
    sys.exit(0)
if not os.path.isdir("product"):
    if off and not declared:
        print(here + "; this tree has no product, so it is the base, and the check running this case is its check")
        sys.exit(0)
    fail("no product and no lesson beyond `always`: nothing could be switched off, so nothing was measured")

base_cases, base_on, base_off = expected(set())
work = tempfile.mkdtemp()
try:
    tree = os.path.join(work, "base")
    shutil.copytree(".", tree, ignore=shutil.ignore_patterns(".git", "__pycache__", "node_modules", "*.db*", "product"))
    done = subprocess.run(["./check"], cwd=tree, capture_output=True, text=True, timeout=200,
                          env=dict(os.environ, INSIDE_THE_BASE_CHECK="1"))
finally:
    shutil.rmtree(work, ignore_errors=True)
said = done.stdout.strip().splitlines()
if done.returncode != 0:
    fail("without product/, ./check fails: %s" % "; ".join(line for line in said if line.startswith("FAIL"))[:300])
summary = said[-1]
want = "in force %d · not in force %d ·" % (base_on, len(base_off))
if want not in summary or "cases run %d ·" % len(base_cases) not in summary or "product: none" not in summary:
    fail("without product/, ./check says '%s', expected '%s' and %d cases run" % (summary, want, len(base_cases)))
unnamed = [lesson for lesson in base_off if not any(line.startswith("  not in force: " + lesson) for line in said)]
if unnamed or not base_off:
    fail("without product/, %d lessons are off and ./check does not name: %s" % (len(base_off), unnamed))
print(here + "; without product/, ./check passes with %d in force, %d cases run and %d lessons named as not in force"
      % (base_on, len(base_cases), len(base_off)))
