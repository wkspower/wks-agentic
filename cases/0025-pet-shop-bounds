#!/usr/bin/env python3
"""Case of lesson L0025 (lessons/0025-pet-shop-bounds.md).
Origin: no upper bound on prices in the wizardly-cerf run of 2026-11-18;
the person's answers 6 and 13 in run 001, 2026-11-19. Until run 005 this was
the bounds part of the case of L0008; the cents part stayed there.
Run from the repository root."""
import sys

sys.path.insert(0, ".")
import caselib
from caselib import fault, run

caselib.product("pet shop")  # this case was born in the pet shop and knows its pages (L0024, L0034)


def checks(shop):
    def product(price, name="Kibble", stock="5", low_at="0", status=303):
        shop.post(status, "/products", name=name, price=price, stock=stock, low_at=low_at)

    for text in ["0.01", "99999.99"]:
        product(text, name="Priced " + text)

    count = len(shop.export()["products"])
    for text in ["0", "0.00", "-1", "100000.00", "1000000000000", "12.345", ""]:
        product(text, status=400)
    for stock in ["-1", "1000001", "1.5", "", "many"]:
        product("1.00", stock=stock, status=400)
    for low_at in ["-1", "1000001", "x"]:
        product("1.00", low_at=low_at, status=400)
    for name in ["", "   ", "x" * 81]:
        product("1.00", name=name, status=400)
    product("1.00", name="x" * 80)
    product("1.00", name="Big stock", stock="1000000")
    shop.expect(len(shop.export()["products"]) == count + 2, "a refused product was stored anyway")

    for name, phone, status in [("", "1", 400), ("y" * 81, "1", 400), ("Ana", "5" * 31, 400),
                                ("Ana", "5" * 30, 303), ("Bo", "", 303)]:
        shop.post(status, "/customers", name=name, phone=phone)
    owner = max(row["id"] for row in shop.export()["customers"])
    for name, species, status in [("", "dog", 400), ("Rex", "", 400), ("Rex", "d" * 41, 400),
                                  ("Rex", "dog", 303)]:
        shop.post(status, "/pets", customer_id=owner, name=name, species=species)

    big = [row["id"] for row in shop.export()["products"] if row["name"] == "Big stock"][0]
    for qty in ["0", "-1", "1001", "1.5", "", "two"]:
        shop.post(400, "/sales", method="cash", product_id=big, qty=qty)
    shop.post(303, "/sales", method="cash", product_id=big, qty="1000")
    shop.post(400, "/sales", *[("product_id", big), ("qty", "1")] * 21, method="cash")
    shop.post(400, "/products/%d/stock" % big, delta="1000001")
    shop.post(400, "/products/%d/stock" % big, delta="0")
    shop.post(400, "/products/%d/stock" % big, delta="1.5")
    shop.expect(shop.row("products", big)["stock"] == 999000, "stock after one sale of 1000 is not 999000")

    status, body = shop.request("POST", "/customers", [("name", "z" * 70000)])
    shop.expect(status == 413, "a form of 70,000 bytes answered %d, expected 413" % status)


@fault("POST", r"/products(/\d+/edit)?")
def any_price(shop, ask, _):
    """A price above the bound is taken, and stored as the highest price there is."""
    try:
        over = float(ask.get("price")) > 99999.99
    except ValueError:
        over = False
    if over:
        ask.put("price", "99999.99")
        shop.acted += 1
    return ask.send()


@fault("POST", "/sales")
def any_quantity(shop, ask):
    """A line of more than 1000 is sold, as 1000."""
    qtys = ask.all("qty")
    if len(qtys) == 1 and qtys[0].isdigit() and int(qtys[0]) > 1000:
        ask.put("qty", "1000")
        shop.acted += 1
    return ask.send()


@fault("POST", ".*")
def any_name(shop, ask):
    """A name of more than 80 characters is taken, and cut."""
    if len(ask.get("name")) > 80:
        ask.put("name", ask.get("name")[:80])
        shop.acted += 1
    return ask.send()


run(checks, wrong=[
    ("no upper bound on prices", any_price),
    ("no upper bound on a sale's quantity", any_quantity),
    ("names of any length", any_name),
])
