#!/usr/bin/env python3
"""Case of lesson L0014 (lessons/0014-examples-are-accepted.md).
Origin: run 001, 2026-11-19. Used by hand, the stock form showed "+10 or -2"
as its example and refused "+10".
Made general in run 006, 2026-11-20, when the school library chose the label:
the pages, the rows they need and what fills the other fields are the
product's, from its surface; a form that sends with GET is asked with GET.
Reads every placeholder on every page as examples separated by " or ", and
sends each one in its own form. Run from the repository root."""
import re
import sys
import urllib.parse
from html.parser import HTMLParser

sys.path.insert(0, ".")
import caselib
from caselib import fault, run

EXAMPLES = caselib.product()["examples"]
REFUSED = EXAMPLES["refused"]


class Forms(HTMLParser):
    def __init__(self):
        super().__init__()
        self.forms = []

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == "form":
            self.forms.append((attrs.get("action"), (attrs.get("method") or "get").lower(), []))
        elif tag in ("input", "select") and attrs.get("name") and self.forms:
            self.forms[-1][2].append((attrs["name"], attrs.get("placeholder")))


def checks(shop):
    for path, fields in EXAMPLES["seed"]:
        shop.post(303, path, **fields)
    filler = EXAMPLES["filler"]
    examples = 0
    for path in EXAMPLES["pages"]:
        status, body = shop.request("GET", path)
        shop.expect(status == 200, "GET %s answered %d" % (path, status))
        reader = Forms()
        reader.feed(body)
        for action, method, fields in reader.forms:
            for position, (name, placeholder) in enumerate(fields):
                for example in (placeholder or "").split(" or ") if placeholder else []:
                    for other, _ in fields:
                        shop.expect(other in filler, "the case does not know how to fill '%s' on %s" % (other, path))
                    pairs = [(other, example if spot == position else filler[other])
                             for spot, (other, _) in enumerate(fields)]
                    if method == "post":
                        got, fine = shop.request("POST", action, pairs)[0], 303
                    else:
                        got, fine = shop.request("GET", action + "?" + urllib.parse.urlencode(pairs))[0], 200
                    shop.expect(got == fine, "on %s the field '%s' shows the example \"%s\" and the form refuses it (%d)"
                                % (path, name, example, got))
                    examples += 1
    shop.expect(examples >= EXAMPLES["least"], "only %d examples were found on the pages" % examples)


@fault("POST", REFUSED["path"])
def example_refused(shop, ask, *groups):
    """The form refuses what its own example shows: the fault the product's surface describes."""
    if re.search(REFUSED["pattern"], ask.get(REFUSED["field"])):
        shop.acted += 1
        return 400, ""
    return ask.send()


run(checks, wrong=[
    (REFUSED["name"], example_refused),
])
