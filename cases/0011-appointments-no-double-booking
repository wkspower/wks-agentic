#!/usr/bin/env python3
"""Case of lesson L0011 (lessons/0011-appointments-no-double-booking.md).
Origin: the person's answer 11 in run 001, 2026-11-19.
Run from the repository root."""
import sys

sys.path.insert(0, ".")
import caselib
from caselib import fault, run

caselib.product("pet shop")  # this case was born in the pet shop and knows its pages (L0024, L0034)

DAY = "2099-06-01"


def checks(shop):
    ana = shop.add("customers", name="Ana Lima", phone="")
    shop.post(400, "/pets", customer_id="999", name="Ghost", species="dog")
    shop.post(400, "/pets", name="Stray", species="dog")
    rex = shop.add("pets", customer_id=ana, name="Rex", species="dog")
    mia = shop.add("pets", customer_id=ana, name="Mia", species="cat")
    shop.expect(shop.row("pets", rex)["customer_id"] == ana, "the pet does not belong to its customer")

    def book(status, pet, time, date=DAY):
        shop.post(status, "/appointments", pet_id=pet, date=date, time=time)

    def booked():
        return sorted((row["time"], row["pet_id"]) for row in shop.export()["appointments"]
                      if row["date"] == DAY and not row["cancelled"])

    book(303, rex, "10:00")
    book(400, mia, "10:00")
    book(400, rex, "10:00")
    shop.expect(booked() == [("10:00", rex)], "a taken slot was booked again: %s" % booked())

    # An appointment belongs to a pet that exists.
    book(400, "", "11:00")
    book(400, "999", "11:00")
    shop.post(400, "/appointments", date=DAY, time="11:00")

    # One-hour slots on the hour, first at 09:00 and last at 17:00.
    for time in ["10:30", "08:00", "18:00", "9:00", "25:00", "", "noon", "09:00:00"]:
        book(400, mia, time)
    for date in ["2099-02-30", "01/06/2099", "", "2000-01-03"]:
        book(400, mia, "11:00", date=date)
    book(303, mia, "09:00")
    book(303, mia, "17:00")
    book(303, mia, "10:00", date="2099-06-02")
    shop.expect(booked() == [("09:00", mia), ("10:00", rex), ("17:00", mia)], "the day holds %s" % booked())

    # Cancelling frees the slot, once.
    first = [row["id"] for row in shop.export()["appointments"] if row["time"] == "10:00" and row["date"] == DAY][0]
    shop.post(303, "/appointments/%d/cancel" % first)
    shop.post(400, "/appointments/%d/cancel" % first)
    shop.post(404, "/appointments/999/cancel")
    book(303, mia, "10:00")
    shop.expect(booked() == [("09:00", mia), ("10:00", mia), ("17:00", mia)], "after cancel and rebook: %s" % booked())
    shop.expect(len(shop.export()["appointments"]) == 5, "a cancelled appointment left the record")


SLOTS = ["%02d:00" % hour for hour in range(9, 18)]


def at(shop, ask):
    """The appointments, live and cancelled, stored for the slot this request asks for."""
    rows = [row for row in shop.state()["appointments"]
            if (row["date"], row["time"]) == (ask.get("date"), ask.get("time"))]
    return [row for row in rows if not row["cancelled"]], [row for row in rows if row["cancelled"]]


@fault("POST", "/appointments")
def taken_slot_booked(shop, ask):
    """A taken slot goes to whoever asks last: the booking that held it is dropped."""
    for row in at(shop, ask)[0]:
        shop.real("POST", "/appointments/%d/cancel" % row["id"])
        shop.acted += 1
    return ask.send()


@fault("POST", "/appointments")
def cancelled_still_blocks(shop, ask):
    """A slot whose appointment was cancelled is still refused as taken."""
    live, cancelled = at(shop, ask)
    if cancelled and not live:
        shop.acted += 1
        return 400, ""
    return ask.send()


@fault("POST", "/appointments")
def any_time(shop, ask):
    """A time that is no slot is taken, and booked in the first free slot of that day."""
    if ask.get("time") not in SLOTS:
        busy = {row["time"] for row in shop.state()["appointments"]
                if row["date"] == ask.get("date") and not row["cancelled"]}
        ask.put("time", [slot for slot in SLOTS if slot not in busy][0])
        shop.acted += 1
    return ask.send()


@fault("POST", "/appointments")
def any_pet(shop, ask):
    """An appointment for no pet the shop knows is booked, for the first pet it has."""
    pets = [str(row["id"]) for row in shop.state()["pets"]]
    if pets and ask.get("pet_id") not in pets:
        ask.put("pet_id", pets[0])
        shop.acted += 1
    return ask.send()


run(checks, wrong=[
    ("a taken slot can be booked", taken_slot_booked),
    ("a cancelled appointment still blocks its slot", cancelled_still_blocks),
    ("any time of day accepted", any_time),
    ("an appointment for no known pet", any_pet),
])
