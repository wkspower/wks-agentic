#!/usr/bin/env node
// A check under lesson L0026 (lessons/0026-narrow-lists-are-cards.md); until run 005 the case of L0022.
// Origin: run 004, 2026-11-19. Used by hand at 390 px, the list of sales scrolled its Void
// links out of sight and the list of products its Adjust and Edit, while every case passed.
// Fills the shop, then looks in every table row that has a link or a button for one that
// can be seen and reached without scrolling. Run from the repository root.
const { run, style } = require('../caselib.js');

run(async (page, base, expect) => {
  const post = async (path, fields) => {
    const answer = await fetch(base + path, { method: 'POST', body: new URLSearchParams(fields), redirect: 'manual' });
    if (answer.status !== 303) throw new Error('wrong: POST ' + path + ' answered ' + answer.status);
  };
  await post('/products', { name: 'Cat litter 10 L', price: '8.90', stock: '30', low_at: '5' });
  await post('/products', { name: 'Hypoallergenic grain-free salmon and sweet potato dry food 12 kg', price: '99999.99', stock: '1000000', low_at: '20' });
  await post('/customers', { name: 'Maria Aparecida de Souza Albuquerque', phone: '+55 11 5550 0101' });
  await post('/customers', { name: 'Bo Li', phone: '' });
  await post('/pets', { customer_id: '1', name: 'Sir Barks a Lot', species: 'golden retriever' });
  await post('/pets', { customer_id: '2', name: 'Mia', species: 'cat' });
  await post('/sales', [['method', 'card'], ['customer_id', '1'], ['product_id', '1'], ['qty', '2'], ['product_id', '2'], ['qty', '1000']]);
  await post('/sales', [['method', 'cash'], ['product_id', '1'], ['qty', '1']]);
  await post('/appointments', { pet_id: '1', date: '2099-06-01', time: '17:00' });
  await post('/appointments', { pet_id: '2', date: '2099-06-01', time: '16:00' });
  let rows = 0;
  for (const width of [320, 390]) {
    await page.setViewportSize({ width, height: 800 });
    for (const path of ['/products', '/customers', '/sales', '/appointments']) {
      await page.goto(base + path);
      const [seen, hidden] = await page.$$eval('tbody tr', (trs) => {
        const inSight = (el) => {
          let box = el.parentElement;
          while (box && !/auto|scroll/.test(getComputedStyle(box).overflowX)) box = box.parentElement;
          const frame = box ? box.getBoundingClientRect() : { left: 0, right: innerWidth };
          const left = Math.max(0, frame.left) - 1, right = Math.min(innerWidth, frame.right) + 1;
          const at = el.getBoundingClientRect();
          if (at.width === 0 || at.left < left || at.right > right) return false;
          el.scrollIntoView({ block: 'center', inline: 'nearest' });
          const now = el.getBoundingClientRect();
          const top = document.elementFromPoint((now.left + now.right) / 2, (now.top + now.bottom) / 2);
          return now.left === at.left && Boolean(top) && (top === el || el.contains(top));
        };
        let count = 0; const bad = [];
        for (const tr of trs) {
          const acts = [...tr.querySelectorAll('a, button')];
          if (!acts.length) continue;
          count += 1;
          if (!acts.some(inSight)) bad.push(acts.map((el) => el.textContent.trim()).join('/') + ' of "' + tr.cells[0].textContent.trim().slice(0, 20) + '"');
        }
        return [count, bad];
      });
      expect(seen >= 2, path + ' has ' + seen + ' rows with a link or button to look for');
      expect(hidden.length === 0, path + ' at ' + width + ' px hides ' + hidden.slice(0, 3).join('; '));
      rows += seen;
    }
    await page.goto(base + '/products/2/edit');
    const adjust = await page.$$eval('form[action="/products/2/stock"] input[name=delta]', (els) => els.filter((el) => {
      const at = el.getBoundingClientRect(); return at.width > 0 && at.left >= 0 && at.right <= innerWidth;
    }).length);
    expect(adjust === 1, 'the Edit page of a product at ' + width + ' px shows ' + adjust + ' forms to adjust its stock');
  }
  expect(rows >= 16, 'only ' + rows + ' rows were looked at');
}, [
  ['the last column scrolls away with the rest', style('td, th { position: static !important; }')],
]);
