#!/usr/bin/env node
// A check under lesson L0026 (lessons/0026-narrow-lists-are-cards.md); until run 005 the case of L0015.
// Origin: run 001, 2026-11-19. Used by hand at 390 px wide, the sale form ran out of its
// box and the sales list pushed the page sideways.
// Looked at again after the first fix: the page no longer scrolled, and prices and button labels
// were broken in two ("129.9 / 0", "Adjus / t") at every width. The case had passed.
// Fills the product with the longest names allowed, then measures every page at four widths:
// two where the lists are cards, 800 px where they are tables with little room, and a wide one.
// Made general in run 006, 2026-11-20, when the school library chose the label: what fills the
// product and which pages are measured are the product's, in its surface ("long").
// Run from the repository root.
const { run, style, surface } = require('../caselib.js');

run(async (page, base, expect, fill) => {
  await fill(surface.long.posts);
  for (const width of [320, 390, 800, 1100]) {
    await page.setViewportSize({ width, height: 800 });
    for (const path of surface.long.pages) {
      await page.goto(base + path);
      const [content, room] = await page.evaluate(() => [document.documentElement.scrollWidth, document.documentElement.clientWidth]);
      expect(content <= room, path + ' at ' + width + ' px is ' + content + ' px wide and scrolls sideways');
      const out = await page.$$eval('form.card input, form.card select, form.card button', (els) => els.filter((el) => {
        const box = el.getBoundingClientRect(); const card = el.closest('form.card').getBoundingClientRect();
        return box.right > card.right + 1 || box.left < card.left - 1;
      }).length);
      expect(out === 0, path + ' at ' + width + ' px has ' + out + ' controls outside their form');
      const broken = await page.$$eval('td.num, td.stock, button, td a', (els) => els.filter((el) => {
        const range = document.createRange(); range.selectNodeContents(el);
        return new Set([...range.getClientRects()].map((box) => Math.round(box.top))).size > 1;
      }).map((el) => el.textContent.trim()));
      expect(broken.length === 0, path + ' at ' + width + ' px breaks across lines: ' + broken.slice(0, 3).join(', '));
    }
  }
}, [
  ['a wide table pushes the page sideways', style('* { overflow: visible !important; }')],
  ['a long name cannot break', style('* { overflow-wrap: normal !important; word-break: normal !important; }')],
  ['any word may break anywhere, the first fix of run 001', style('* { overflow-wrap: anywhere !important; white-space: normal !important; }')],
]);
