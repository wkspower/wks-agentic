#!/usr/bin/env python3
"""check: every lesson has its reason and says when it applies, and every lesson
in force that a machine can check has a case that runs and passes.

The cases never run in the tree itself. The check copies it, compiles the
product in the copy, takes the product's source out of it, and runs every
case in force once, there (L0019, L0038).

A lesson carries one or more labels. The product says what it is in
product/LABELS, one label per line. A lesson is in force when it carries
`always` or a label the product declared. Only cases of lessons in force run.

Usage: ./check [TREE]       check a tree (default: the one this file is in)
       ./check --cases      print the cases in force, one per line, and run nothing
       ./check --selftest   run the check against wrong trees it must refuse
       ./check --plant DIR  write the small right tree of the selftest to DIR, for a case to spoil
"""
import compileall
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

LINE = re.compile(r"^- \*\*(L\d{4})\*\* \[([^\]]*)\] (.+?) \[why\]\((lessons/[^)]+)\) · "
                  r"(?:cases?: (.+)|prose: (.*))$")
CASE = re.compile(r"\[[^\]]*\]\((cases/[^)]+)\)")
ALWAYS = "always"
DECLARED = os.path.join("product", "LABELS")


def read(path):
    try:
        with open(path, encoding="utf-8") as handle:
            return handle.read()
    except OSError:
        return ""


def section(text, name):
    found = re.search(r"^## %s[^\n]*\n(.*?)(?=^## |\Z)" % name, text, re.M | re.S)
    return found.group(1).strip() if found else ""


def label(text):
    return " ".join(text.split()).lower()


def lessons(tree, problems):
    """The lesson lines of CLAUDE.md: (lesson, labels, lesson file, case files, why prose)."""
    lines, seen = [], set()
    for line in read(os.path.join(tree, "CLAUDE.md")).splitlines():
        if not line.startswith("- **L"):
            continue
        found = LINE.match(line)
        if not found:
            problems.append("lesson line not in the expected form "
                            "(- **L0000** [label, label] text [why](lessons/..) · case: or prose:): %s" % line[:60])
            continue
        lesson, labels, _, lesson_file, cases, why_prose = found.groups()
        labels = [label(word) for word in labels.split(",")]
        if lesson in seen:
            problems.append("%s is listed twice" % lesson)
            continue
        seen.add(lesson)
        if not all(labels):
            problems.append("%s does not say when it applies: an empty label" % lesson)
            labels = [word for word in labels if word]
        if cases is not None and not CASE.findall(cases):
            problems.append("%s: no case named after 'case:'" % lesson)
        lines.append((lesson, labels, lesson_file, CASE.findall(cases or ""), why_prose))
    return lines


def declared(tree, carried, problems):
    """The labels the product chose. No product, no labels."""
    folder = os.path.join(tree, "product")
    text = read(os.path.join(tree, DECLARED))
    labels = []
    for line in text.splitlines():
        word = label(line.split("#")[0])
        if word and word in labels:
            problems.append("%s declares '%s' twice" % (DECLARED, word))
        elif word:
            labels.append(word)
    for word in labels:
        if word not in carried:
            problems.append("%s declares '%s', a label no lesson carries: most likely a typo. Carried: %s"
                            % (DECLARED, word, ", ".join(sorted(carried))))
    other = [name for name in sorted(os.listdir(folder)) if name != "LABELS"
             and not name.startswith(".") and name != "__pycache__"] if os.path.isdir(folder) else []
    if other and not labels:
        problems.append("product/ holds %s and %s declares no label: a product says what it is"
                        % (", ".join(other[:3]), DECLARED))
    return labels


SKIPPED = shutil.ignore_patterns(".git", "__pycache__", "node_modules", "*.db*")


def without_source(tree, work, problems):
    """Copy the tree to where its cases will run: product/ there holds bytecode and no source.

    Returns the copy, how many source files were compiled and removed, and what else is in product/."""
    copy = os.path.join(work, "tree")
    shutil.copytree(tree, copy, ignore=SKIPPED)
    product = os.path.join(copy, "product")
    compiled, kept = 0, []
    if os.path.isdir(product):
        compileall.compile_dir(product, legacy=True, quiet=2)
    for base, _, names in os.walk(product):
        for name in sorted(names):
            path = os.path.join(base, name)
            if not name.endswith(".py"):
                if not name.endswith(".pyc") and os.path.relpath(path, copy) != DECLARED:
                    kept.append(os.path.relpath(path, copy))
                continue
            os.remove(path)
            if os.path.exists(path + "c"):
                compiled += 1
            else:
                problems.append("%s could not be compiled, so no case can run it without its source"
                                % os.path.relpath(path, copy))
    return copy, compiled, kept


def run_case(tree, lesson, case_file, problems):
    path = os.path.join(tree, case_file)
    started = time.time()
    try:
        done = subprocess.run([path], cwd=tree, capture_output=True, text=True, timeout=300)
    except subprocess.TimeoutExpired:
        problems.append("%s: %s did not end within 300 s" % (lesson, case_file))
        return
    said = done.stdout.strip().splitlines()
    if done.returncode != 0:
        problems.append("%s: %s fails: %s" % (
            lesson, case_file, said[-1] if said else done.stderr.strip()[-200:] or "no output"))
    elif not said:
        problems.append("%s: %s passed without printing what it measured" % (lesson, case_file))
    else:
        print("  %s %s: %s (%.1f s)" % (lesson, case_file, said[-1], time.time() - started))


def check(tree, only_list=False):
    problems = []
    lines = lessons(tree, problems)
    carried = {}
    for lesson, labels, _, _, _ in lines:
        for word in labels:
            carried.setdefault(word, []).append(lesson)
    chosen = declared(tree, carried, problems)
    on = set(chosen) | {ALWAYS}
    if only_list:
        for lesson, labels, _, cases, _ in lines:
            if on & set(labels):
                print("\n".join(cases), end="\n" if cases else "")
        return not problems
    started = time.time()
    work = tempfile.mkdtemp()
    try:
        return examine(tree, lines, carried, chosen, on, problems, work, started)
    finally:
        shutil.rmtree(work, ignore_errors=True)


def examine(tree, lines, carried, chosen, on, problems, work, started):
    copy, compiled, kept = without_source(tree, work, problems)
    listed = {"lessons": set(), "cases": {}}
    ran = not_run = prose = 0
    off = []
    for lesson, labels, lesson_file, cases, why_prose in lines:
        in_force = bool(on & set(labels))
        if not in_force:
            off.append("%s [%s]" % (lesson, ", ".join(labels)))
        listed["lessons"].add(lesson_file)
        text = read(os.path.join(tree, lesson_file))
        if not text:
            problems.append("%s: %s is missing or empty" % (lesson, lesson_file))
        for name in ("Reason", "Source"):
            if text and not section(text, name):
                problems.append("%s: %s has no %s" % (lesson, lesson_file, name))
        if not cases:
            prose += 1
            if why_prose is not None and not why_prose.strip():
                problems.append("%s: prose only, with no word on why it cannot be checked" % lesson)
            continue
        for case_file in cases:
            if case_file in listed["cases"]:
                problems.append("%s: %s is already the case of %s" % (lesson, case_file, listed["cases"][case_file]))
                continue
            listed["cases"][case_file] = lesson
            path = os.path.join(tree, case_file)
            if not (os.path.isfile(path) and os.access(path, os.X_OK)):
                problems.append("%s: %s is missing or not executable" % (lesson, case_file))
            elif in_force:
                ran += 1
                run_case(copy, lesson, case_file, problems)
            else:
                not_run += 1
    for folder, names in listed.items():
        where = os.path.join(tree, folder)
        for name in sorted(os.listdir(where)) if os.path.isdir(where) else []:
            if not name.startswith(".") and folder + "/" + name not in names:
                problems.append("%s/%s belongs to no lesson in CLAUDE.md" % (folder, name))
    if not lines:
        problems.append("no lesson found: an empty record is not a result")
    for word in sorted(carried, key=lambda word: (word != ALWAYS, word)):
        print("  label '%s': %s, %d lessons" % (word, "on" if word in on else "off", len(carried[word])))
    for lesson in off:
        print("  not in force: %s" % lesson)
    print("  the cases ran in a copy of the tree: %d source files of the product compiled and taken out of it%s"
          % (compiled, "; left in product/ as they are: " + ", ".join(kept) if kept else ""))
    print("lessons %d · in force %d · not in force %d · with a case %d · prose only %d · "
          "cases run %d · cases not run %d · product: %s · CLAUDE.md %d bytes · %d s"
          % (len(lines), len(lines) - len(off), len(off), len(lines) - prose, prose, ran, not_run,
             ", ".join(chosen) or "none", len(read(os.path.join(tree, "CLAUDE.md")).encode("utf-8")),
             round(time.time() - started)))
    for problem in problems:
        print("FAIL " + problem)
    return not problems


# ---- selftest: the check against trees it must refuse, and right trees it must accept -------

def line(number="0001", labels="always", case=True):
    end = "case: [`cases/%s-x`](cases/%s-x)" % (number, number) if case else "prose: a judgement"
    return "- **L%s** [%s] One true thing. [why](lessons/%s-x.md) · %s\n" % (number, labels, number, end)


GOOD_LESSON = "# L0001\n\n## Reason\nBecause.\n\n## Source\nA run.\n"
GOOD_CASE = "#!/bin/sh\necho '1 thing measured'\n"
BAD_CASE = "#!/bin/sh\necho no\nexit 1\n"


def write(tree, name, text, executable=False):
    path = os.path.join(tree, name)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as handle:
        handle.write(text)
    if executable:
        os.chmod(path, 0o755)


def good(tree):
    """One lesson that always holds, one that holds for web pages, and a product that has web pages."""
    write(tree, "CLAUDE.md", "# x\n\n" + line() + line("0002", "web pages"))
    for number in ("0001", "0002"):
        write(tree, "lessons/%s-x.md" % number, GOOD_LESSON)
        write(tree, "cases/%s-x" % number, GOOD_CASE, True)
    write(tree, "product/LABELS", "# what this product is\nweb pages\n")
    write(tree, "product/app.py", "print('a product')\n")


def no_product(tree):
    shutil.rmtree(os.path.join(tree, "product"))


RIGHT = {
    "a right tree (the control)": (lambda t: None, "in force 2 · not in force 0"),
    "no product: only `always` is in force, and the other lesson is named": (
        no_product, "not in force: L0002 [web pages]"),
    "no product, and the case of the lesson not in force fails: it is not run": (
        lambda t: no_product(t) or write(t, "cases/0002-x", BAD_CASE, True), "cases run 1 · cases not run 1"),
    "a lesson with two labels is in force when the product chose one of them": (
        lambda t: write(t, "CLAUDE.md", line() + line("0002", "money, Web  Pages")), "in force 2 · not in force 0"),
    "a product folder with only its labels in it": (
        lambda t: os.remove(os.path.join(t, "product/app.py")), "in force 2"),
}

WRONG = {
    "no lesson at all": lambda t: write(t, "CLAUDE.md", "# x\n"),
    "lesson file missing": lambda t: os.remove(os.path.join(t, "lessons/0001-x.md")),
    "lesson without a reason": lambda t: write(t, "lessons/0001-x.md", "# L0001\n\n## Source\nA run.\n"),
    "lesson without a source": lambda t: write(t, "lessons/0001-x.md", "# L0001\n\n## Reason\nBecause.\n"),
    "case missing": lambda t: os.remove(os.path.join(t, "cases/0001-x")),
    "case fails": lambda t: write(t, "cases/0001-x", BAD_CASE, True),
    "case passes and prints nothing": lambda t: write(t, "cases/0001-x", "#!/bin/sh\nexit 0\n", True),
    "case that no lesson names": lambda t: write(t, "cases/0003-y", GOOD_CASE, True),
    "lesson file that no line names": lambda t: write(t, "lessons/0003-y.md", GOOD_LESSON),
    "prose only, with no word on why": lambda t: write(
        t, "CLAUDE.md", line() + line("0002", "web pages", case=False).replace("a judgement", ""))
        or os.remove(os.path.join(t, "cases/0002-x")),
    "same lesson listed twice": lambda t: write(t, "CLAUDE.md", line() + line("0002", "web pages") + line()),
    "a lesson that does not say when it applies": lambda t: write(
        t, "CLAUDE.md", line() + line("0002", "web pages").replace("[web pages] ", "")),
    "a lesson with an empty label": lambda t: write(t, "CLAUDE.md", line() + line("0002", "web pages, ")),
    "the product declares a label no lesson carries": lambda t: write(t, "product/LABELS", "web pages\nwep pages\n"),
    "a product that declares no label": lambda t: os.remove(os.path.join(t, "product/LABELS")),
    "the case of a lesson the product switched on fails": lambda t: write(t, "cases/0002-x", BAD_CASE, True),
    "the case of a lesson not in force is missing": lambda t: no_product(t) or os.remove(os.path.join(t, "cases/0002-x")),
    "the lesson file of a lesson not in force is missing": lambda t: no_product(t)
        or os.remove(os.path.join(t, "lessons/0002-x.md")),
    "one case named by two lessons": lambda t: write(
        t, "CLAUDE.md", line() + line("0002", "web pages").replace("cases/0002-x", "cases/0001-x"))
        or os.remove(os.path.join(t, "cases/0002-x")),
}

NOT_CAUGHT = (
    "a lesson marked prose that a machine could check; a case that passes without testing its lesson; "
    "a reason that is wrong; a label misspelt on a lesson, which only shows as a lesson not in force; "
    "two labels that mean the same thing; a lesson labelled too narrowly, which the next product never sees, "
    "or too widely; a product that leaves out a label it should have chosen; "
    "a case under a general label that only works on the product it was born in")


def said(tree):
    done = subprocess.run([sys.executable, os.path.abspath(__file__), tree], capture_output=True, text=True)
    return done.returncode == 0, done.stdout


def selftest():
    work = tempfile.mkdtemp()
    accepted = refused = 0
    try:
        for count, (name, (change, expected)) in enumerate(RIGHT.items()):
            tree = os.path.join(work, "right-%d" % count)
            good(tree)
            change(tree)
            passed, out = said(tree)
            fine = passed and expected in out
            accepted += fine
            print("%s  accepted: %s" % ("ok  " if fine else "FAIL", name))
        for count, (name, spoil) in enumerate(WRONG.items()):
            tree = os.path.join(work, "wrong-%d" % count)
            good(tree)
            spoil(tree)
            caught = not said(tree)[0]
            refused += caught
            print("%s  refused: %s" % ("ok  " if caught else "FAIL", name))
    finally:
        shutil.rmtree(work, ignore_errors=True)
    print("not caught by this check: " + NOT_CAUGHT)
    print("selftest: accepted %d of %d right trees, refused %d of %d wrong trees"
          % (accepted, len(RIGHT), refused, len(WRONG)))
    return accepted == len(RIGHT) and refused == len(WRONG)


if __name__ == "__main__":
    args = sys.argv[1:]
    if args == ["--selftest"]:
        sys.exit(0 if selftest() else 1)
    if args[:1] == ["--plant"] and len(args) == 2:
        sys.exit(good(args[1]))
    listing = args[:1] == ["--cases"]
    args = args[1:] if listing else args
    here = os.path.dirname(os.path.abspath(__file__))
    sys.exit(0 if check(args[0] if args else here, listing) else 1)
