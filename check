}

NOT_CAUGHT = (
    "a lesson marked prose that a machine could check; a case that passes without testing its lesson; "
    "a reason that is wrong; a label misspelt on a lesson, which only shows as a lesson not in force; "
    "two labels that mean the same thing; a lesson labelled too narrowly, which the next product never sees, "
    "or too widely; a product that leaves out a label it should have chosen; "
    "a case under a general label that only works on the product it was born in")


def said(tree):
    done = subprocess.run([sys.executable, os.path.abspath(__file__), tree], capture_output=True, text=True)
    return done.returncode == 0, done.stdout


def selftest():
    work = tempfile.mkdtemp()
    accepted = refused = 0
    try:
        for count, (name, (change, expected)) in enumerate(RIGHT.items()):
            tree = os.path.join(work, "right-%d" % count)
            good(tree)
            change(tree)
            passed, out = said(tree)
            fine = passed and expected in out
            accepted += fine
            print("%s  accepted: %s" % ("ok  " if fine else "FAIL", name))
        for count, (name, spoil) in enumerate(WRONG.items()):
            tree = os.path.join(work, "wrong-%d" % count)
            good(tree)
            spoil(tree)
            caught = not said(tree)[0]
            refused += caught
            print("%s  refused: %s" % ("ok  " if caught else "FAIL", name))
    finally:
        shutil.rmtree(work, ignore_errors=True)
    print("not caught by this check: " + NOT_CAUGHT)
    print("selftest: accepted %d of %d right trees, refused %d of %d wrong trees"
          % (accepted, len(RIGHT), refused, len(WRONG)))
    return accepted == len(RIGHT) and refused == len(WRONG)


def here():
    return os.path.dirname(os.path.abspath(__file__))


if __name__ == "__main__":
    args = sys.argv[1:]
    if args == ["--selftest"]:
        sys.exit(0 if selftest() else 1)
    if args[:1] == ["--plant"] and len(args) == 2:
        sys.exit(good(args[1]))
    if args == ["--start"]:
        sys.exit(print_start(here()))
    if args[:1] == ["--lessons"]:
        sys.exit(0 if print_lessons(here(), args[1:]) else 1)
    listing = args[:1] == ["--cases"]
    args = args[1:] if listing else args
    sys.exit(0 if check(args[0] if args else here(), listing) else 1)
