#!/usr/bin/env python3
"""judge <unit-dir> <candidate-dir> [<alternative-dir> ...]

Exit 0 when a build stands (installed as <unit-dir>/src, one line appended to
<tree>/judge/stands/<unit path>.tsv); exit 1 when nothing stands, having changed nothing.
"""
import hashlib
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time


def tree_root(unit):
    d = os.path.dirname(unit)
    while True:
        if os.path.isfile(os.path.join(d, "root.md")):
            return d
        up = os.path.dirname(d)
        if up == d:
            return None
        d = up


def budget_alternatives(unit):
    try:
        with open(os.path.join(unit, "unit.md"), encoding="utf-8") as f:
            for line in f:
                if line.startswith("4. **Budget**"):
                    m = re.search(r"alternatives\s+(\d+)", line)
                    return int(m.group(1)) if m else None
    except OSError:
        pass
    return None


def run_check(check, build):
    """(number, text) of the build by the unit's check run on a copy; None when it fails."""
    with tempfile.TemporaryDirectory() as tmp:
        copy = os.path.join(tmp, "build")
        shutil.copytree(build, copy, symlinks=True)
        env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
        try:
            r = subprocess.run([check, copy], stdin=subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                               timeout=900, env=env)
        except (OSError, subprocess.TimeoutExpired):
            return None
    if r.returncode != 0:
        return None
    lines = r.stdout.decode("utf-8", "replace").strip().splitlines()
    try:
        text = lines[-1].strip()
        number = float(text)
    except (IndexError, ValueError):
        return None
    if math.isnan(number):
        return None
    return number, text


def src_hash(src):
    files = []
    for dirpath, dirnames, filenames in os.walk(src):
        dirnames[:] = [d for d in dirnames if d != "__pycache__"]
        for name in filenames:
            full = os.path.join(dirpath, name)
            files.append((os.path.relpath(full, src).replace(os.sep, "/"), full))
    h = hashlib.sha256()
    for rel, full in sorted(files):
        with open(full, "rb") as f:
            data = f.read()
        h.update(rel.encode("utf-8", "surrogateescape") + b"\0" + data + b"\0")
    return h.hexdigest()


def stands_file(root, unit):
    """The unit's own file under <root>/judge/stands/, its directory made."""
    parts = os.path.relpath(unit, root).split(os.sep)
    path = os.path.join(root, "judge", "stands", *parts) + ".tsv"
    os.makedirs(os.path.dirname(path), exist_ok=True)
    return path


def main(argv):
    if len(argv) < 3:
        print(__doc__, file=sys.stderr)
        return 1
    unit = os.path.realpath(argv[1])
    builds = [("candidate", argv[2])]
    builds += [("alternative-%d" % i, p) for i, p in enumerate(argv[3:], 1)]
    root = tree_root(unit)
    check = os.path.join(unit, "measure", "check")
    budget = budget_alternatives(unit)
    if root is None or budget is None or not os.path.isfile(check):
        print("refused: no tree root, no budget or no measure", file=sys.stderr)
        return 1
    if len(builds) - 1 < budget:
        print("refused: fewer alternatives than the budget states", file=sys.stderr)
        return 1
    if not all(os.path.isdir(p) for _, p in builds):
        print("refused: an offered build is not a directory", file=sys.stderr)
        return 1

    src = os.path.join(unit, "src")
    existing = run_check(check, src) if os.path.isdir(src) else None
    compared = ["existing=%s" % (existing[1] if existing else "fail" if os.path.isdir(src) else "none")]
    best = None
    for which, path in builds:
        result = run_check(check, path)
        compared.append("%s=%s" % (which, result[1] if result else "fail"))
        if result and (best is None or result[0] < best[2][0]):
            best = (which, path, result)
    if best is None or (existing and not best[2][0] < existing[0]):
        print("refused: " + " ".join(compared), file=sys.stderr)
        return 1

    which, path, (number, text) = best
    if os.path.lexists(src):
        shutil.rmtree(src)
    shutil.copytree(path, src, symlinks=True)
    line = "\t".join([
        time.strftime("%Y-%m-%dT%H:%MZ", time.gmtime()),
        os.path.relpath(unit, root).replace(os.sep, "/"),
        which,
        text,
        src_hash(src),
        " ".join(compared),
    ])
    with open(stands_file(root, unit), "w", encoding="utf-8") as f:
        f.write(line + "\n")
    print("stands: " + which)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
