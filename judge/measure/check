# ---------------------------------------------------------------------------


def build_bytes(build):
    total = 0
    for dirpath, _, filenames in os.walk(build):
        for name in filenames:
            total += os.path.getsize(os.path.join(dirpath, name))
    return total


def main(argv):
    if len(argv) != 2:
        print("usage: check <build-dir>", file=sys.stderr)
        return 1
    build = os.path.abspath(argv[1])
    judge = os.path.join(build, "judge")
    if not os.path.isfile(judge) or not os.access(judge, os.X_OK):
        print("FAIL build: no executable file `judge` in %s" % build, file=sys.stderr)
        return 1
    failed = []
    for function in CASES:
        try:
            function(judge)
            print("pass %s" % function.__name__)
        except Fail as why:
            failed.append(function.__name__)
            print("FAIL %s: %s\n     claim: %s" % (function.__name__, why, function.__doc__),
                  file=sys.stderr)
        except Exception as e:  # a defect of the fixture machinery, reported as a failed case
            failed.append(function.__name__)
            print("FAIL %s: %s: %s" % (function.__name__, type(e).__name__, e), file=sys.stderr)
        finally:
            while OPEN:
                try:
                    OPEN.pop().close()
                except Exception:
                    pass
    if failed:
        print("%d of %d cases failed: %s" % (len(failed), len(CASES), " ".join(failed)),
              file=sys.stderr)
        return 1
    print("%d cases passed" % len(CASES))
    print(build_bytes(build))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
