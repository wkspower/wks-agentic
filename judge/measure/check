#!/usr/bin/env python3
"""Measure of the judge.  Usage: check <build-dir>

<build-dir> holds an executable `judge`.  Every case below builds a small
fixture tree in a temporary directory, runs

    <build-dir>/judge <unit-dir> <candidate-dir> [<alternative-dir> ...]

and compares what happened with what the judge's document states.  All cases
pass: exit 0, last line of stdout = bytes of the build.  Otherwise exit 1 and
the failing cases are named on stderr.

The fixture tree
    <tree>/root.md                    marks the tree's root
    <tree>/judge/                     where stands.tsv is appended
    <tree>/shop/widget/unit.md        its Budget line states `alternatives N`
    <tree>/shop/widget/measure/check  the toy check (below)
    <tree>/shop/widget/src/           what exists, when the case has one
Offered builds live outside the tree.  A toy build is `value.txt` (its number)
and a file `ok` (present: the toy check passes).
"""
import datetime
import hashlib
import os
import re
import shutil
import subprocess
import sys
import tempfile

JUDGE_TIMEOUT = 60  # seconds for one run of the judge
HUNG = []           # once a run has hung, the cases left are failed without running it again

# The toy check: passes iff <build>/ok exists and value.txt holds a number;
# that number is the last line of stdout.  It prints the number even when it
# fails, so only the exit code says whether it passed (rule d).
TOY_CHECK = r'''#!/usr/bin/env python3
import os, sys
build = sys.argv[1]
print("toy check")
try:
    value = open(os.path.join(build, "value.txt")).read().strip()
    float(value)
except Exception:
    sys.exit(1)
print(value)
sys.exit(0 if os.path.exists(os.path.join(build, "ok")) else 1)
'''

# As TOY_CHECK, but it scribbles into the directory it is given: a new file
# and a rewritten value.txt.  Harmless on a copy; visible on an original.
SCRIBBLING_CHECK = r'''#!/usr/bin/env python3
import os, sys
build = sys.argv[1]
try:
    value = open(os.path.join(build, "value.txt")).read().strip()
    float(value)
except Exception:
    sys.exit(1)
passed = os.path.exists(os.path.join(build, "ok"))
open(os.path.join(build, "scribble"), "w").write("the check was here\n")
open(os.path.join(build, "value.txt"), "w").write("0\n")
print(value)
sys.exit(0 if passed else 1)
'''

